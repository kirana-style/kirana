{
  "name": "kirana-workspace",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prepare": "vp config",
    "dev:local": "bun --env-file=.env vp run dev",
    "deps:check": "bun outdated --filter='*'",
    "deps:update": "bun update --recursive",
    "deps:update:latest": "bun update --recursive --latest",
    "deps:update:interactive": "bun update --recursive --interactive",
    "clean": "vp cache clean",
    "kirana:pack": "cd packages/kirana && bun run pack",
    "kirana:example": "cd packages/kirana && bun run example"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "trustedDependencies": [
    "esbuild",
    "lightningcss"
  ],
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "packages/kirana/npm/*",
      "packages/kirana/editors/vscode"
    ],
    "catalog": {
      "@hugeicons/core-free-icons": "^4.4.0",
      "@tanstack/charts": "^1.5.0",
      "@tanstack/react-router": "^1.170.46",
      "@tanstack/react-start": "^1.169.4",
      "@types/node": "^26.6.6",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "react": "^19.3.1",
      "react-day-picker": "^10.0.2",
      "react-dom": "^19.3.1",
      "typescript": "^7.0.2",
      "vite": "npm:@voidzero-dev/vite-plus-core@1.5.1",
      "rolldown": "^1.3.1",
      "esbuild": "^0.28.2",
      "emnapi": "2.0.0-beta.3",
      "@emnapi/core": "2.0.0-beta.3",
      "@emnapi/runtime": "2.0.0-beta.3",
      "@napi-rs/wasm-runtime": "1.2.7",
      "magic-string": "^1.4.5",
      "vue": "^3.5.45",
      "svelte": "^5.57.3",
      "@astrojs/compiler": "^4.0.0",
      "@astrojs/compiler-rs": "^0.5.2",
      "webpack": "^5.112.2",
      "@rspack/core": "^2.2.9",
      "@rsbuild/core": "^2.3.1",
      "css-loader": "^7.1.5",
      "mini-css-extract-plugin": "^2.10.2",
      "postcss": "^8.5.32",
      "@angular/compiler": "^22.2.5",
      "@angular/core": "^22.2.5",
      "@angular/build": "^22.2.6",
      "@angular-devkit/architect": "^0.2202.6",
      "@adonisjs/core": "^7.6.0",
      "edge.js": "^6.5.1",
      "@parcel/plugin": "^2.16.4",
      "parcel": "^2.16.4",
      "vitest": "5.1.0",
      "eslint": "^10.14.0",
      "vue-eslint-parser": "^10.4.2",
      "@biomejs/biome": "2.6.6",
      "@vitest/coverage-v8": "5.1.0",
      "@napi-rs/cli": "^3.10.9",
      "motion": "^14.12.0",
      "playwright": "1.65.0",
      "input-otp": "^1.5.0",
      "react-resizable-panels": "^4.21.0",
      "vite-plus": "1.5.1",
      "oxlint": "1.91.0"
    }
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
