{
  "name": "kirana-workspace",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:local": "bun --env-file=.env turbo run dev",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run --cwd apps/docs check:consistency",
    "deps:check": "bun outdated --filter='*'",
    "deps:update": "bun update --recursive",
    "deps:update:latest": "bun update --recursive --latest",
    "deps:update:interactive": "bun update --recursive --interactive",
    "clean": "rm -rf .turbo node_modules/.cache/turbo",
    "build:clean": "bun run clean && bun pm cache rm && turbo run build",
    "kirana:check": "turbo run check --filter=@kirana-style/workspace",
    "kirana:test": "cd packages/kirana && bun run test:rust && bun run test",
    "kirana:coverage": "turbo run coverage --filter=@kirana-style/workspace",
    "kirana:build": "cd packages/kirana/npm/compiler && bun run build",
    "kirana:pack": "cd packages/kirana && bun run pack",
    "kirana:example": "cd packages/kirana && bun run example"
  },
  "devDependencies": {
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "turbo": "^2.11.7",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=20"
  },
  "trustedDependencies": [
    "esbuild",
    "lightningcss"
  ],
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "packages/kirana/npm/*",
      "packages/kirana/editors/vscode"
    ],
    "catalog": {
      "@hugeicons/core-free-icons": "^4.3.5",
      "@tanstack/react-router": "^1.170.42",
      "@tanstack/react-start": "^1.168.61",
      "@types/node": "^26.6.4",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "react": "^19.3.0",
      "react-day-picker": "^10.0.2",
      "react-dom": "^19.3.0",
      "typescript": "^7.0.2",
      "vite": "^8.3.4",
      "rolldown": "^1.2.13",
      "esbuild": "^0.28.2",
      "emnapi": "2.0.0-alpha.5",
      "@emnapi/core": "2.0.0-alpha.5",
      "@emnapi/runtime": "2.0.0-alpha.5",
      "@napi-rs/wasm-runtime": "^1.2.5",
      "magic-string": "^1.4.3",
      "vue": "^3.5.43",
      "svelte": "^5.57.1",
      "@astrojs/compiler": "^4.0.0",
      "@astrojs/compiler-rs": "^0.5.1",
      "webpack": "^5.111.1",
      "@rspack/core": "^2.2.8",
      "@rsbuild/core": "^2.2.11",
      "css-loader": "^7.1.5",
      "mini-css-extract-plugin": "^2.10.2",
      "postcss": "^8.5.29",
      "@angular/compiler": "^22.2.2",
      "@angular/core": "^22.2.2",
      "@angular/build": "^22.2.2",
      "@angular-devkit/architect": "^0.2202.2",
      "@adonisjs/core": "^7.6.0",
      "edge.js": "^6.5.1",
      "@parcel/plugin": "^2.16.4",
      "parcel": "^2.16.4",
      "vitest": "^5.0.4",
      "eslint": "^10.12.0",
      "@biomejs/biome": "2.5.15",
      "@vitest/coverage-v8": "^5.0.4",
      "@napi-rs/cli": "^3.10.7",
      "motion": "^14.1.0",
      "playwright": "1.64.0",
      "input-otp": "^1.5.0",
      "react-resizable-panels": "^4.14.4",
      "recharts": "^3.10.1"
    }
  }
}
