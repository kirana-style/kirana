        },
        {
          "type": "json",
          "path": "packages/kirana/npm/rolldown/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/kirana/npm/rspack/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/kirana/npm/vite/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
