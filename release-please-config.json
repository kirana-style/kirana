        },
        {
          "type": "toml",
          "path": "packages/kirana/editors/zed/extension.toml",
          "jsonpath": "$.version"
        },
        {
          "type": "generic",
          "path": "packages/kirana/helpers/ruby/kirana.gemspec"
        },
        {
          "type": "generic",
          "path": "packages/kirana/helpers/elixir/mix.exs"
        }
      ]
    }
  }
}
