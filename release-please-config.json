{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "pull-request-title-pattern": "chore: release ${version}",
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug fixes"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "revert",
      "section": "Reverts"
    },
    {
      "type": "docs",
      "section": "Documentation"
    },
    {
      "type": "deps",
      "section": "Dependencies"
    },
    {
      "type": "refactor",
      "section": "Refactoring",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "build",
      "section": "Build",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "CI",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Chores",
      "hidden": true
    }
  ],
  "packages": {
    ".": {
      "package-name": "kirana",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "packages/kirana/npm/adonis/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/kirana/npm/angular/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/kirana/npm/astro/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/kirana/npm/biome-plugin/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/kirana/npm/bun/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/kirana/npm/cli/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/kirana/npm/compiler/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/kirana/npm/core/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/kirana/npm/ember/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/kirana/npm/esbuild/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/kirana/npm/eslint-plugin/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/kirana/npm/gatsby/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/kirana/npm/jest/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/kirana/npm/next/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/kirana/npm/parcel-transformer/package.json",
