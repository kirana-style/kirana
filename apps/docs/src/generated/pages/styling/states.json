ver hold together, so "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"open","source":"open"}},{"type":"text","value":" and "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"closed","source":"closed"}},{"type":"text","value":" need no nesting."}]},{"type":"heading","depth":2,"id":"next","children":[{"type":"text","value":"Next"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"/docs/styling/conditions","children":[{"type":"text","value":"Conditions"}]},{"type":"text","value":": every key a condition can be."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"/docs/styling/relations","children":[{"type":"text","value":"Relations"}]},{"type":"text","value":": style an element from another element's\nstate."}]}]}]}],"headings":[{"id":"component-states","text":"Component states","level":1},{"id":"install","text":"Install","level":2},{"id":"the-vocabularies","text":"The vocabularies","level":2},{"id":"states-that-never-hold-together","text":"States that never hold together","level":2},{"id":"one-look-for-several-libraries","text":"One look for several libraries","level":3},{"id":"other-libraries-and-your-own-components","text":"Other libraries, and your own components","level":2},{"id":"next","text":"Next","level":2}]}
