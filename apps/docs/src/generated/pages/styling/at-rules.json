 class=\"th-token th-keyword\">const</span> label = <span class=\"th-token th-function\">css</span>({\n  <span class=\"th-token th-string\">&quot;::before&quot;</span>: { <span class=\"th-token th-property\">content</span>: <span class=\"th-token th-string\">`counter(step, </span><span class=\"th-token th-operator\">${</span>check<span class=\"th-token th-operator\">}</span><span class=\"th-token th-string\">) &quot;. &quot;`</span> },\n})"}},{"type":"paragraph","children":[{"type":"text","value":"The result is the rule's name, "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"kc…","source":"kc…"}},{"type":"text","value":", for a list's marker or a counter. The rule\nships once, in "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"kirana.<span class=\"th-token th-property\">tokens</span>","source":"kirana.tokens"}},{"type":"text","value":", and only if a style uses it:"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"@layer kirana.tokens {\n  @counter-style kc4HMO {\n    system: cyclic;\n    symbols: \"✓\";\n    suffix: \" \";\n  }\n}","lang":"css","html":"@layer kirana.tokens {\n <span class=\"th-token th-selector\"> @counter-style kc4HMO </span>{\n    <span class=\"th-token th-property\">system</span>: cyclic;\n    <span class=\"th-token th-property\">symbols</span>: <span class=\"th-token th-string\">&quot;✓&quot;</span>;\n    <span class=\"th-token th-property\">suffix</span>: <span class=\"th-token th-string\">&quot; &quot;</span>;\n  }\n}"}},{"type":"paragraph","children":[{"type":"text","value":"The keys are the CSS descriptors in camel case:"}]},{"type":"table","align":[null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Descriptor"}]},{"type":"tableCell","children":[{"type":"text","value":"What it sets"}]}],"rows":[