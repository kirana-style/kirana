n class=\"th-token th-keyword\">export</span> <span class=\"th-token th-keyword\">const</span> roman = <span class=\"th-token th-function\">counterStyle</span>({\n  <span class=\"th-token th-property\">system</span>: <span class=\"th-token th-string\">&quot;additive&quot;</span>,\n  <span class=\"th-token th-property\">additiveSymbols</span>: <span class=\"th-token th-string\">&#39;10 &quot;X&quot;, 5 &quot;V&quot;, 1 &quot;I&quot;&#39;</span>,\n  <span class=\"th-token th-property\">range</span>: <span class=\"th-token th-string\">&quot;1 39&quot;</span>,\n  <span class=\"th-token th-property\">fallback</span>: check,\n})"}},{"type":"heading","depth":3,"id":"why-not-a-stylesheet","children":[{"type":"text","value":"Why not a stylesheet"}]},{"type":"paragraph","children":[{"type":"text","value":"A counter style in a global stylesheet has a global name that any other can\ncollide with. It ships whether a page uses it or not. And a name misspelt in\n"},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"listStyleType","source":"listStyleType"}},{"type":"text","value":" gives no error: the list quietly falls back to decimal numbers.\nWith "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-function\">counterStyle</span>()","source":"counterStyle()"}},{"type":"text","value":" the name is a value your editor completes and the compiler\nchecks."}]},{"type":"heading","depth":3,"id":"what-the-compiler-checks","children":[{"type":"text","value":"What the compiler checks"}]},{"type":"paragraph","children":[{"type":"text","value":"A browser drops a broken counter style without a word, so "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"invalid-counter-style","source":"invalid-counter-style"}},{"type":"text","value":"\nreports each way it breaks:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"a key that is not a descriptor ("},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"color","source":"color"}},{"type":"text","value":");"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"a value that reads a custom property, which descriptors cannot (a variable token);"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"a value that is empty, or not CSS, or only known at runtime;"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"a system without what it draws with: most need "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"symbols","source":"symbols"}},{"type":"text","value":", an additive one\nneeds "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"additiveSymbols","source":"additiveSymbols"}},{"type":"text","value":", and one that extends another style takes neither."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"An inlined token works as a value, since it is plain text by then. A system newer\nthan the compiler is left to the browser."}]},{"type":"heading","depth":2,"id":"in-a-stylesheet","children":[{"type":"text","value":"In a stylesheet"}]},{"type":"paragraph","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"@font-face","source":"@font-face"}},{"type":"text","value":" and "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"@page","source":"@page"}},{"type":"text","value":" belong to the page rather than to an element, so they\nstay in CSS, imported once from your entry point."}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"/* src/fonts.css */\n@font-face {\n  font-family: \"Inter\";\n  src: url(\"./fonts/inter.woff2\") format(\"woff2\");\n  font-weight: 100 900;\n  font-display: swap;\n}\n\n@page {\n  margin: 2cm;\n}","lang":"css","html":"<span class=\"th-token th-comment\">/* src/fonts.css */</span>\n@font-face {\n  <span class=\"th-token th-property\">font-family</span>: <span class=\"th-token th-string\">&quot;Inter&quot;</span>;\n  <span class=\"th-token th-property\">src</span>: <span class=\"th-token th-function\">url</span>(<span class=\"th-token th-string\">&quot;./fonts/inter.woff2&quot;</span>) <span class=\"th-token th-function\">format</span>(<span class=\"th-token th-string\">&quot;woff2&quot;</span>);\n  <span class=\"th-token th-property\">font-weight</span>: <span class=\"th-token th-number\">100</span> <span class=\"th-token th-number\">900</span>;\n  <span class=\"th-token th-property\">font-display</span>: swap;\n}\n\n@page {\n  <span class=\"th-token th-property\">margin</span>: 2cm;\n}"}},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"// src/main.tsx\nimport \"./fonts.css\"","lang":"tsx","html":"<span class=\"th-token th-comment\">// src/main.tsx</span>\n<span class=\"th-token th-keyword\">import</span> <span class=\"th-token th-string\">&quot;./fonts.css&quot;</span>"}},{"type":"paragraph","children":[{"type":"text","value":"Your bundler resolves the font's "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-function\">url</span>()","source":"url()"}},{"type":"text","value":" and fingerprints the file. That works in\na stylesheet and cannot work from a value inside a module, which is why Kirana\nhas no "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-function\">fontFace</span>()","source":"fontFace()"}},{"type":"text","value":". A style then names the family like any other value, and a\n"},{"type":"link","href":"/docs/tokens/overview","children":[{"type":"text","value":"token"}]},{"type":"text","value":" can hold it:"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"export const body = css({ fontFamily: \"Inter, system-ui, sans-serif\" })","lang":"tsx","html":"<span class=\"th-token th-keyword\">export</span> <span class=\"th-token th-keyword\">const</span> body = <span class=\"th-token th-function\">css</span>({ <span class=\"th-token th-property\">fontFamily</span>: <span class=\"th-token th-string\">&quot;Inter, system-ui, sans-serif&quot;</span> })"}},{"type":"paragraph","children":[{"type":"text","value":"These rules are not inside a layer, and they need not be: neither styles an\nelement, so they never compete with Kirana's atoms. Element styles of your own\nthat must sit beside Kirana's go in "},{"type":"link","href":"/docs/config/layers","children":[{"type":"text","value":"a layer"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"a-named-media-query","children":[{"type":"text","value":"A named media query"}]},{"type":"paragraph","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"@custom-media","source":"@custom-media"}},{"type":"text","value":" gives a media query a name, but no browser reads it yet. A\ncondition in a constant does the same today:"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"// src/breakpoints.ts\nimport { media } from \"@kirana-style/core\"\n\nexport const tablet = media(\"(width >= 48rem)\")\nexport const reducedMotion = media(\"(prefers-reduced-motion: reduce)\")","lang":"tsx","html":"<span class=\"th-token th-comment\">// src/breakpoints.ts</span>\n<span class=\"th-token th-keyword\">import</span> { media } <span class=\"th-token th-keyword\">from</span> <span class=\"th-token th-string\">&quot;@kirana-style/core&quot;</span>\n\n<span class=\"th-token th-keyword\">export</span> <span class=\"th-token th-keyword\">const</span> tablet = <span class=\"th-token th-function\">media</span>(<span class=\"th-token th-string\">&quot;(width &gt;= 48rem)&quot;</span>)\n<span class=\"th-token th-keyword\">export</span> <span class=\"th-token th-keyword\">const</span> reducedMotion = <span class=\"th-token th-function\">media</span>(<span class=\"th-token th-string\">&quot;(prefers-reduced-motion: reduce)&quot;</span>)"}},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"import { css } from \"@kirana-style/core\"\nimport { tablet } from \"./breakpoints\"\n\nexport const grid = css({\n  gridTemplateColumns: { base: \"1fr\", [tablet]: \"1fr 1fr\" },\n})","lang":"tsx","html":"<span class=\"th-token th-keyword\">import</span> { css } <span class=\"th-token th-keyword\">from</span> <span class=\"th-token th-string\">&quot;@kirana-style/core&quot;</span>\n<span class=\"th-token th-keyword\">import</span> { tablet } <span class=\"th-token th-keyword\">from</span> <span class=\"th-token th-string\">&quot;./breakpoints&quot;</span>\n\n<span class=\"th-token th-keyword\">export</span> <span class=\"th-token th-keyword\">const</span> grid = <span class=\"th-token th-function\">css</span>({\n  <span class=\"th-token th-property\">gridTemplateColumns</span>: { <span class=\"th-token th-property\">base</span>: <span class=\"th-token th-string\">&quot;1fr&quot;</span>, [tablet]: <span class=\"th-token th-string\">&quot;1fr 1fr&quot;</span> },\n})"}},{"type":"paragraph","children":[{"type":"text","value":"The compiler reads the constant across modules, so a query is written once and\nevery style that names it is checked."}]}],"headings":[{"id":"at-rules","text":"At-rules","level":1},{"id":"counter-styles","text":"Counter styles","level":2},{"id":"why-not-a-stylesheet","text":"Why not a stylesheet","level":3},{"id":"what-the-compiler-checks","text":"What the compiler checks","level":3},{"id":"in-a-stylesheet","text":"In a stylesheet","level":2},{"id":"a-named-media-query","text":"A named media query","level":2}]}
