"250ms\",\n      [media(\"(prefers-reduced-motion: reduce)\")]: \"0s\",\n    },\n  },\n})","lang":"tsx","html":"<span class=\"th-token th-keyword\">import</span> { css, keyframes, media, viewTransition } <span class=\"th-token th-keyword\">from</span> <span class=\"th-token th-string\">&quot;@kirana-style/core&quot;</span>\n\n<span class=\"th-token th-keyword\">const</span> fadeOut = <span class=\"th-token th-function\">keyframes</span>({ <span class=\"th-token th-property\">to</span>: { <span class=\"th-token th-property\">opacity</span>: <span class=\"th-token th-number\">0</span> } })\n<span class=\"th-token th-keyword\">const</span> slideIn = <span class=\"th-token th-function\">keyframes</span>({ <span class=\"th-token th-property\">from</span>: { <span class=\"th-token th-property\">translate</span>: <span class=\"th-token th-string\">&quot;0 1rem&quot;</span> } })\n\n<span class=\"th-token th-keyword\">export</span> <span class=\"th-token th-keyword\">const</span> slide = <span class=\"th-token th-function\">viewTransition</span>({\n  <span class=\"th-token th-property\">old</span>: { <span class=\"th-token th-property\">animationName</span>: fadeOut, <span class=\"th-token th-property\">animationDuration</span>: <span class=\"th-token th-string\">&quot;150ms&quot;</span> },\n  <span class=\"th-token th-property\">new</span>: {\n    <span class=\"th-token th-property\">animationName</span>: slideIn,\n    <span class=\"th-token th-property\">animationDuration</span>: {\n      <span class=\"th-token th-property\">base</span>: <span class=\"th-token th-string\">&quot;250ms&quot;</span>,\n      [<span class=\"th-token th-function\">media</span>(<span class=\"th-token th-string\">&quot;(prefers-reduced-motion: reduce)&quot;</span>)]: <span class=\"th-token th-string\">&quot;0s&quot;</span>,\n    },\n  },\n})"}},{"type":"paragraph","children":[{"type":"text","value":"The result is a class, "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"kw…","source":"kw…"}},{"type":"text","value":", that names itself as the element's\n"},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"view-transition-class","source":"view-transition-class"}},{"type":"text","value":". The parts select every element of that class:"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"@layer kirana.tokens {\n  .kwBm2s {\n    view-transition-class: kwBm2s;\n  }\n  ::view-transition-old(*.kwBm2s) {\n    animation-name: kfBcwa;\n    animation-duration: 150ms;\n  }\n  ::view-transition-new(*.kwBm2s) {\n    animation-name: kfWkJE;\n    animation-duration: 250ms;\n  }\n  @media (prefers-reduced-motion: reduce) {\n    ::view-transition-new(*.kwBm2s) {\n      animation-duration: 0s;\n    }\n  }\n}","lang":"css","html":"@layer kirana.tokens {\n  <span class=\"th-token th-selector\">.kwBm2s </span>{\n    <span class=\"th-token th-property\">view-transition-class</span>: kwBm2s;\n  }\n  <span class=\"th-token th-selector\">::view-transition-old(*.kwBm2s) </span>{\n    <span class=\"th-token th-property\">animation-name</span>: kfBcwa;\n    <span class=\"th-token th-property\">animation-duration</span>: <span class=\"th-token th-number\">150ms</span>;\n  }\n  <span class=\"th-token th-selector\">::view-transition-new(*.kwBm2s) </span>{\n    <span class=\"th-token th-property\">animation-name</span>: kfWkJE;\n    <span class=\"th-token th-property\">animation-duration</span>: <span class=\"th-token th-number\">250ms</span>;\n  }\n <span class=\"th-token th-selector\"> @media (prefers-reduced-motion: reduce) </span>{\n    <span class=\"th-token th-selector\">::view-transition-new(*.kwBm2s) </span>{\n      <span class=\"th-token th-property\">animation-duration</span>: <span class=\"th-token th-number\">0s</span>;\n    }\n  }\n}"}},{"type":"heading","depth":2,"id