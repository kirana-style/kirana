{"type":"root","children":[{"type":"heading","depth":1,"id":"relations","children":[{"type":"text","value":"Relations"}]},{"type":"paragraph","children":[{"type":"text","value":"Sometimes an element's style depends on "},{"type":"emphasis","children":[{"type":"text","value":"another"}]},{"type":"text","value":" element's state: a label that\ndims when its field is disabled, an icon that rotates when its menu is open."}]},{"type":"paragraph","children":[{"type":"text","value":"A relation names that connection once, and both ends refer to it:"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"import { css, relation } from \"@kirana-style/core\"\n\nexport const field = relation(\"field\")\n\nconst styles = {\n  root: css({ display: \"grid\", gap: \"0.25rem\" }),\n  label: css({\n    opacity: {\n      base: 1,\n      [field.within('[data-disabled=\"true\"]')]: 0.5,\n    },\n  }),\n}\n\nexport function Field({ disabled, children }) {\n  return (\n    <div data-disabled={disabled} sx={[field.anchor, styles.root]}>\n      <label sx={styles.label}>{children}</label>\n    </div>\n  )\n}","lang":"tsx","html":"<span class=\"th-token th-keyword\">import</span> { css, relation } <span class=\"th-token th-keyword\">from</span> <span class=\"th-token th-string\">&quot;@kirana-style/core&quot;</span>\n\n<span class=\"th-token th-keyword\">export</span> <span class=\"th-token th-keyword\">const</span> field = <span class=\"th-token th-function\">relation</span>(<span class=\"th-token th-string\">&quot;field&quot;</span>)\n\n<span class=\"th-token th-keyword\">const</span> styles = {\n  <span class=\"th-token th-property\">root</span>: <span class=\"th-token th-function\">css</span>({ <span class=\"th-token th-property\">display</span>: <span class=\"th-token th-string\">&quot;grid&quot;</span>, <span class=\"th-token th-property\">gap</span>: <span class=\"th-token th-string\">&quot;0.25rem&quot;</span> }),\n  <span class=\"th-token th-property\">label</span>: <span class=\"th-token th-function\">css</span>({\n    <span class=\"th-token th-property\">opacity</span>: {\n      <span class=\"th-token th-property\">base</span>: <span class=\"th-token th-number\">1</span>,\n      [field.<span class=\"th-token th-property\">within</span>(<span class=\"th-token th-string\">&#39;[data-disabled=&quot;true&quot;]&#39;</span>)]: <span class=\"th-token th-number\">0.5</span>,\n    },\n  }),\n}\n\n<span class=\"th-token th-keyword\">export</span> <span class=\"th-token th-keyword\">function</span> <span class=\"th-token th-function\">Field</span>({ disabled, children }) {\n  <span class=\"th-token th-keyword\">return</span> (\n    &lt;<span class=\"th-token th-tag\">div</span> <span class=\"th-token th-attr\">data-disabled</span>={disabled} <span class=\"th-token th-attr\">sx</span>={[field.<span class=\"th-token th-property\">anchor</span>, styles.<span class=\"th-token th-property\">root</span>]}&gt;\n      &lt;<span class=\"th-token th-tag\">label</span> <span class=\"th-token th-attr\">sx</span>={styles.<span class=\"th-token th-property\">label</span>}&gt;{children}&lt;/<span class=\"th-token th-tag\">label</span>&gt;\n    &lt;/<span class=\"th-token th-tag\">div</span>&gt;\n  )\n}"}},{"type":"paragraph","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"field.<span class=\"th-token th-property\">anchor</span>","source":"field.anchor"}},{"type":"text","value":" marks the element whose state is read. "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"field.<span class=\"th-token th-property\">within</span>(state)","source":"field.within(state)"}},{"type":"text","value":" reads\nit from a descendant."}]},{"type":"component","name":"figure-relation","attributes":{},"children":[]},{"type":"heading","depth":2,"id":"the-four-reads","children":[{"type":"text","value":"The four reads"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Read"}]},{"type":"tableCell","children":[{"type":"text","value":"Means"}]},{"type":"tableCell","children":[{"type":"text","value":"Tailwind equivalent"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-function\">within</span>(state?)","source":"within(state?)"}}]},{"type":"tableCell","children":[{"type":"text","value":"the anchor is an "},{"type":"strong","children":[{"type":"text","value":"ancestor"}]}]},{"type":"tableCell","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"group-*","source":"group-*"}}]}],[{"type":"tableCell","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-function\">parent</span>(state?)","source":"parent(state?)"}}]},{"type":"tableCell","children":[{"type":"text","value":"the anchor is the "},{"type":"strong","children":[{"type":"text","value":"parent"}]}]},{"type":"tableCell","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"*:","source":"*:"}},{"type":"text","value":", from the child"}]}],[{"type":"tableCell","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-function\">after</span>(state?)","source":"after(state?)"}}]},{"type":"tableCell","children":[{"type":"text","value":"the anchor is an "},{"type":"strong","children":[{"type":"text","value":"earlier sibling"}]}]},{"type":"tableCell","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"peer-*","source":"peer-*"}}]}],[{"type":"tableCell","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-function\">before</span>(state?)","source":"before(state?)"}}]},{"type":"tableCell","children":[{"type":"text","value":"the anchor is a "},{"type":"strong","children":[{"type":"text","value":"later sibling"}]}]},{"type":"tableCell","children":[{"type":"text","value":"none"}]}]]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"state","source":"state"}},{"type":"text","value":" argument is any selector the anchor may match, such as\n"},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-string\">&#39;[data-open]&#39;</span>","source":"'[data-open]'"}},{"type":"text","value":", "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-string\">&quot;:hover&quot;</span>","source":"\":hover\""}},{"type":"text","value":" or "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-string\">&#39;[data-size=&quot;lg&quot;]&#39;</span>","source":"'[data-size=\"lg\"]'"}},{"type":"text","value":". Omit it to mean \"the anchor exists\", which is\nhow you style by structure rather than state."}]},{"type":"heading","depth":2,"id":"why-declare-it-at-all","children":[{"type":"text","value":"Why declare it at all"}]},{"type":"paragraph","children":[{"type":"text","value":"Because the compiler checks it. Two errors you get for free:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"relation-without-anchor","source":"relation-without-anchor"}}]},{"type":"text","value":": a style reads a relation, but nothing applies\nits anchor. In a class-string system this is a "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-attr\">group-hover:</span>","source":"group-hover:"}},{"type":"text","value":" that silently\nnever fires. An application's build checks the relations whose module it\ncompiled, so a shared component may read an ancestor that only some\napplications render; "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-command\">kirana-style</span> check","source":"kirana-style check"}},{"type":"text","value":" checks every relation in the project."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"relation-placement","source":"relation-placement"}}]},{"type":"text","value":": the anchor cannot be proven to be in the right\nposition: "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-function\">after</span>()","source":"after()"}},{"type":"text","value":" used where the anchor is not an earlier sibling, for\nexample."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"A relation that is anchored and never read is reported too ("},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"relation-unused","source":"relation-unused"}},{"type":"text","value":"),\nso dead relations do not accumulate. One that its module keeps to itself is\nchecked in every build. One that is exported is checked where the whole project\nis compiled, by "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-command\">kirana-style</span> check","source":"kirana-style check"}},{"type":"text","value":" and in your editor: a bundler build compiles\nonly the modules it reaches, so a shared component's reader may simply not be\nin this application. And because a relation is identified by its\npackage and name, two modules of one package that both write "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-function\">relation</span>(<span class=\"th-token th-string\">&quot;card&quot;</span>)","source":"relation(\"card\")"}},{"type":"text","value":"\nwould share one marker without meaning to: "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"relation-name-collision","source":"relation-name-collision"}},{"type":"text","value":" names both\nfiles. Export the relation from one module and import it where it is read."}]},{"type":"paragraph","children":[{"type":"text","value":"A module that holds only the reads, with no "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-function\">css</span>()","source":"css()"}},{"type":"text","value":" of its own, compiles them too."}]},{"type":"paragraph","children":[{"type":"text","value":"A component set installed one item at a time can have a reader whose anchor's\ncomponent is not installed: a select that fills the Field it sits in, in a\nproject without Field. Declare that relation optional, and the read is left\nalone where no anchor exists, where it never matches:"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"export const fieldScope = relation(\"field\", { optional: true })","lang":"ts","html":"<span class=\"th-token th-keyword\">export</span> <span class=\"th-token th-keyword\">const</span> fieldScope = <span class=\"th-token th-function\">relation</span>(<span class=\"th-token th-string\">&quot;field&quot;</span>, { <span class=\"th-token th-property\">optional</span>: <span class=\"th-token th-literal\">true</span> })"}},{"type":"paragraph","children":[{"type":"text","value":"Where both are installed, an optional relation is placed and checked like any\nother; only the missing anchor is not an error."}]},{"type":"heading","depth":3,"id":"nested-in-its-own-kind","children":[{"type":"text","value":"Nested in its own kind"}]},{"type":"paragraph","children":[{"type":"text","value":"A component can read its own relation to know it sits inside another of its\nkind: shadcn/ui's FieldGroup tightens a group directly inside another group. The\ngroup anchors the relation and reads it from the parent:"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"const group = relation(\"field-group\")\n\nconst styles = {\n  group: css(group.anchor, {\n    gap: { base: \"1.75rem\", [group.parent()]: \"1rem\" },\n  }),\n}","lang":"tsx","html":"<span class=\"th-token th-keyword\">const</span> group = <span class=\"th-token th-function\">relation</span>(<span class=\"th-token th-string\">&quot;field-group&quot;</span>)\n\n<span class=\"th-token th-keyword\">const</span> styles = {\n  <span class=\"th-token th-property\">group</span>: <span class=\"th-token th-function\">css</span>(group.<span class=\"th-token th-property\">anchor</span>, {\n    <span class=\"th-token th-property\">gap</span>: { <span class=\"th-token th-property\">base</span>: <span class=\"th-token th-string\">&quot;1.75rem&quot;</span>, [group.<span class=\"th-token th-property\">parent</span>()]: <span class=\"th-token th-string\">&quot;1rem&quot;</span> },\n  }),\n}"}},{"type":"paragraph","children":[{"type":"text","value":"An element that carries an anchor and reads it can only mean an outer one, so the\nplacement check accepts it, for both kinds of ancestor read. A parent read reaches\nthe anchor's children only, where "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"within","source":"within"}},{"type":"text","value":" reaches any depth: a port of "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"*:w-full","source":"*:w-full"}},{"type":"text","value":"\nwritten with "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"within","source":"within"}},{"type":"text","value":" would also widen a grandchild inside a wrapper."}]},{"type":"paragraph","children":[{"type":"text","value":"The same holds beside it. shadcn/ui's "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-type\">ItemContent</span>","source":"ItemContent"}},{"type":"text","value":" keeps its width when it\nfollows another, and its caller is the one that repeats it, so the part anchors\nthe relation and reads it "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-function\">after</span>()","source":"after()"}},{"type":"text","value":":"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"const content = relation(\"item-content\")\n\nconst styles = {\n  content: css(content.anchor, {\n    flex: { base: \"1 1 0%\", [content.after()]: \"none\" },\n  }),\n}","lang":"tsx","html":"<span class=\"th-token th-keyword\">const</span> content = <span class=\"th-token th-function\">relation</span>(<span class=\"th-token th-string\">&quot;item-content&quot;</span>)\n\n<span class=\"th-token th-keyword\">const</span> styles = {\n  <span class=\"th-token th-property\">content</span>: <span class=\"th-token th-function\">css</span>(content.<span class=\"th-token th-property\">anchor</span>, {\n    <span class=\"th-token th-property\">flex</span>: { <span class=\"th-token th-property\">base</span>: <span class=\"th-token th-string\">&quot;1 1 0%&quot;</span>, [content.<span class=\"th-token th-property\">after</span>()]: <span class=\"th-token th-string\">&quot;none&quot;</span> },\n  }),\n}"}},{"type":"paragraph","children":[{"type":"text","value":"The placement check accepts an "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-function\">after</span>()","source":"after()"}},{"type":"text","value":" or "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-function\">before</span>()","source":"before()"}},{"type":"text","value":" read on an element that\ncarries its own anchor: another instance beside it, which only the caller's tree\nholds."}]},{"type":"heading","depth":2,"id":"anchors-are-placed-not-guessed","children":[{"type":"text","value":"Anchors are placed, not guessed"}]},{"type":"paragraph","children":[{"type":"text","value":"The anchor must sit on the element whose state you are reading. That sounds\nobvious, and it is the most common mistake when porting: the state lives on the\nroot, the anchor gets attached to an inner wrapper, and the read never matches."}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"// The attribute and the anchor belong on the same element.\n<div data-state={open ? \"open\" : \"closed\"} sx={[menu.anchor, styles.root]}>","lang":"tsx","html":"<span class=\"th-token th-comment\">// The attribute and the anchor belong on the same element.</span>\n&lt;<span class=\"th-token th-tag\">div</span> data-<span class=\"th-token th-attr\">state</span>={open ? <span class=\"th-token th-string\">&quot;open&quot;</span> : <span class=\"th-token th-string\">&quot;closed&quot;</span>} <span class=\"th-token th-attr\">sx</span>={[menu.<span class=\"th-token th-property\">anchor</span>, styles.<span class=\"th-token th-property\">root</span>]}&gt;"}},{"type":"heading","depth":2,"id":"has-is-not-a-relation","children":[{"type":"inlineCode","value":":has()"},{"type":"text","value":" is not a relation"}]},{"type":"paragraph","children":[{"type":"text","value":"Styling a parent by its children is a plain condition, because the selector does\nit on its own:"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"css({\n  paddingBlockEnd: { \":has([data-slot='footer'])\": \"0.5rem\" },\n})","lang":"tsx","html":"<span class=\"th-token th-function\">css</span>({\n  <span class=\"th-token th-property\">paddingBlockEnd</span>: { <span class=\"th-token th-string\">&quot;:has([data-slot=&#39;footer&#39;])&quot;</span>: <span class=\"th-token th-string\">&quot;0.5rem&quot;</span> },\n})"}},{"type":"paragraph","children":[{"type":"text","value":"Relations exist for the other direction (a descendant or sibling reading state\nthat lives elsewhere), where CSS needs the two ends to agree on a class."}]},{"type":"heading","depth":2,"id":"precedence","children":[{"type":"text","value":"Precedence"}]},{"type":"paragraph","children":[{"type":"text","value":"A relation read is its own condition class, ranked below attributes and\npseudo-classes on the element itself, and above at-rules\n("},{"type":"link","href":"/docs/styling/precedence","children":[{"type":"text","value":"ladder"}]},{"type":"text","value":", step 3). So an element's own "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":":hover","source":":hover"}},{"type":"text","value":" beats a\nvalue that depends on an ancestor's "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":":hover","source":":hover"}},{"type":"text","value":", which is what an author usually\nmeans."}]},{"type":"paragraph","children":[{"type":"text","value":"A parent read is the exception: it ranks as a pseudo-class, as the\n"},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":":<span class=\"th-token th-function\">where</span>([data-slot] &gt; *)","source":":where([data-slot] > *)"}},{"type":"text","value":" selector it replaces does. A group inside another group\ntakes the nested gap over a style's wider one without restating it under every\nstyle."}]}],"headings":[{"id":"relations","text":"Relations","level":1},{"id":"the-four-reads","text":"The four reads","level":2},{"id":"why-declare-it-at-all","text":"Why declare it at all","level":2},{"id":"nested-in-its-own-kind","text":"Nested in its own kind","level":3},{"id":"anchors-are-placed-not-guessed","text":"Anchors are placed, not guessed","level":2},{"id":"has-is-not-a-relation","text":":has() is not a relation","level":2},{"id":"precedence","text":"Precedence","level":2}]}
