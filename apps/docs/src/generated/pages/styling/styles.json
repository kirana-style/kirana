ingLeft"}},{"type":"text","value":" and\n"},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"paddingInlineStart","source":"paddingInlineStart"}},{"type":"text","value":") is allowed, but they are "},{"type":"emphasis","children":[{"type":"text","value":"different"}]},{"type":"text","value":" declarations, and when\nthe result could mislead the compiler says so ("},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"mixed-logical-physical","source":"mixed-logical-physical"}},{"type":"text","value":")."}]},{"type":"paragraph","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"translate","source":"translate"}},{"type":"text","value":" and "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"transform","source":"transform"}},{"type":"text","value":" have no logical form. To centre an element, pair them\nwith a physical inset ("},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-property\">left</span>: <span class=\"th-token th-string\">&quot;50%&quot;</span>","source":"left: \"50%\""}},{"type":"text","value":", "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-property\">translate</span>: <span class=\"th-token th-string\">&quot;-50% 0&quot;</span>","source":"translate: \"-50% 0\""}},{"type":"text","value":"): a logical inset\nchanges side in right-to-left text while the translate keeps pulling the same way,\nand the compiler warns about that pair too."}]},{"type":"heading","depth":2,"id":"where-styles-live","children":[{"type":"text","value":"Where styles live"}]},{"type":"paragraph","children":[{"type":"text","value":"A handle is usually a module-level constant, because it compiles to a constant:"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"const styles = {\n  root: css({ … }),\n  title: css({ … }),\n}","lang":"tsx","html":"<span class=\"th-token th-keyword\">const</span> styles = {\n  <span class=\"th-token th-property\">root</span>: <span class=\"th-token th-function\">css</span>({ … }),\n  <span class=\"th-token th-property\">title</span>: <span class=\"th-token th-function\">css</span>({ … }),\n}"}},{"type":"paragraph","children":[{"type":"text","value":"Writing "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-function\">css</span>({ … })","source":"css({ … })"}},{"type":"text","value":" inside a component body is fine too, since it still\ncompiles, but there is no reason to unless the style depends on a value only\nknown at render time, which is its own topic:\n"},{"type":"link","href":"/docs/styling/dynamic","children":[{"type":"text","value":"dynamic values"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"next","children":[{"type":"text","value":"Next"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"/docs/styling/sx","children":[{"type":"text","value":"The "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"sx","source":"sx"}},{"type":"text","value":" prop"}]},{"type":"text","value":": putting a handle on an element."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"/docs/styling/conditions","children":[{"type":"text","value":"Conditions"}]},{"type":"text","value":": hover, breakpoints, attributes."}]}]}]}],"headings":[{"id":"