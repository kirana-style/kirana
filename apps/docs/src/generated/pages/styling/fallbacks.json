{"type":"root","children":[{"type":"heading","depth":1,"id":"fallback-values","children":[{"type":"text","value":"Fallback values"}]},{"type":"paragraph","children":[{"type":"text","value":"A browser drops a declaration whose value it does not understand and keeps the\none before it. "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-function\">firstThatWorks</span>()","source":"firstThatWorks()"}},{"type":"text","value":" uses that: you list the values a property\nshould try, the preferred first, and Kirana writes the property once per value."}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"import { css, firstThatWorks } from \"@kirana-style/core\"\n\nconst screen = css({\n  minHeight: firstThatWorks(\"100dvh\", \"100vh\"),\n  position: firstThatWorks(\"sticky\", \"-webkit-sticky\"),\n})","lang":"tsx","html":"<span class=\"th-token th-keyword\">import</span> { css, firstThatWorks } <span class=\"th-token th-keyword\">from</span> <span class=\"th-token th-string\">&quot;@kirana-style/core&quot;</span>\n\n<span class=\"th-token th-keyword\">const</span> screen = <span class=\"th-token th-function\">css</span>({\n  <span class=\"th-token th-property\">minHeight</span>: <span class=\"th-token th-function\">firstThatWorks</span>(<span class=\"th-token th-string\">&quot;100dvh&quot;</span>, <span class=\"th-token th-string\">&quot;100vh&quot;</span>),\n  <span class=\"th-token th-property\">position</span>: <span class=\"th-token th-function\">firstThatWorks</span>(<span class=\"th-token th-string\">&quot;sticky&quot;</span>, <span class=\"th-token th-string\">&quot;-webkit-sticky&quot;</span>),\n})"}},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":".k7U_ulId {\n  min-height: 100vh;\n  min-height: 100dvh;\n}","lang":"css","html":"<span class=\"th-t