{"type":"root","children":[{"type":"heading","depth":1,"id":"merging-and-removal","children":[{"type":"text","value":"Merging and removal"}]},{"type":"paragraph","children":[{"type":"text","value":"Styles combine in three places: "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-function\">css</span>(a, b)","source":"css(a, b)"}},{"type":"text","value":", "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-function\">cx</span>(a, b)","source":"cx(a, b)"}},{"type":"text","value":", and "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-attr\">sx</span>={[a, b]}","source":"sx={[a, b]}"}},{"type":"text","value":". All\nthree merge the same way, in order, and the rule is the one from the\n"},{"type":"link","href":"/docs/start/mental-model","children":[{"type":"text","value":"mental model"}]},{"type":"text","value":":"}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"A later style replaces the entries it names, and leaves the others alone."}]}]},{"type":"heading","depth":2,"id":"entries-not-properties","children":[{"type":"text","value":"Entries, not properties"}]},{"type":"paragraph","children":[{"type":"text","value":"A property holds one entry per condition set. "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"color","source":"color"}},{"type":"text","value":" with a base value and a\n"},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":":hover","source":":hover"}},{"type":"text","value":" value is two entries."}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"const link = css({\n  color: { base: \"navy\", \":hover\": \"royalblue\" },\n  textDecorationLine: \"underline\",\n})\n\nconst quiet = css({ color: \"grey\" })\n\n<a sx={[link, quiet]} />","lang":"tsx","html":"<span class=\"th-token th-keyword\">const</span> link = <span class=\"th-token th-function\">css</span>({\n  <span class=\"th-token th-property\">color</span>: { <span class=\"th-token th-property\">base</span>: <span class=\"th-token th-string\">&quot;navy&quot;</span>, <span class=\"th-token th-string\">&quot;:hover&quot;</span>: <span class=\"th-token th-string\">&quot;royalblue&quot;</span> },\n  <span class=\"th-token th-property\">textDecorationLine</span>: <span class=\"th-token th-string\">&quot;underline&quot;</span>,\n})\n\n<span class=\"th-token th-keyword\">const</span> quiet = <span class=\"th-token th-function\">css</span>({ <span class=\"th-token th-property\">color</span>: <span class=\"th-token th-string\">&quot;grey&quot;</span> })\n\n&lt;<span class=\"th-token th-tag\">a</span> <span class=\"th-token th-attr\">sx</span>={[link, quiet]} /&gt;"}},{"type":"paragraph","children":[{"type":"text","value":"The anchor is grey, still royal blue on hover, and still underlined. "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"quiet","source":"quiet"}},{"type":"text","value":" named\nthe base entry of "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"color","source":"color"}},{"type":"text","value":", so that is the entry it replaced."}]},{"type":"component","name":"figure-merge","attributes":{},"children":[]},{"type":"paragraph","children":[{"type":"text","value":"This is the single biggest difference from class-string systems, where a later\n"},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"text-grey","source":"text-grey"}},{"type":"text","value":" removes the whole colour idea, hover included."}]},{"type":"heading","depth":2,"id":"removing","children":[{"type":"text","value":"Removing"}]},{"type":"paragraph","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"null","source":"null"}},{"type":"text","value":" removes. There are three forms, and they differ in reach:"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"// one entry\ncss({ color: { base: null } })\n\n// every entry of one property\ncss({ color: null })\n\n// everything except what this style lists\ncss({ color: { \"*\": null, base: \"grey\" } })","lang":"tsx","html":"<span class=\"th-token th-comment\">// one entry</span>\n<span class=\"th-token th-function\">css</span>({ <span class=\"th-token th-property\">color</span>: { <span class=\"th-token th-property\">base</span>: <span class=\"th-token th-literal\">null</span> } })\n\n<span class=\"th-token th-comment\">// every entry of one property</span>\n<span class=\"th-token th-function\">css</span>({ <span class=\"th-token th-property\">color</span>: <span class=\"th-token th-literal\">null</span> })\n\n<span class=\"th-token th-comment\">// everything except what this style lists</span>\n<span class=\"th-token th-function\">css</span>({ <span class=\"th-token th-property\">color</span>: { <span class=\"th-token th-string\">&quot;*&quot;</span>: <span class=\"th-token th-literal\">null</span>, <span class=\"th-token th-property\">base</span>: <span class=\"th-token th-string\">&quot;grey&quot;</span> } })"}},{"type":"paragraph","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"{ <span class=\"th-token th-string\">&quot;*&quot;</span>: <span class=\"th-token th-literal\">null</span>, <span class=\"th-token th-property\">base</span>: <span class=\"th-token th-string\">&quot;grey&quot;</span> }","source":"{ \"*\": null, base: \"grey\" }"}},{"type":"text","value":" is the one to reach for when you want a component's\nconditional chrome gone and your own value in its place, such as an input inside a\ngroup that should lose the group's focus ring."}]},{"type":"component","name":"callout","tagName":"md-callout","attributes":{},"children":[{"type":"paragraph","children":[{"type":"text","value":"In StyleX, "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"default: null","source":"default: null"}},{"type":"text","value":" means \"this variant sets nothing here\". In Kirana,\n"},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"base: null","source":"base: null"}},{"type":"text","value":" "},{"type":"strong","children":[{"type":"text","value":"removes"}]},{"type":"text","value":" a base value an earlier style set. If you are porting,\nthis is the line to re-read; see\n"},{"type":"link","href":"/docs/migration/from-stylex","children":[{"type":"text","value":"migrating from StyleX"}]},{"type":"text","value":"."}]}],"properties":{"kind":"warning","title":"`base: null` is not \"no value\""}},{"type":"heading","depth":2,"id":"cx","children":[{"type":"inlineCode","value":"cx()"}]},{"type":"paragraph","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-function\">cx</span>()","source":"cx()"}},{"type":"text","value":" merges handles and skips "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"null","source":"null"}},{"type":"text","value":", "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"undefined","source":"undefined"}},{"type":"text","value":" and "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"false","source":"false"}},{"type":"text","value":", which makes\nconditional composition read naturally:"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"import { cx } from \"@kirana-style/core\"\n\nconst handle = cx(styles.root, isOpen && styles.open, props.sx)","lang":"tsx","html":"<span class=\"th-token th-keyword\">import</span> { cx } <span class=\"th-token th-keyword\">from</span> <span class=\"th-token th-string\">&quot;@kirana-style/core&quot;</span>\n\n<span class=\"th-token th-keyword\">const</span> handle = <span class=\"th-token th-function\">cx</span>(styles.<span class=\"th-token th-property\">root</span>, isOpen &amp;&amp; styles.<span class=\"th-token th-property\">open</span>, props.<span class=\"th-token th-property\">sx</span>)"}},{"type":"paragraph","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-attr\">sx</span>={[a, b]}","source":"sx={[a, b]}"}},{"type":"text","value":" accepts the same shapes, including nested arrays, so you rarely need\n"},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-function\">cx</span>()","source":"cx()"}},{"type":"text","value":" on an element: it is for building a handle to pass on."}]},{"type":"heading","depth":2,"id":"order-is-the-order-you-wrote","children":[{"type":"text","value":"Order is the order you wrote"}]},{"type":"paragraph","children":[{"type":"text","value":"Merging is left to right, and the last writer of an entry wins "},{"type":"strong","children":[{"type":"text","value":"that entry"}]},{"type":"text","value":".\nWhat order does "},{"type":"emphasis","children":[{"type":"text","value":"not"}]},{"type":"text","value":" decide is a conflict between two different conditions: that\nis the "},{"type":"link","href":"/docs/styling/precedence","children":[{"type":"text","value":"precedence ladder"}]},{"type":"text","value":", and it applies after\nmerging."}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"// Both entries survive the merge; the ladder decides which applies when hovered.\ncss({ color: \"black\" }, { color: { \":hover\": \"blue\" } })","lang":"tsx","html":"<span class=\"th-token th-comment\">// Both entries survive the merge; the ladder decides which applies when hovered.</span>\n<span class=\"th-token th-function\">css</span>({ <span class=\"th-token th-property\">color</span>: <span class=\"th-token th-string\">&quot;black&quot;</span> }, { <span class=\"th-token th-property\">color</span>: { <span class=\"th-token th-string\">&quot;:hover&quot;</span>: <span class=\"th-token th-string\">&quot;blue&quot;</span> } })"}},{"type":"heading","depth":2,"id":"class-strings-come-from-a-merge","children":[{"type":"text","value":"Class strings come from a merge"}]},{"type":"paragraph","children":[{"type":"text","value":"A merge leaves an element one class per entry, and the stylesheet relies on it:\ntwo classes for the same entry never reach one element, so the compiler orders\nthem however writes the smallest stylesheet. Joining two compiled class strings\nby hand skips the merge, and when both name the same entry, which one applies is\nnot defined."}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"// Both strings may set the base `color`: either can win.\n<a className={`${props(link).className} ${props(quiet).className}`} />\n\n// The merge keeps one: `quiet`'s.\n<a sx={[link, quiet]} />","lang":"tsx","html":"<span class=\"th-token th-comment\">// Both strings may set the base `color`: either can win.</span>\n&lt;<span class=\"th-token th-tag\">a</span> <span class=\"th-token th-attr\">className</span>={<span class=\"th-token th-string\">`</span><span class=\"th-token th-operator\">${</span><span class=\"th-token th-function\">props</span>(link).<span class=\"th-token th-property\">className</span><span class=\"th-token th-operator\">}</span><span class=\"th-token th-string\"> </span><span class=\"th-token th-operator\">${</span><span class=\"th-token th-function\">props</span>(quiet).<span class=\"th-token th-property\">className</span><span class=\"th-token th-operator\">}</span><span class=\"th-token th-string\">`</span>} /&gt;\n\n<span class=\"th-token th-comment\">// The merge keeps one: `quiet`&#39;s.</span>\n&lt;<span class=\"th-token th-tag\">a</span> <span class=\"th-token th-attr\">sx</span>={[link, quiet]} /&gt;"}},{"type":"paragraph","children":[{"type":"text","value":"Pass handles instead, and combine them with "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"sx","source":"sx"}},{"type":"text","value":", "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-function\">cx</span>()","source":"cx()"}},{"type":"text","value":" or "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-function\">props</span>()","source":"props()"}},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"shorthands-merge-per-longhand","children":[{"type":"text","value":"Shorthands merge per longhand"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"css({ padding: \"1rem\" }, { paddingTop: \"2rem\" })","lang":"tsx","html":"<span class=\"th-token th-function\">css</span>({ <span class=\"th-token th-property\">padding</span>: <span class=\"th-token th-string\">&quot;1rem&quot;</span> }, { <span class=\"th-token th-property\">paddingTop</span>: <span class=\"th-token th-string\">&quot;2rem&quot;</span> })"}},{"type":"paragraph","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"padding","source":"padding"}},{"type":"text","value":" expands to four longhands, "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"paddingTop","source":"paddingTop"}},{"type":"text","value":" replaces one of them, and the\nother three keep "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-number\">1</span>rem","source":"1rem"}},{"type":"text","value":". The same is true across modules and across components:\nmerging is defined on longhands, so nothing depends on which shorthand each author\nhappened to use."}]},{"type":"heading","depth":2,"id":"a-component-s-own-sx","children":[{"type":"text","value":"A component's own "},{"type":"inlineCode","value":"sx"}]},{"type":"paragraph","children":[{"type":"text","value":"A component that takes "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"sx","source":"sx"}},{"type":"text","value":" should merge it "},{"type":"strong","children":[{"type":"text","value":"last"}]},{"type":"text","value":", so its caller can override:"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"export function Card({\n  sx,\n  ...props\n}: { sx?: Sx } & React.ComponentProps<\"div\">) {\n  return <div {...props} sx={[styles.root, sx]} />\n}","lang":"tsx","html":"<span class=\"th-token th-keyword\">export</span> <span class=\"th-token th-keyword\">function</span> <span class=\"th-token th-function\">Card</span>({\n  sx,\n  ...props\n}: { sx?: <span class=\"th-token th-type\">Sx</span> } &amp; <span class=\"th-token th-type\">React</span>.<span class=\"th-token th-property\">ComponentProps</span>&lt;<span class=\"th-token th-string\">&quot;div&quot;</span>&gt;) {\n  <span class=\"th-token th-keyword\">return</span> &lt;<span class=\"th-token th-tag\">div</span> {...props} <span class=\"th-token th-attr\">sx</span>={[styles.<span class=\"th-token th-property\">root</span>, sx]} /&gt;\n}"}},{"type":"paragraph","children":[{"type":"text","value":"Declaring "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"sx","source":"sx"}},{"type":"text","value":" and never applying it is reported ("},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"unused-sx","source":"unused-sx"}},{"type":"text","value":")."}]}],"headings":[{"id":"merging-and-removal","text":"Merging and removal","level":1},{"id":"entries-not-properties","text":"Entries, not properties","level":2},{"id":"removing","text":"Removing","level":2},{"id":"cx","text":"cx()","level":2},{"id":"order-is-the-order-you-wrote","text":"Order is the order you wrote","level":2},{"id":"class-strings-come-from-a-merge","text":"Class strings come from a merge","level":2},{"id":"shorthands-merge-per-longhand","text":"Shorthands merge per longhand","level":2},{"id":"a-component-s-own-sx","text":"A component's own sx","level":2}]}
