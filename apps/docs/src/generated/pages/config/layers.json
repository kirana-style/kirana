{"type":"root","children":[{"type":"heading","depth":1,"id":"layers-and-global-css","children":[{"type":"text","value":"Layers and global CSS"}]},{"type":"paragraph","children":[{"type":"text","value":"Kirana writes every rule inside a layer, and declares the order in one statement\nat the top of the stylesheet:"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"@layer reset, base, kirana;\n@layer kirana.tokens, kirana.themes, kirana.contextual, kirana.atoms;","lang":"css","html":"@layer reset, base, kirana;\n@layer kirana.tokens, kirana.themes, kirana.contextual, kirana.atoms;"}},{"type":"component","name":"figure-layers","attributes":{},"children":[]},{"type":"paragraph","children":[{"type":"text","value":"The first line is yours: the names from "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"layers.<span class=\"th-token th-property\">before</span>","source":"layers.before"}},{"type":"text","value":" and "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"layers.<span class=\"th-token th-property\">after</span>","source":"layers.after"}},{"type":"text","value":". The\nsecond is Kirana's own, and its order is fixed."}]},{"type":"table","align":[null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Layer"}]},{"type":"tableCell","children":[{"type":"text","value":"Holds"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"kirana.<span class=\"th-token th-property\">tokens</span>","source":"kirana.tokens"}}]},{"type":"tableCell","children":[{"type":"text","value":"Variable token defaults on "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":":root","source":":root"}},{"type":"text","value":", and their per-mode overrides"}]}],[{"type":"tableCell","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"kirana.<span class=\"th-token th-property\">themes</span>","source":"kirana.themes"}}]},{"type":"tableCell","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"defineTheme","source":"defineTheme"}},{"type":"text","value":" overrides"}]}],[{"type":"tableCell","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"kirana.<span class=\"th-token th-property\">contextual</span>","source":"kirana.contextual"}}]},{"type":"tableCell","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"select.*","source":"select.*"}},{"type":"text","value":" styles"}]}],[{"type":"tableCell","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"kirana.<span class=\"th-token th-property\">atoms</span>","source":"kirana.atoms"}}]},{"type":"tableCell","children":[{"type":"text","value":"Element styles: everything you write with "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-function\">css</span>()","source":"css()"}}]}]]},{"type":"paragraph","children":[{"type":"text","value":"Nothing Kirana emits is unlayered, custom-property assignments included. That is\nwhat lets a reset stay a reset: it cannot accidentally outrank a component style,\nand a component style cannot accidentally outrank a theme."}]},{"type":"heading","depth":2,"id":"tiers","children":[{"type":"text","value":"Tiers"}]},{"type":"paragraph","children":[{"type":"text","value":"Within "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"kirana.<span class=\"th-token th-property\">atoms</span>","source":"kirana.atoms"}},{"type":"text","value":", a hover outranks the base by coming later in the file.\n"},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"layers.<span class=\"th-token th-property\">tiers</span>","source":"layers.tiers"}},{"type":"text","value":" makes each step of that order a layer of its own:"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"export default defineConfig({\n  layers: { before: [\"reset\", \"base\"], tiers: true },\n})","lang":"ts","html":"<span class=\"th-token th-keyword\">export</span> <span class=\"th-token th-keyword\">default</span> <span class=\"th-token th-function\">defineConfig</span>({\n  <span class=\"th-token th-property\">layers</span>: { <span class=\"th-token th-property\">before</span>: [<span class=\"th-token th-string\">&quot;reset&quot;</span>, <span class=\"th-token th-string\">&quot;base&quot;</span>], <span class=\"th-token th-property\">tiers</span>: <span class=\"th-token th-literal\">true</span> },\n})","file":"kirana.config.ts","title":"kirana.config.ts"}},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"@layer kirana.atoms {\n  @layer t0, t1, t2;\n  @layer t0 {\n    .k50_W0yl {\n      color: black;\n    }\n  }\n  @layer t1 {\n    .k50-KFHz_D9ur:where(:hover) {\n      color: red;\n    }\n  }\n}","lang":"css","html":"@layer kirana.atoms {\n  @layer t0, t1, t2;\n <span class=\"th-token th-selector\"> @layer t0 </span>{\n    <span class=\"th-token th-selector\">.k50_W0yl </span>{\n      <span class=\"th-token th-property\">color</span>: black;\n    }\n  }\n <span class=\"th-token th-selector\"> @layer t1 </span>{\n    <span class=\"th-token th-selector\">.k50-KFHz_D9ur:where(:hover) </span>{\n      <span class=\"th-token th-property\">color</span>: red;\n    }\n  }\n}"}},{"type":"paragraph","children":[{"type":"text","value":"Each tier then outranks the ones before it wherever its rules sit, which is what\na stylesheet split into parts needs. The page renders the same. Rules that share a\ndeclaration merge only within a tier, so the stylesheet grows a little (2.3 %\ngzipped on this site). It is off by default."}]},{"type":"heading","depth":2,"id":"your-own-layers","children":[{"type":"text","value":"Your own layers"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"export default defineConfig({\n  layers: { before: [\"reset\", \"base\"] },\n})","lang":"ts","html":"<span class=\"th-token th-keyword\">export</span> <span class=\"th-token th-keyword\">default</span> <span class=\"th-token th-function\">defineConfig</span>({\n  <span class=\"th-token th-property\">layers</span>: { <span class=\"th-token th-property\">before</span>: [<span class=\"th-token th-string\">&quot;reset&quot;</span>, <span class=\"th-token th-string\">&quot;base&quot;</span>] },\n})","file":"kirana.config.ts","title":"kirana.config.ts"}},{"type":"paragraph","children":[{"type":"text","value":"Then write your global CSS into those layers:"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"@layer reset {\n  *,\n  *::before,\n  *::after {\n    box-sizing: border-box;\n  }\n  body {\n    margin: 0;\n  }\n}\n\n@layer base {\n  a {\n    color: inherit;\n  }\n}","lang":"css","html":"@layer reset {\n  *,\n  *::before,\n  <span class=\"th-token th-selector\">*::after </span>{\n    <span class=\"th-token th-property\">box-sizing</span>: border-box;\n  }\n  <span class=\"th-token th-selector\">body </span>{\n    <span class=\"th-token th-property\">margin</span>: <span class=\"th-token th-number\">0</span>;\n  }\n}\n\n@layer base {\n  <span class=\"th-token th-selector\">a </span>{\n    <span class=\"th-token th-property\">color</span>: inherit;\n  }\n}","file":"globals.css","title":"globals.css"}},{"type":"paragraph","children":[{"type":"text","value":"Because "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"reset","source":"reset"}},{"type":"text","value":" and "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"base","source":"base"}},{"type":"text","value":" come before "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-command\">kirana</span>","source":"kirana"}},{"type":"text","value":" in the order statement, every\nKirana rule wins over them, whatever their selectors look like."}]},{"type":"heading","depth":2,"id":"load-order-matters-once","children":[{"type":"text","value":"Load order matters once"}]},{"type":"paragraph","children":[{"type":"text","value":"Import Kirana's stylesheet "},{"type":"strong","children":[{"type":"text","value":"before"}]},{"type":"text","value":" your global CSS. Its "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"@layer","source":"@layer"}},{"type":"text","value":" statement is\nwhat fixes the order, and a layer first seen inside "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"globals.css","source":"globals.css"}},{"type":"text","value":" would otherwise\nbe ordered by where it appeared."}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"<link rel=\"stylesheet\" href={kiranaCss} />   {/* first */}\n<link rel=\"stylesheet\" href={globalCss} />","lang":"tsx","html":"&lt;<span class=\"th-token th-tag\">link</span> <span class=\"th-token th-attr\">rel</span>=<span class=\"th-token th-string\">&quot;stylesheet&quot;</span> <span class=\"th-token th-attr\">href</span>={kiranaCss} /&gt;   {<span class=\"th-token th-comment\">/* first */</span>}\n&lt;<span class=\"th-token th-tag\">link</span> <span class=\"th-token th-attr\">rel</span>=<span class=\"th-token th-string\">&quot;stylesheet&quot;</span> <span class=\"th-token th-attr\">href</span>={globalCss} /&gt;"}},{"type":"heading","depth":2,"id":"third-party-css","children":[{"type":"text","value":"Third-party CSS"}]},{"type":"paragraph","children":[{"type":"text","value":"A package's stylesheet you cannot edit (a date picker, a carousel) goes into a\nlayer you name, so your styles beat it without "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"!important","source":"!important"}},{"type":"text","value":":"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"layers: {\n  before: [\"reset\", \"vendor\", \"base\"]\n}","lang":"ts","html":"<span class=\"th-token th-property\">layers</span>: {\n  <span class=\"th-token th-property\">before</span>: [<span class=\"th-token th-string\">&quot;reset&quot;</span>, <span class=\"th-token th-string\">&quot;vendor&quot;</span>, <span class=\"th-token th-string\">&quot;base&quot;</span>]\n}"}},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"@import \"some-package/dist/style.css\" layer(vendor);","lang":"css","html":"@import <span class=\"th-token th-string\">&quot;some-package/dist/style.css&quot;</span> <span class=\"th-token th-function\">layer</span>(vendor);"}},{"type":"paragraph","children":[{"type":"text","value":"When the package imports its CSS from JavaScript, as a theme does, there is no\n"},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"@import","source":"@import"}},{"type":"text","value":" line to give a layer: on Vite, "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-function\">cssLayer</span>(<span class=\"th-token th-string\">&quot;vendor&quot;</span>, <span class=\"th-token th-string\">&quot;some-package/dist/&quot;</span>)","source":"cssLayer(\"vendor\", \"some-package/dist/\")"}},{"type":"text","value":"\nfrom "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"@kirana-style/vite","source":"@kirana-style/vite"}},{"type":"text","value":" wraps those stylesheets in the layer as they load\n("},{"type":"link","href":"/docs/integrations/vite#a-dependency-s-css-in-a-layer","children":[{"type":"text","value":"the Vite plugin"}]},{"type":"text","value":")."}]},{"type":"heading","depth":2,"id":"when-to-write-global-css-at-all","children":[{"type":"text","value":"When to write global CSS at all"}]},{"type":"paragraph","children":[{"type":"text","value":"Rarely. Two cases hold up:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"A reset"}]},{"type":"text","value":", and base element styles that must apply to bare tags."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Markup you do not render"}]},{"type":"text","value":", where no component can carry a class, scoped by\nan attribute the library sets, as narrowly as you can manage."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Everything else belongs in "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-function\">css</span>()","source":"css()"}},{"type":"text","value":", where the compiler can see it, check it and\ntell you when two declarations fight."}]}],"headings":[{"id":"layers-and-global-css","text":"Layers and global CSS","level":1},{"id":"tiers","text":"Tiers","level":2},{"id":"your-own-layers","text":"Your own layers","level":2},{"id":"load-order-matters-once","text":"Load order matters once","level":2},{"id":"third-party-css","text":"Third-party CSS","level":2},{"id":"when-to-write-global-css-at-all","text":"When to write global CSS at all","level":2}]}
