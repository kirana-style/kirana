{"type":"root","children":[{"type":"heading","depth":1,"id":"the-configuration-file","children":[{"type":"text","value":"The configuration file"}]},{"type":"paragraph","children":[{"type":"text","value":"Configuration is optional. Every key has a default, and a project with no\n"},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"kirana.config.ts","source":"kirana.config.ts"}},{"type":"text","value":" compiles."}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"import { defineConfig } from \"@kirana-style/core/config\"\n\nexport default defineConfig({\n  layers: { before: [\"reset\", \"base\"] },\n  targets: { chrome: 123, safari: \"17.5\" },\n})","lang":"ts","html":"<span class=\"th-token th-keyword\">import</span> { defineConfig } <span class=\"th-token th-keyword\">from</span> <span class=\"th-token th-string\">&quot;@kirana-style/core/config&quot;</span>\n\n<span class=\"th-token th-keyword\">export</span> <span class=\"th-token th-keyword\">default</span> <span class=\"th-token th-function\">defineConfig</span>({\n  <span class=\"th-token th-property\">layers</span>: { <span class=\"th-token th-property\">before</span>: [<span class=\"th-token th-string\">&quot;reset&quot;</span>, <span class=\"th-token th-string\">&quot;base&quot;</span>] },\n  <span class=\"th-token th-property\">targets</span>: { <span class=\"th-token th-property\">chrome</span>: <span class=\"th-token th-number\">123</span>, <span class=\"th-token th-property\">safari</span>: <span class=\"th-token th-string\">&quot;17.5&quot;</span> },\n})","file":"kirana.config.ts","title":"kirana.config.ts"}},{"type":"paragraph","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"defineConfig","source":"defineConfig"}},{"type":"text","value":" is an identity function: it exists for the types."}]},{"type":"heading","depth":2,"id":"how-it-is-found","children":[{"type":"text","value":"How it is found"}]},{"type":"paragraph","children":[{"type":"text","value":"The compiler looks in the project root, in this order, and takes the first match:"}]},{"type":"list","ordered":true,"start":1,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"kirana.config.ts","source":"kirana.config.ts"}}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"kirana.config.mts","source":"kirana.config.mts"}}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"kirana.config.js","source":"kirana.config.js"}}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"kirana.config.mjs","source":"kirana.config.mjs"}}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"kirana.config.json","source":"kirana.config.json"}}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"TypeScript and JavaScript files are imported natively; the default export is the\nconfiguration."}]},{"type":"paragraph","children":[{"type":"text","value":"A TypeScript configuration written as an ES module loads as one even when your\n"},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"package.json","source":"package.json"}},{"type":"text","value":" says "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-string\">&quot;type&quot;</span>: <span class=\"th-token th-string\">&quot;commonjs&quot;</span>","source":"\"type\": \"commonjs\""}},{"type":"text","value":", as "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-command\">npm</span> init","source":"npm init"}},{"type":"text","value":" writes, and so do the\nTypeScript files it imports."}]},{"type":"paragraph","children":[{"type":"text","value":"Node.js loads the file as it is, without a bundler, and so its imports: a relative\nimport in the configuration, or in a module it imports, needs its extension\n("},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"./states.<span class=\"th-token th-property\">ts</span>","source":"./states.ts"}},{"type":"text","value":", not "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"./states","source":"./states"}},{"type":"text","value":"). When the file fails to load, the command says which\nfile and which module it could not find, and exits with 2."}]},{"type":"heading","depth":3,"id":"in-a-workspace","children":[{"type":"text","value":"In a workspace"}]},{"type":"paragraph","children":[{"type":"text","value":"The CLI's "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"check","source":"check"}},{"type":"text","value":", "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"trace","source":"trace"}},{"type":"text","value":" and "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"export","source":"export"}},{"type":"text","value":" read, for each path you give them, the\nnearest configuration file above it, as TypeScript finds its own configuration. Run from\nthe workspace root, they check each app with the app's own configuration. A path\nwith no configuration above it reads the working directory's, and a "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-variable\">--config</span>","source":"--config"}},{"type":"text","value":"\noption makes every path read one file. See\n"},{"type":"link","href":"/docs/tooling/cli#which-configuration","children":[{"type":"text","value":"the CLI"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"what-overrides-what","children":[{"type":"text","value":"What overrides what"}]},{"type":"paragraph","children":[{"type":"text","value":"Options passed to the adapter override the file, key by key:"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"kirana({ config: { names: { prefix: \"app\" } } })","lang":"ts","html":"<span class=\"th-token th-function\">kirana</span>({ <span class=\"th-token th-property\">config</span>: { <span class=\"th-token th-property\">names</span>: { <span class=\"th-token th-property\">prefix</span>: <span class=\"th-token th-string\">&quot;app&quot;</span> } } })","file":"vite.config.ts","title":"vite.config.ts"}},{"type":"paragraph","children":[{"type":"text","value":"The project root comes from the adapter (Vite's "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"root","source":"root"}},{"type":"text","value":"; for the CLI, the directory\nof the configuration a path reads, or the working directory) and cannot be set in\nthe file."}]},{"type":"heading","depth":2,"id":"unknown-keys-are-errors","children":[{"type":"text","value":"Unknown keys are errors"}]},{"type":"paragraph","children":[{"type":"text","value":"The validator rejects keys it does not know ("},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"invalid-config","source":"invalid-config"}},{"type":"text","value":"), rather than\nignoring them. A typo fails the build instead of silently doing nothing, and a\nkey from a future version fails loudly rather than pretending to work."}]},{"type":"heading","depth":2,"id":"sharing-configuration","children":[{"type":"text","value":"Sharing configuration"}]},{"type":"paragraph","children":[{"type":"text","value":"A configuration is a plain object, so a shared one is a plain export:"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"export const uiConfig = {\n  conditions: {\n    exclusive: [[\"[data-starting-style]\", \"[data-ending-style]\"]],\n  },\n} satisfies KiranaConfig","lang":"ts","html":"<span class=\"th-token th-keyword\">export</span> <span class=\"th-token th-keyword\">const</span> uiConfig = {\n  <span class=\"th-token th-property\">conditions</span>: {\n    <span class=\"th-token th-property\">exclusive</span>: [[<span class=\"th-token th-string\">&quot;[data-starting-style]&quot;</span>, <span class=\"th-token th-string\">&quot;[data-ending-style]&quot;</span>]],\n  },\n} <span class=\"th-token th-keyword\">satisfies</span> <span class=\"th-token th-type\">KiranaConfig</span>","file":"packages/ui/src/kirana.ts","title":"packages/ui/src/kirana.ts"}},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"export default defineConfig({ ...uiConfig, layers: { before: [\"reset\"] } })","lang":"ts","html":"<span class=\"th-token th-keyword\">export</span> <span class=\"th-token th-keyword\">default</span> <span class=\"th-token th-function\">defineConfig</span>({ ...uiConfig, <span class=\"th-token th-property\">layers</span>: { <span class=\"th-token th-property\">before</span>: [<span class=\"th-token th-string\">&quot;reset&quot;</span>] } })","file":"apps/web/kirana.config.ts","title":"apps/web/kirana.config.ts"}},{"type":"paragraph","children":[{"type":"text","value":"That is how a component library tells every app what its attributes guarantee;\nsee "},{"type":"link","href":"/docs/reference/config","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"conditions.<span class=\"th-token th-property\">exclusive</span>","source":"conditions.exclusive"}}]},{"type":"text","value":"."}]}],"headings":[{"id":"the-configuration-file","text":"The configuration file","level":1},{"id":"how-it-is-found","text":"How it is found","level":2},{"id":"in-a-workspace","text":"In a workspace","level":3},{"id":"what-overrides-what","text":"What overrides what","level":2},{"id":"unknown-keys-are-errors","text":"Unknown keys are errors","level":2},{"id":"sharing-configuration","text":"Sharing configuration","level":2}]}
