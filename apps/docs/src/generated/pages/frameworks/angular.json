class=\"card\"\n    [sx]=\"[styles.card, wide() && styles.wide]\"\n  ></div>`,\n})\nexport class Card {\n  readonly wide = input(false)\n  protected readonly styles = styles\n}","lang":"ts","html":"<span class=\"th-token th-keyword\">import</span> { <span class=\"th-token th-type\">Component</span>, input } <span class=\"th-token th-keyword\">from</span> <span class=\"th-token th-string\">&quot;@angular/core&quot;</span>\n<span class=\"th-token th-keyword\">import</span> { <span class=\"th-token th-type\">SxDirective</span> } <span class=\"th-token th-keyword\">from</span> <span class=\"th-token th-string\">&quot;@kirana-style/angular&quot;</span>\n<span class=\"th-token th-keyword\">import</span> { css } <span class=\"th-token th-keyword\">from</span> <span class=\"th-token th-string\">&quot;@kirana-style/core&quot;</span>\n\n<span class=\"th-token th-keyword\">const</span> styles = {\n  <span class=\"th-token th-property\">card</span>: <span class=\"th-token th-function\">css</span>({ <span class=\"th-token th-property\">padding</span>: <span class=\"th-token th-string\">&quot;1rem&quot;</span>, <span class=\"th-token th-property\">borderRadius</span>: <span class=\"th-token th-string\">&quot;0.5rem&quot;</span> }),\n  <span class=\"th-token th-property\">wide</span>: <span class=\"th-token th-function\">css</span>({ <span class=\"th-token th-property\">width</span>: <span class=\"th-token th-string\">&quot;100%&quot;</span> }),\n}\n\n<span class=\"th-token th-function\">@Component</span>({\n  <span class=\"th-token th-property\">selector</span>: <span class=\"th-token th-string\">&quot;app-card&quot;</span>,\n  <span class=\"th-token th-property\">imports</span>: [<span class=\"th-token th-type\">SxDirective</span>],\n  <span class=\"th-token th-property\">template</span>: <span class=\"th-token th-string\">`&lt;div\n    class=&quot;card&quot;\n    [sx]=&quot;[styles.card, wide() &amp;&amp; styles.wide]&quot;\n  &gt;&lt;/div&gt;`</span>,\n})\n<span class=\"th-tok