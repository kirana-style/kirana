en th-literal\">false</span>,\n    <span class=\"th-token th-property\">hmr</span>: host ? { <span class=\"th-token th-property\">protocol</span>: <span class=\"th-token th-string\">&quot;ws&quot;</span>, host, <span class=\"th-token th-property\">port</span>: <span class=\"th-token th-number\">1421</span> } : <span class=\"th-token th-literal\">undefined</span>,\n    <span class=\"th-token th-property\">watch</span>: { <span class=\"th-token th-property\">ignored</span>: [<span class=\"th-token th-string\">&quot;**/src-tauri/**&quot;</span>] },\n  },\n})","file":"vite.config.ts","title":"vite.config.ts"}},{"type":"heading","depth":2,"id":"3-type-sx","children":[{"type":"text","value":"3. Type "},{"type":"inlineCode","value":"sx"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"{\n  \"compilerOptions\": {\n    \"types\": [\"@kirana-style/core/react\", \"vite/client\"]\n  }\n}","lang":"json","html":"{\n  <span class=\"th-token th-property\">&quot;compilerOptions&quot;</span>: {\n    <span class=\"th-token th-property\">&quot;types&quot;</span>: [<span class=\"th-token th-string\">&quot;@kirana-style/core/react&quot;</span>, <span class=\"th-token th-string\">&quot;vite/client&quot;</span>]\n  }\n}","file":"tsconfig.json","title":"tsconfig.json"}},{"type":"heading","depth":2,"id":"4-import-the-stylesheet","children":[{"type":"text","value":"4. Import the stylesheet"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"import \"@kirana-style/core/stylesheet.css\"","lang":"ts","html":"<span class=\"th-token th-keyword\">import</span> <span class=\"th-token th-string\">&quot;@kirana-style/core/stylesheet.css&quot;</span>","file":"src/main.tsx","title":"src/main.tsx"}},{"type":"heading","depth":2,"id":"5-write-a-component","children":[{"type":"text","value":"5. Write a component"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"c