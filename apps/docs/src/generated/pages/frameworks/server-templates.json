{"type":"root","children":[{"type":"heading","depth":1,"id":"server-templates","children":[{"type":"text","value":"Server templates"}]},{"type":"paragraph","children":[{"type":"text","value":"A server-rendered template cannot call "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-function\">css</span>()","source":"css()"}},{"type":"text","value":". So a server app keeps its styles\nin TypeScript modules, Kirana's CLI compiles them, and the templates name them."}]},{"type":"component","name":"guides","attributes":{"group":"server"},"children":[]},{"type":"heading","depth":2,"id":"how-it-works","children":[{"type":"text","value":"How it works"}]},{"type":"list","ordered":true,"start":1,"loose":true,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"You write styles in modules"}]},{"type":"text","value":" listed under "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"classes.<span class=\"th-token th-property\">modules</span>","source":"classes.modules"}},{"type":"text","value":" in\n"},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"kirana.<span class=\"th-token th-property\">config</span>","source":"kirana.config"}},{"type":"text","value":". Each exported handle, and each handle inside an exported\nobject, is a style a template can name:"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"import { css } from \"@kirana-style/core\"\n\nexport const card = css({ padding: \"1rem\", borderRadius: \"0.5rem\" })\nexport const button = {\n  base: css({ paddingInline: \"1rem\" }),\n  primary: css({ backgroundColor: \"black\", color: \"white\" }),\n}","lang":"ts","html":"<span class=\"th-token th-keyword\">import</span> { css } <span class=\"th-token th-keyword\">from</span> <span class=\"th-token th-string\">&quot;@kirana-style/core&quot;</span>\n\n<span class=\"th-token th-keyword\">export</span> <span class=\"th-token th-keyword\">const</span> card = <span class=\"th-token th-function\">css</span>({ <span class=\"th-token th-property\">padding</span>: <span class=\"th-token th-string\">&quot;1rem&quot;</span>, <span class=\"th-token th-property\">borderRadius</span>: <span class=\"th-token th-string\">&quot;0.5rem&quot;</span> })\n<span class=\"th-token th-keyword\">export</span> <span class=\"th-token th-keyword\">const</span> button = {\n  <span class=\"th-token th-property\">base</span>: <span class=\"th-token th-function\">css</span>({ <span class=\"th-token th-property\">paddingInline</span>: <span class=\"th-token th-string\">&quot;1rem&quot;</span> }),\n  <span class=\"th-token th-property\">primary</span>: <span class=\"th-token th-function\">css</span>({ <span class=\"th-token th-property\">backgroundColor</span>: <span class=\"th-token th-string\">&quot;black&quot;</span>, <span class=\"th-token th-property\">color</span>: <span class=\"th-token th-string\">&quot;white&quot;</span> }),\n}","file":"resources/styles/app.styles.ts","title":"resources/styles/app.styles.ts"}}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"The CLI writes two files"}]},{"type":"text","value":": the stylesheet, and a class map of every name\nwith the classes it compiles to:"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"import { defineConfig } from \"@kirana-style/core/config\"\n\nexport default defineConfig({\n  classes: {\n    modules: [\"resources/styles\"],\n    out: \"public/kirana/classes.json\",\n  },\n})","lang":"ts","html":"<span class=\"th-token th-keyword\">import</span> { defineConfig } <span class=\"th-token th-keyword\">from</span> <span class=\"th-token th-string\">&quot;@kirana-style/core/config&quot;</span>\n\n<span class=\"th-token th-keyword\">export</span> <span class=\"th-token th-keyword\">default</span> <span class=\"th-token th-function\">defineConfig</span>({\n  <span class=\"th-token th-property\">classes</span>: {\n    <span class=\"th-token th-property\">modules</span>: [<span class=\"th-token th-string\">&quot;resources/styles&quot;</span>],\n    <span class=\"th-token th-property\">out</span>: <span class=\"th-token th-string\">&quot;public/kirana/classes.json&quot;</span>,\n  },\n})","file":"kirana.config.ts","title":"kirana.config.ts"}},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"npx kirana-style dev resources/styles --out public/kirana/kirana.css","lang":"bash","html":"<span class=\"th-token th-prompt\">$</span> <span class=\"th-token th-command\">npx</span> kirana-style dev resources/styles <span class=\"th-token th-attr\">--out</span> public/kirana/kirana.css","variant":"terminal"}},{"type":"paragraph","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-command\">kirana-style</span> dev","source":"kirana-style dev"}},{"type":"text","value":" rewrites both on every edit; "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-command\">kirana-style</span> build <span class=\"th-token th-attr\">--minify</span>","source":"kirana-style build --minify"}},{"type":"text","value":" writes them\nonce, for production."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"A template names styles"}]},{"type":"text","value":" through its language's helper, which reads the\nclass map and merges the names, later ones winning, as an "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"sx","source":"sx"}},{"type":"text","value":" list does:"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"<button class=\"@kirana('button.base', 'button.primary')\">Save</button>","lang":"html","html":"&lt;button class=&quot;@kirana(&#39;button.base&#39;, &#39;button.primary&#39;)&quot;&gt;Save&lt;/button&gt;"}}]}]},{"type":"heading","depth":2,"id":"merging-without-a-runtime","children":[{"type":"text","value":"Merging without a runtime"}]},{"type":"paragraph","children":[{"type":"text","value":"Kirana's class names carry their own merge rules: everything before the final "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"_","source":"_"}},{"type":"text","value":"\nsays which property, target and conditions a class sets, so the last class for a\nkey wins. The helpers in PHP, Ruby and Elixir implement those rules in a few dozen\nlines, and each passes the same 400 merge cases as the JavaScript runtime, on every\nchange. Nothing about a style is decided in the template."}]},{"type":"heading","depth":2,"id":"limits","children":[{"type":"text","value":"Limits"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Only styles known at build time."}]},{"type":"text","value":" A recipe, an array, or a value from a\nvariable has no class string a template can use; the build reports it as\n"},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"classes-not-static","source":"classes-not-static"}},{"type":"text","value":". Pick between variants in the template instead:\n"},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-function\">kirana</span>(<span class=\"th-token th-string\">&#39;button.base&#39;</span>, $primary ? <span class=\"th-token th-string\">&#39;button.primary&#39;</span> : <span class=\"th-token th-literal\">null</span>)","source":"kirana('button.base', $primary ? 'button.primary' : null)"}},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"An unknown name fails loudly"}]},{"type":"text","value":": at runtime in the helper, and in the editor,\nwhere the "},{"type":"link","href":"/docs/tooling/editor","children":[{"type":"text","value":"language server"}]},{"type":"text","value":" underlines it\n("},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"unknown-class-name","source":"unknown-class-name"}},{"type":"text","value":") and hovers a known one with its styles."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"The stylesheet holds every style the modules export"}]},{"type":"text","value":", used or not: no\ntemplate is read at build time."}]}]}]}],"headings":[{"id":"server-templates","text":"Server templates","level":1},{"id":"how-it-works","text":"How it works","level":2},{"id":"merging-without-a-runtime","text":"Merging without a runtime","level":2},{"id":"limits","text":"Limits","level":2}]}
