x/node server.ts\",\n    \"start\": \"node --import remix/node-tsx --import @kirana-style/remix/node server.ts\"\n  }\n}","lang":"json","html":"{\n  <span class=\"th-token th-property\">&quot;scripts&quot;</span>: {\n    <span class=\"th-token th-property\">&quot;dev&quot;</span>: <span class=\"th-token th-string\">&quot;node --watch --import remix/node-tsx --import @kirana-style/remix/node server.ts&quot;</span>,\n    <span class=\"th-token th-property\">&quot;start&quot;</span>: <span class=\"th-token th-string\">&quot;node --import remix/node-tsx --import @kirana-style/remix/node server.ts&quot;</span>\n  }\n}","file":"package.json","title":"package.json"}},{"type":"paragraph","children":[{"type":"text","value":"Node runs the hook registered last first, so Kirana's hook asks "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"node-tsx","source":"node-tsx"}},{"type":"text","value":" for the\ncompiled module and compiles its styles."}]},{"type":"heading","depth":2,"id":"3-serve-the-stylesheet","children":[{"type":"text","value":"3. Serve the stylesheet"}]},{"type":"paragraph","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-function\">stylesheet</span>()","source":"stylesheet()"}},{"type":"text","value":" answers "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"/kirana.<span class=\"th-token th-property\">css</span>","source":"/kirana.css"}},{"type":"text","value":" from the server's compiler session:"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"import { stylesheet } from \"@kirana-style/remix\"\n\nexport const router = createRouter({\n  middleware: [stylesheet(), staticFiles(\"./public\"), renderMiddleware],\n})","lang":"ts","html"