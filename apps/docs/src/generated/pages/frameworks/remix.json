et({ path, minify })"}},{"type":"text","value":"\nchanges either."}]},{"type":"heading","depth":2,"id":"4-compile-client-entries","children":[{"type":"text","value":"4. Compile client entries"}]},{"type":"paragraph","children":[{"type":"text","value":"Client entries reach the browser through the asset server. Add Kirana's loader to\nits scripts, and allow "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"@kirana-style/core","source":"@kirana-style/core"}},{"type":"text","value":", whose runtime a compiled module may\nimport:"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"import { kiranaLoader } from \"@kirana-style/remix\"\n\nexport const assets = createAssetServer({\n  allowPackages: [\"remix\", \"@kirana-style/core\"],\n  scripts: { loaders: [kiranaLoader] },\n})","lang":"ts","html":"<span class=\"th-token th-keyword\">import</span> { kiranaLoader } <span class=\"th-token th-keyword\">from</span> <span class=\"th-token th-string\">&quot;@kirana-style/remix&quot;</span>\n\n<span class=\"th-token th-keyword\">export</span> <span class=\"th-token th-keyword\">const</span> assets = <span class=\"th-token th-function\">createAssetServer</span>({\n  <span class=\"th-token th-property\">allowPackages</span>: [<span class=\"th-token th-string\">&quot;remix&quot;</span>, <span class=\"th-token th-string\">&quot;@kirana-style/core&quot;</span>],\n  <span class=\"th-token th-property\">scripts</span>: { <span class=\"th-token th-property\">loaders</span>: [kiranaLoader] },\n})","file":"app/assets.ts","title":"app/assets.ts"}},{"type":"heading","depth":2,"id":"5-type-sx","children":[{"type":"text","value":"5. Type "},{"type":"inlineCode","value":"sx"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"{\n  \"compilerOptions\": { \"types\": [\"node\", \"@kirana-style/core/remix\"] }\n}","lang":"json","html":"{\n  <span class=\"th-token th-property\">&quot;compilerOptions&quot;</span>: { <span class=\"th-token th-property\">&quot;types&quot;</span>: [<span class=\"th-token th-string\">&quot;node&quot;</span>, <span class=\"th-token th-string\">&quot;@kirana-style/core/remix&quot;</span>] }\n}","file":"tsconfig.json","title":"tsconfig.json"}},{"type":"heading","depth":2,"id":"6-write-a-component","children":[{"type":"text","value":"6. Write a component"}]},{"type":"paragraph","children":[{"type":"text","value":"A server-rendered component and a client entry style themselves the same way:"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"import { css } from \"@kirana-style/core\"\nimport { clientEntry } from \"remix/component\"\n\nconst styles = {\n  notice: css({\n    paddingInline: \"1rem\",\n    color: { base: \"black\", \":hover\": \"blue\" },\n  }),\n}\n\nexport const Notice = clientEntry(import.meta.url, function Notice() {\n  return () => <p sx={styles.notice}>Hello</p>\n})","lang":"tsx","html":"<span class=\"th-token th-keyword\">import</span> { css } <span class=\"th-token th-keyword\">from</span> <span class=\"th-token th-string\">&quot;@kirana-style/core&quot;</span>\n<span class=\"th-token th-keyword\">import</span> { clientEntry } <span class=\"th-token th-keyword\">from</span> <span class=\"th-token th-string\">&quot;remix/component&quot;</span>\n\n<span class=\"th-token th-keyword\">const</span> styles = {\n  <span class=\"th-token th-property\">notice</span>: <span class=\"th-token th-function\">css</span>({\n    <span class=\"th-token th-property\">paddingInline</span>: <span class=\"th-token th-string\">&quot;1rem&quot;</span>,\n    <span class=\"th-token th-property\">color</span>: { <span class=\"th-token th-property\">base</span>: <span class=\"th-token th-string\">&quot;black&quot;</span>, <span class=\"th-token th-string\">&quot;:hover&quot;</span>: <span class=\"th-token th-string\">&quot;blue&quot;</span> },\n  }),\n}\n\n<span class=\"th-token th-keyword\">export</span> <span class=\"th-token th-keyword\">const</span> <span class=\"th-token th-type\">Notice</span> = <span class=\"th-token th-function\">clientEntry</span>(<span class=\"th-token th-keyword\">import</span>.<span class=\"th-token th-property\">meta</span>.<span class=\"th-token th-property\">url</span>, <span class=\"th-token th-keyword\">function</span> <span class=\"th-token th-function\">Notice</span>() {\n  <span class=\"th-token th-keyword\">return</span> () =&gt; &lt;<span class=\"th-token th-tag\">p</span> <span class=\"th-token th-attr\">sx</span>={styles.<span class=\"th-token th-property\">notice</span>}&gt;Hello&lt;/<span class=\"th-token th-tag\">p</span>&gt;\n})","file":"app/actions/public/notice.tsx","title":"app/actions/public/notice.tsx"}},{"type":"heading","depth":2,"id":"diagnostics","children":[{"type":"text","value":"Diagnostics"}]},{"type":"paragraph","children":[{"type":"text","value":"The hook and the loader see compiled JavaScript, so a diagnostic they print points\nat the compiled module. "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-command\">npx</span> kirana-style check app","source":"npx kirana-style check app"}},{"type":"text","value":" reads your source and points\nat the line you wrote."}]},{"type":"heading","depth":2,"id":"next","children":[{"type":"text","value":"Next"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"/docs/start/first-component","children":[{"type":"text","value":"Your first component"}]},{"type":"text","value":": a button with a hover state\nand a variant, and the CSS it compiles to."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"/docs/styling/styles","children":[{"type":"t