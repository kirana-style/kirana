{"type":"root","children":[{"type":"heading","depth":1,"id":"remix","children":[{"type":"text","value":"Remix"}]},{"type":"paragraph","children":[{"type":"text","value":"Remix 3 has no bundler. "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"node-tsx","source":"node-tsx"}},{"type":"text","value":" compiles TypeScript and JSX as Node loads the\nserver, and the asset server compiles client entries as the browser asks for\nthem. Both hand on only the JavaScript that comes out, so Kirana compiles after\nthem, on the compiled JSX calls: "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"sx","source":"sx"}},{"type":"text","value":" becomes "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"className","source":"className"}},{"type":"text","value":" in the server render and\nin the browser alike. The server's compiler session has seen every module, client\nentries included, and serves the stylesheet. Tested on every change by\n"},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"examples/remix","source":"examples/remix"}},{"type":"text","value":", on its server and its dev server."}]},{"type":"paragraph","children":[{"type":"text","value":"This page is about Remix 3. A Remix 2 app is a "},{"type":"link","href":"/docs/frameworks/react-router","children":[{"type":"text","value":"React Router"}]},{"type":"text","value":"\napp now; follow that guide."}]},{"type":"component","name":"npm-status","attributes":{},"children":[]},{"type":"heading","depth":2,"id":"the-fast-way","children":[{"type":"text","value":"The fast way"}]},{"type":"paragraph","children":[{"type":"text","value":"In the project's root:"}]},{"type":"component","name":"code","tagName":"md-code","attributes":