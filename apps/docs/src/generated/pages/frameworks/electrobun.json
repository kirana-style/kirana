{"type":"root","children":[{"type":"heading","depth":1,"id":"electrobun","children":[{"type":"text","value":"Electrobun"}]},{"type":"paragraph","children":[{"type":"text","value":"An Electrobun app runs its main process on Bun and shows its views in a webview.\nIts Vite templates build each view with Vite, and its config copies the output\ninto the app, so Kirana's Vite plugin goes in that build. Tested by\n"},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"examples/electrobun","source":"examples/electrobun"}},{"type":"text","value":", whose view is built and checked in Chromium."}]},{"type":"component","name":"npm-status","attributes":{},"children":[]},{"type":"heading","depth":2,"id":"1-install","children":[{"type":"text","value":"1. Install"}]},{"type":"component","name":"install","attributes":{"packages":"@kirana-style/core","dev":"@kirana-style/vite"},"children":[]},{"type":"heading","depth":2,"id":"2-add-the-plugin","children":[{"type":"text","value":"2. Add the plugin"}]},{"type":"paragraph","children":[{"type":"text","value":"Add Kirana first in the template's "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"vite.config.ts","source":"vite.config.ts"}},{"type":"text","value":", and keep the rest of it: the\nview's root, the output Electrobun copies, the port its HMR mode loads and the\nalias to Electrobun's view API:"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"import { resolve } from \"node:path\"\n\nimport kirana from \"@kirana-style/vite\"\nimport react from \"@vitejs/plugin-react\"\nimport { defineConfig } from \"vite\"\n\nimport { electrobunViteAliases } from \"./.hutch/devkit/api/config/electrobun-vite\"\n\nexport default defineConfig({\n  plugins: [kirana(), react()],\n  resolve: {\n    alias: electrobunViteAliases(resolve(__dirname, \".hutch/devkit\")),\n  },\n  root: \"src/mainview\",\n  build: { outDir: \"../../dist\", emptyOutDir: true },\n  server: { port: 5173, strictPort: true },\n})","lang":"ts","html":"<span class=\"th-token th-keyword\">import</span> { resolve } <span class=\"th-token th-keyword\">from</span> <span class=\"th-token th-string\">&quot;node:path&quot;</span>\n\n<span class=\"th-token th-keyword\">import</span> kirana <span class=\"th-token th-keyword\">from</span> <span class=\"th-token th-string\">&quot;@kirana-style/vite&quot;</span>\n<span class=\"th-token th-keyword\">import</span> react <span class=\"th-token th-keyword\">from</span> <span class=\"th-token th-string\">&quot;@vitejs/plugin-react&quot;</span>\n<span class=\"th-token th-keyword\">import</span> { defineConfig } <span class=\"th-token th-keyword\">from</span> <span class=\"th-token th-string\">&quot;vite&quot;</span>\n\n<span class=\"th-token th-keyword\">import</span> { electrobunViteAliases } <span class=\"th-token th-keyword\">from</span> <span class=\"th-token th-string\">&quot;./.hutch/devkit/api/config/electrobun-vite&quot;</span>\n\n<span class=\"th-token th-keyword\">export</span> <span class=\"th-token th-keyword\">default</span> <span class=\"th-token th-function\">defineConfig</span>({\n  <span class=\"th-token th-property\">plugins</span>: [<span class=\"th-token th-function\">kirana</span>(), <span class=\"th-token th-function\">react</span>()],\n  <span class=\"th-token th-property\">resolve</span>: {\n    <span class=\"th-token th-property\">alias</span>: <span class=\"th-token th-function\">electrobunViteAliases</span>(<span class=\"th-token th-function\">resolve</span>(__dirname, <span class=\"th-token th-string\">&quot;.hutch/devkit&quot;</span>)),\n  },\n  <span class=\"th-token th-property\">root</span>: <span class=\"th-token th-string\">&quot;src/mainview&quot;</span>,\n  <span class=\"th-token th-property\">build</span>: { <span class=\"th-token th-property\">outDir</span>: <span