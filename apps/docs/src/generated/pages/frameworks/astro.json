o","html":"---\nimport { css } from &quot;@kirana-style/core&quot;\n\nconst { wide } = Astro.props\nconst card = css({ padding: &quot;1rem&quot;, borderRadius: &quot;0.5rem&quot; })\nconst full = css({ width: &quot;100%&quot; })\n---\n\n&lt;div class=&quot;card&quot; sx={[card, wide &amp;&amp; full]}&gt;\n  &lt;slot /&gt;\n&lt;/div&gt;","file":"src/components/Card.astro","title":"src/components/Card.astro"}},{"type":"paragraph","children":[{"type":"text","value":"The element's own "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"class","source":"class"}},{"type":"text","value":" and "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"style","source":"style"}},{"type":"text","value":" are merged into what "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"sx","source":"sx"}},{"type":"text","value":" produces. Islands\nwritten in React, Preact, Solid, Vue or Svelte go through the same integration and\nfollow their own guides for "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"sx","source":"sx"}},{"type":"text","value":" (islands are not in the test matrix yet)."}]},{"type":"heading","depth":2,"id":"how-it-compiles","children":[{"type":"text","value":"How it compiles"}]},{"type":"paragraph","children":[{"type":"text","value":"The frontmatter compiles like any module, and each "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"sx","source":"sx"}},{"type":"text","value":" becomes a spread of a call\nto Kirana's small runtime, evaluated when the page renders, which is at build time\nfor a static page. Keep "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-function\">css</span>()","source":"css()"}},{"type":"text","value":" calls in the frontmatter: one written inside the markup\nis not compiled, and says so when it runs."}]},{"type":"heading","depth":2,"id":"next","children":[{"type":"text","value":"Next"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"/docs/start/first-component","children":[{"type":"text","value":"Your first component"}]},{"type":"text","value":": a button with a hover state\nand a variant, and the CSS it compiles to."}]}]}]}],"headings":[{"id":"astro","text":"Astro","level":1},{"id":"1-install","text":"1. Install","level":2},{"id":"2-add-the-integration","text":"2. Add the integration","level":2},{"id":"3-import-the-stylesheet","text":"3. Import the stylesheet","level":2},{"id":"4-type-sx","text":"4. Type sx","level":2},{"id":"5-write-a-component","text":"5. Write a component","level":2},{"id":"how-it-compiles","text":"How it compiles","level":2},{"id":"next","text":"Next","level":2}]}
