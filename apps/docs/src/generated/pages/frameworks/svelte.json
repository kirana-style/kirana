t","value":":"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"/// <reference types=\"@kirana-style/core/svelte\" />","lang":"ts","html":"<span class=\"th-token th-comment\">/// &lt;reference types=&quot;@kirana-style/core/svelte&quot; /&gt;</span>","file":"src/env.d.ts","title":"src/env.d.ts"}},{"type":"heading","depth":2,"id":"5-write-a-component","children":[{"type":"text","value":"5. Write a component"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"<script lang=\"ts\">\n  import { css } from \"@kirana-style/core\"\n\n  let { wide, children } = $props()\n\n  const card = css({ padding: \"1rem\", borderRadius: \"0.5rem\" })\n  const full = css({ width: \"100%\" })\n</script>\n\n<div class=\"card\" sx={[card, wide && full]}>\n  {@render children?.()}\n</div>","lang":"svelte","html":"&lt;script lang=&quot;ts&quot;&gt;\n  import { css } from &quot;@kirana-style/core&quot;\n\n  let { wide, children } = $props()\n\n  const card = css({ padding: &quot;1rem&quot;, borderRadius: &quot;0.5rem&quot; })\n  const full = css({ width: &quot;100%&quot; })\n&lt;/script&gt;\n\n&lt;div class=&quot;card&quot; sx={[card, wide &amp;&amp; full]}&gt;\n  {@render children?.()}\n&lt;/div&gt;","file":"src/Card.svelte","title":"src/Card.svelte"}},{"type":"paragraph","children":[{"type":"text","value":"The element's own "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"class","source":"class"}},{"type":"text","value":" and "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"style","source":"style"}},{"type":"text","value":" are merged into what "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"sx","source":"sx"}},{"type":"text","value":