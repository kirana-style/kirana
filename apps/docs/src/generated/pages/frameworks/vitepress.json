{"type":"root","children":[{"type":"heading","depth":1,"id":"vitepress","children":[{"type":"text","value":"VitePress"}]},{"type":"paragraph","children":[{"type":"text","value":"VitePress builds with Vite, and takes Vite plugins under "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"vite","source":"vite"}},{"type":"text","value":" in\n"},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":".<span class=\"th-token th-property\">vitepress</span>/config","source":".vitepress/config"}},{"type":"text","value":". Kirana compiles your theme's components and the components\npages use, written with "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":":sx","source":":sx"}},{"type":"text","value":" as in any "},{"type":"link","href":"/docs/frameworks/vue","children":[{"type":"text","value":"Vue"}]},{"type":"text","value":" component.\nOne thing is particular to it: the default theme's CSS. Tested on every change\nby "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"examples/vitepress","source":"examples/vitepress"}},{"type":"text","value":", built and on its dev server, on VitePress 2."}]},{"type":"component","name":"npm-status","attributes":{},"children":[]},{"type":"paragraph","children":[{"type":"text","value":"VitePress 2 builds on Vite 8, which Kirana's plugin needs. VitePress 1 is on\nVite 5 and is not supported."}]},{"type":"heading","depth":2,"id":"the-fast-way","children":[{"type":"text","value":"The fast way"}]},{"type":"paragraph","children":[{"type":"text","value":"In the project's root:"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"npx kirana-style@latest init","lang":"bash","html":"<span class=\"th-token th-prompt\">$</span> <span class=\"th-token th-command\">npx</span> kirana-style@latest init","variant":"terminal"}},{"type":"paragraph","children":[{"type":"text","value":"It finds the source directory ("},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"docs/","source":"docs/"}},{"type":"text","value":", or the root), shows every change below\nas a diff, and writes them once you say yes. Then "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-command\">npx</span> kirana-style doctor","source":"npx kirana-style doctor"}},{"type":"text","value":"\nchecks the result."}]},{"type":"heading","depth":2,"id":"1-install","children":[{"type":"text","value":"1. Install"}]},{"type":"component","name":"install","attributes":{"packages":"@kirana-style/core","dev":"@kirana-style/vite"},"children":[]},{"type":"heading","depth":2,"id":"2-add-the-plugin-and-layer-the-theme","children":[{"type":"text","value":"2. Add the plugin, and layer the theme"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"import kirana, { cssLayer } from \"@kirana-style/vite\"\nimport { defineConfig } from \"vitepress\"\n\nexport default defineConfig({\n  vite: {\n    plugins: [\n      kirana(),\n      cssLayer(\"vitepress\", \"vitepress/dist/client/theme-default/\"),\n    ],\n  },\n})","lang":"ts","html":"<span class=\"th-token th-keyword\">import</span> kirana, { cssLayer } <span class=\"th-token th-keyword\">from</span> <span class=\"th-token th-string\">&quot;@kirana-style/vite&quot;</span>\n<span class=\"th-token th-keyword\">import</span> { defineConfig } <span class=\"th-token th-keyword\">from</span> <span class=\"th-token th-string\">&quot;vitepress&quot;</span>\n\n<span class=\"th-token th-keyword\">export</span> <span class=\"th-token th-keyword\">default</span> <span class=\"th-token th-function\">defineConfig</span>({\n  <span class=\"th-token th-property\">vite</span>: {\n    <span class=\"th-token th-property\">plugins</span>: [\n      <span class=\"th-token th-function\">kirana</span>(),\n      <span class=\"th-token th-function\">cssLayer</span>(<span class=\"th-token th-string\">&quot;vitepress&quot;</span>, <span class=\"th-token th-string\">&quot;vitepress/dist/client/theme-default/&quot;</span>),\n    ],\n  },\n})","file":"docs/.vitepress/config.ts","title":"docs/.vitepress/config.ts"}},{"type":"paragraph","children":[{"type":"text","value":"Most of the default theme's CSS is unlayered, and its reset\n("},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"* { <span class=\"th-token th-property\">padding</span>: <span class=\"th-token th-number\">0</span> }","source":"* { padding: 0 }"}},{"type":"text","value":") sits in a layer declared after Kirana's. Either one beats\nevery style you write with "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-function\">css</span>()","source":"css()"}},{"type":"text","value":", whatever its selector: an unlayered rule\noutranks all layered ones. "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"cssLayer","source":"cssLayer"}},{"type":"text","value":" puts the theme's stylesheets in a\n"},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"vitepress","source":"vitepress"}},{"type":"text","value":" layer as Vite loads them, and the configuration orders it before\nKirana's ("},{"type":"link","href":"/docs/config/layers","children":[{"type":"text","value":"layers"}]},{"type":"text","value":")."}]},{"type":"heading","depth":2,"id":"3-order-the-layer","children":[{"type":"text","value":"3. Order the layer"}]},{"type":"paragraph","children":[{"type":"text","value":"Kirana reads its configuration from Vite's root, which VitePress makes its\nsource directory, so the file goes beside "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":".<span class=\"th-token th-property\">vitepress</span>","source":".vitepress"}},{"type":"text","value":":"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"import { defineConfig } from \"@kirana-style/core/config\"\n\nexport default defineConfig({ layers: { before: [\"vitepress\"] } })","lang":"ts","html":"<span class=\"th-token th-keyword\">import</span> { defineConfig } <span class=\"th-token th-keyword\">from</span> <span class=\"th-token th-string\">&quot;@kirana-style/core/config&quot;</span>\n\n<span class=\"th-token th-keyword\">export</span> <span class=\"th-token th-keyword\">default</span> <span class=\"th-token th-function\">defineConfig</span>({ <span class=\"th-token th-property\">layers</span>: { <span class=\"th-token th-property\">before</span>: [<span class=\"th-token th-string\">&quot;vitepress&quot;</span>] } })","file":"docs/kirana.config.ts","title":"docs/kirana.config.ts"}},{"type":"heading","depth":2,"id":"4-import-the-stylesheet","children":[{"type":"text","value":"4. Import the stylesheet"}]},{"type":"paragraph","children":[{"type":"text","value":"In the theme's entry, before the default theme's styles:"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"import \"@kirana-style/core/stylesheet.css\"\nimport DefaultTheme from \"vitepress/theme\"\n\nexport default DefaultTheme","lang":"ts","html":"<span class=\"th-token th-keyword\">import</span> <span class=\"th-token th-string\">&quot;@kirana-style/core/stylesheet.css&quot;</span>\n<span class=\"th-token th-k