"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"/docs/frameworks/nextjs","children":[{"type":"text","value":"Next.js"}]},{"type":"text","value":": the same app built by Turbopack or\nwebpack."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"/docs/frameworks/react","children":[{"type":"text","value":"React"}]},{"type":"text","value":": "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"sx","source":"sx"}},{"type":"text","value":" in React components."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"/docs/integrations/vite","children":[{"type":"text","value":"The Vite plugin"}]},{"type":"text","value":"."}]}]}]}],"headings":[{"id":"vinext","text":"vinext","level":1},{"id":"the-fast-way","text":"The fast way","level":2},{"id":"1-install","text":"1. Install","level":2},{"id":"2-add-the-plugin","text":"2. Add the plugin","level":2},{"id":"3-import-the-stylesheet","text":"3. Import the stylesheet","level":2},{"id":"4-type-sx","text":"4. Type sx","level":2},{"id":"5-write-a-page","text":"5. Write a page","level":2},{"id":"next","text":"Next","level":2}]}
