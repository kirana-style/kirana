{"type":"root","children":[{"type":"heading","depth":1,"id":"vinext","children":[{"type":"text","value":"vinext"}]},{"type":"paragraph","children":[{"type":"text","value":"vinext runs a Next.js app on Vite: the same routes, layouts and Next.js modules,\nbuilt by Vite instead of Next.js's own build. Kirana's Vite plugin compiles every\nroute before vinext's plugin does, so server components and client components\ncarry the same class names, in the server render and in the browser. Tested on\nevery change by "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"examples/vinext","source":"examples/vinext"}},{"type":"text","value":": built, served by "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"vinext start","source":"vinext start"}},{"type":"text","value":" and on its dev\nserver, with the Pages Router checked the same way."}]},{"type":"component","name":"npm-status","attributes":{},"children":[]},{"type":"heading","depth":2,"id":"the-fast-way","children":[{"type":"text","value":"The fast way"}]},{"type":"paragraph","children":[{"type":"text","value":"In the project's root:"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"npx kirana-style@latest init","lang":"bash","html":"<span class=\"th-token th-prompt\">$</span> <span class=\"th-token th-command\">npx</span> kirana-style@latest init","variant":"terminal"}},{"type":"paragraph","children":[{"type":"text","value":"It detects vinext ahead of the "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"next","source":"next"}},{"type":"text","value":" package a migrated app still lists, shows\nevery change below as a diff, writes them once you say yes, and prints the install\ncommand ("},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-attr\">--install</span>","source":"--install"}},{"type":"text","value":" runs it). Then "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-command\">npx</span> kirana-style doctor","source":"npx kirana-style doctor"}},{"type":"text","value":" checks the result."}]},{"type":"heading","depth":2,"id":"1-install","children":[{"type":"text","value":"1. Install"}]},{"type":"component","name":"install","attributes":{"packages":"@kirana-style/core","dev":"@kirana-style/vite"},"children":[]},{"type":"heading","depth":2,"id":"2-add-the-plugin","children":[{"type":"text","value":"2. Add the plugin"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"import kirana from \"@kirana-style/vite\"\nimport vinext from \"vinext\"\nimport { defineConfig } from \"vite\"\n\nexport default defineConfig({\n  plugins: [kirana(), vinext()],\n})","lang":"ts","html":"<span class=\"th-token th-keyword\">import</span> kirana <span class=\"th-token th-keyword\">from</span> <span class=\"th-token th-string\">&quot;@kirana-style/vite&quot;</span>\n<span class=\"th-token th-keyword\">import</span> vinext <span class=\"th-token th-keyword\">from</span> <span class=\"th-token th-string\">&quot;vinext&quot;</span>\n<span class=\"th-token th-keyword\">import</span> { defineConfig } <span class=\"th-token th-keyword\">from</span> <span class=\"th-token th-string\">&quot;vite&quot;</span>\n\n<span class=\"th-token th-keyword\">export</span> <span class=\"th-token th-keyword\">default</span> <span class=\"th-token th-function\">defineConfig</span>({\n  <span class=\"th-token th-property\">plugins</span>: [<span class=\"th-token th-function\">kirana</span>(), <span class=\"th-token th-function\">vinext</span>()],\n})","file":"vite.config.ts","title":"vite.config.ts"}},{"type":"paragraph","children":[{"type":"text","value":"Kirana goes first, so "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"app/","source":"app/"}},{"type":"text","value":" and "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"pages/","source":"pages/"}},{"type":"text","value":" reach vinext with "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"sx","source":"sx"}},{"type":"text","value":" already compiled."}]},{"type":"heading","depth":2,"id":"3-import-the-stylesheet","children":[{"type":"text","value":"3. Import the stylesheet"}]},{"type":"paragraph","children":[{"type":"text","value":"In the root layout, which wraps every page:"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"import \"@kirana-style/core/stylesheet.css\"","lang":"tsx","html":"<span class=\"th-token th-keyword\">import</span> <span class=\"th-token th-string\">&quot;@kirana-style/core/stylesheet.css&quot;</span>","file":"app/layout.tsx","title":"app/layout.tsx"}},{"type":"paragraph","children":[{"type":"text","value":"With the Pages Router, import it in "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"pages/_app.<span class=\"th-token th-property\">tsx</span>","source":"pages/_app.tsx"}},{"type":"text","value":" instead."}]},{"type":"heading","depth":2,"id":"4-type-sx","children":[{"type":"text","value":"4. Type "},{"type":"inlineCode","value":"sx"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"{\n  \"compilerOptions\": { \"types\": [\"vinext/types\", \"@kirana-style/core/react\"] }\n}","lang":"json","html":"{\n  <span class=\"th-tok