{"type":"root","children":[{"type":"heading","depth":1,"id":"waku","children":[{"type":"text","value":"Waku"}]},{"type":"paragraph","children":[{"type":"text","value":"Waku builds with Vite, and takes Vite plugins under "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"vite","source":"vite"}},{"type":"text","value":" in "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"waku.config.ts","source":"waku.config.ts"}},{"type":"text","value":".\nKirana compiles server components and client components alike, so a page\nrendered at build time ("},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-property\">render</span>: <span class=\"th-token th-string\">&quot;static&quot;</span>","source":"render: \"static\""}},{"type":"text","value":") has the class names in its HTML, and\nthe browser has the same ones. Tested on every change by "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"examples/waku","source":"examples/waku"}},{"type":"text","value":", built\nand on its dev server."}]},{"type":"component","name":"npm-status","attributes":{},"children":[]},{"type":"heading","depth":2,"id":"the-fast-way","children":[{"type":"text","value":"The fast way"}]},{"type":"paragraph","children":[{"type":"text","value":"In the project's root:"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"npx kirana-style@latest init","lang":"bash","html":"<span class=\"th-token th-prompt\">$</span> <span class=\"th-token th-command\">npx</span> kirana-style@latest init","variant":"terminal"}},{"type":"paragraph","children":[{"type":"text","value":"It detects the project, shows every change below as a diff, writes them once you\nsay yes, and prints the install command ("},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-attr\">--install</span>","source":"--install"}},{"type":"text","value":" runs it). Then\n"},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-command\">npx</span> kirana-style doctor","source":"npx kirana-style doctor"}},{"type":"text","value":" checks the result."}]},{"type":"heading","depth":2,"id":"1-install","children":[{"type":"text","value":"1. Install"}]},{"type":"component","name":"install","attributes":{"packages":"@kirana-style/core","dev":"@kirana-style/vite"},"children":[]},{"type":"heading","depth":2,"id":"2-add-the-plugin","children":[{"type":"text","value":"2. Add the plugin"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"import kirana from \"@kirana-style/vite\"\nimport { defineConfig } from \"waku/config\"\n\nexport default defineConfig({\n  vite: { plugins: [kirana()] },\n})","lang":"ts","html":"<span class=\"th-token th-keyword\">import</span> kirana <span class=\"th-token th-keyword\">from</span> <span class=\"th-token th-string\">&quot;@kirana-style/vite&quot;</span>\n<span class=\"th-token th-keyword\">import</span> { defineConfig } <span class=\"th-token th-keyword\">from</span> <span class=\"th-token th-string\">&quot;waku/config&quot;</span>\n\n<span class=\"th-token th-keyword\">export</span> <span class=\"th-token th-keyword\">default</span> <span class=\"th-token th-function\">defineConfig</span>({\n  <span class=\"th-token th-property\">vite</span>: { <span class=\"th-token th-property\">plugins</span>: [<span class=\"th-token th-function\">kirana</span>()] },\n})","file":"waku.config.ts","title":"waku.config.ts"}},{"type":"heading","depth":2,"id":"3-import-the-stylesheet","children":[{"type":"text","value":"3. Import the stylesheet"}]},{"type":"paragraph","children":[{"type":"text","value":"In the root layout, which wraps every page:"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"import \"@kirana-style/core/stylesheet.css\"","lang":"tsx","html":"<span class=\"th-token th-keyword\">import</span> <span class=\"th-token th-string\">&quot;@kirana-style/core/stylesheet.css&quot;</span>","file":"src/pages/_layout.tsx","title":"src/pages/_layout.tsx"}},{"type":"heading","depth":2,"id":"4-type-sx","children":[{"type":"text","value":"4. Type "},{"type":"inlineCode","value":"sx"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"{\n  \"compilerOptions\": { \"types\": [\"@kirana-style/core/react\"] }\n}","lang":"json","html":"{\n  <span class=\"th-token th-property\">&quot;compilerOptions&quot;</span>: { <span class=\"th-token th-property\">&quot;types&quot;</span>: [<span class=\"th-token th-string\">&quot;@kirana-style/core/react&quot;</span>] }\n}","file":"tsconfig.json","title":"tsconfig.json"}},{"type":"heading","depth":2,"id":"5-write-a-page","children":[{"type":"text","value":"5. Write a page"}]},{"type":"paragraph","children":[{"type":"text","value":"A server component styles itself the way a client component does; there is no\nruntime to keep out of it, because the styles are compiled away:"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"import { css } from \"@kirana-style/core\"\n\nconst title = css({ fontSize: \"2rem\", fontWeight: 600 })\n\nexport default async function Home() {\n  return <h1 sx={title}>Hello</h1>\n}\n\nexport const getConfig = async () => ({ render: \"static\" }) as const","lang":"tsx","html":"<span class=\"th-token th-keyword\">import</span> { css } <span class=\"th-token th-keyword\">from</span> <span class=\"th-token th-string\">&quot;@kirana-style/core&quot;</span>\n\n<span class=\"th-token th-keyword\">const</span> title = <span class=\"th-token th-function\">css</span>({ <span class=\"th-token th-property\">fontSize</span>: <span class=\"th-token th-string\">&quot;2rem&quot;</span>, <span class=\"th-token th-property\">fontWeight</span>: <span class=\"th-token th-number\">600</span> })\n\n<span class=\"th-token th-keyword\">export</span> <span class=\"th-token th-keyword\">default</span> <span class=\"th-token th-keyword\">async</span> <span class=\"th-token th-keyword\">function</span> <span class=\"th-token th-function\">Home</span>() {\n  <span class=\"th-token th-keyword\">return</span> &lt;<span class=\"th-token th-tag\">h1</span> <span class=\"th-token th-attr\">sx</span>={title}&gt;Hello&lt;/<span class=\"th-token th-tag\">h1</span>&gt;\n}\n\n<span class=\"th-token th-keyword\">export</span> <span class=\"th-token th-keyword\">const</span> getConfig = <span class=\"th-token th-keyword\">async</span> () =&gt; ({ <span class=\"th-token th-property\">render</span>: <span class=\"th-token th-string\">&quot;static&quot;</span> }) <span class=\"th-token th-keyword\">as</span> <span class=\"th-token th-keyword\">const</span>","file":"src/pages/index.tsx","title":"src/pages/index.tsx"}},{"type":"heading","depth":2,"id":"next","children":[{"type":"text","value":"Next"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"/docs/frameworks/react","children":[{"type":"text","value":"React"}]},{"type":"text","value":": "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"sx","source":"sx"}},{"type":"text","value":" in React components."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"/docs/frameworks/nextjs","children":[{"type":"text","value":"Next.js"}]},{"type":"text","value":", the other