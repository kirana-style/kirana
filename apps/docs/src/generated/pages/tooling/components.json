and\">npx</span> kirana-style ui init","variant":"terminal"}},{"type":"paragraph","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"init","source":"init"}},{"type":"text","value":" works on a new app or one you already have:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"it sets Kirana up where the project lacks it, as "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-command\">kirana-style</span> init","source":"kirana-style init"}},{"type":"text","value":" does;"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"it maps the "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"@<span class=\"th-token th-comment\">/*</span>","source":"@/*"}},{"type":"text","value":" alias in "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"tsconfig.json","source":"tsconfig.json"}},{"type":"text","value":" when the project has none, and tells\nVite to read it; a JavaScript Next.js app gets the "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"tsconfig.json","source":"tsconfig.json"}},{"type":"text","value":" Next.js\nwould write, and TypeScript, since the components are TypeScript;"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"it installs the registry's design system and wires it in: its configuration in\n"},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"kirana.config.ts","source":"kirana.config.ts"}},{"type":"text","value":", its reset beside Kirana's stylesheet, its styles on\n"},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"&lt;<span class=\"th-token th-tag\">html</span>&gt;","source":"<html>"}},{"type":"text","value":"."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"To start from nothing, take one of Kirana's examples, as the release you run has\nit:"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"npx @kirana-style/registry init --template vite-react my-app","lang":"bash","html":"<span class=\"th-token th-prompt\">$</span> <span class=\"th-token th-command\">npx</span> @kirana-style/registry init <span class=\"th-token th-attr\">--template</span> vite-react my-app","variant":"terminal"}},{"type":"paragraph","children":[{"type":"text","value":"The project it makes runs "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-command\">kirana-style</span> ui","source":"kirana-style ui"}},{"type":"text","value":" by itself: "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"init","source":"init"}},{"type":"text","value":" adds\n"},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"@kirana-style/registry","source":"@kirana-style/registry"}},{"type":"text","value":" beside Kirana's other packages, each at the release you\nran, written as that exact version."}]},{"type":"paragraph","children":[{"type":"text","value":"Start with a design by its preset code, which a design system's site gives you:"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"npx kirana-style ui init --preset k2bS6","lang":"bash","html":"<span cl