{},"children":[],"properties":{"html":"ui add font-lora","source":"ui add font-lora"}},{"type":"text","value":") is a package and the stylesheet that loads it, which\n"},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"add","source":"add"}},{"type":"text","value":" imports after Kirana's stylesheet."}]},{"type":"heading","depth":2,"id":"in-a-monorepo","children":[{"type":"text","value":"In a monorepo"}]},{"type":"paragraph","children":[{"type":"text","value":"In a Turborepo or any other workspace, the components can live in a package that\nevery app imports, as shadcn/ui's monorepo template has them. Run "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"init","source":"init"}},{"type":"text","value":" in the\napp, with the package's folder from the workspace's root:"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"cd apps/web\nnpx kirana-style ui init --workspace packages/ui","lang":"bash","html":"<span class=\"th-token th-prompt\">$</span> <span class=\"th-token th-command\">cd</span> apps/web\n<span class=\"th-token th-prompt\">$</span> <span class=\"th-token th-command\">npx</span> kirana-style ui init <span class=\"th-token th-attr\">--workspace</span> packages/ui","variant":"terminal"}},{"type":"paragraph","children":[{"type":"text","value":"The package needs a "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"package.json","source":"package.json"}},{"type":"text","value":" with its name. Its aliases start with that\nname, so the app imports "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"@workspace/ui/components/button","source":"@workspace/ui/components/button"}},{"type":"text","value":". "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"init","source":"init"}},{"type":"text","value":" makes the\npackage a Kirana project and wires the app to it:"}]},{"type":"table","align":[null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Folder"}]},{"type":"tableCell","children":[{"type":"text","value":"What "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"init","source":"init"}},{"type":"text","value":" writes there"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"packages/ui","source":"packages/ui"}}]},{"type":"tableCell","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"kirana.config.ts","source":"kirana.config.ts"}},{"type":"text","value":" with the "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"ui","source":"ui"}},{"type":"text","value":" settings and the design system's configuration; "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-string\">&quot;@workspace/ui/*&quot;</span>: [<span class=\"th-token th-string\">&quot;./src/*&quot;</span>]","source":"\"@workspace/ui/*\": [\"./src/*\"]"}},{"type":"text","value":" in its tsconfig, or a tsconfig with the app's JSX options; the components, their packages and the lockfile"}]}],[{"type":"tableCell","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"apps/web","source":"apps/web"}}]},{"type":"tableCell","children":[{"type":"text","value":"Kirana's own setu