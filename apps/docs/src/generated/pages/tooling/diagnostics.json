orts back. A type-only import ("},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"import type","source":"import type"}},{"type":"text","value":",\n"},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-keyword\">import</span> { <span class=\"th-token th-keyword\">type</span> … }","source":"import { type … }"}},{"type":"text","value":") holds no value and never makes a cycle."}]},{"type":"heading","depth":2,"id":"reading-one","children":[{"type":"text","value":"Reading one"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"$ kirana-style check src\nerror[KRN1301] unknown-condition: \":hover\" is a condition, and conditions nest\ninside property values (src/card.tsx:12:3)\n  help: write `property: { [condition]: value }`","lang":"console","html":"<span class=\"th-token th-prompt\">$</span> <span class=\"th-token th-command\">kirana-style</span> check src\n<span class=\"th-token th-deleted\">error[KRN1301]</span><span class=\"th-token th-strong\"> unknown-condition</span>: \":hover\" is a condition, and conditions nest\ninside property values (src/card.tsx:12:3)\n  <span class=\"th-token th-inserted\">help:</span> write `property: { [condition]: value }`","variant":"terminal"}},{"type":"paragraph","children":[{"type":"text","value":"Code, name, message, location, and a help line that says what to do. "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-command\">kirana-style</span> check <span class=\"th-token th-attr\">--format</span> json","source":"kirana-style check --format json"}},{"type":"text","value":" gives the same fields as data."}]},{"type":"component","name":"diagnostics-figure","attributes":{},"children":[]}],"headings"