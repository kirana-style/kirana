ana-style/biome-plugin/rules/use-logical-properties.grit\",\n  ],\n}","lang":"jsonc","html":"<span class=\"th-token th-comment\">// biome.json</span>\n{\n  <span class=\"th-token th-property\">&quot;extends&quot;</span>: [<span class=\"th-token th-string\">&quot;@kirana-style/biome-plugin/recommended&quot;</span>],\n  <span class=\"th-token th-property\">&quot;plugins&quot;</span>: [\n    <span class=\"th-token th-string\">&quot;./node_modules/@kirana-style/biome-plugin/rules/use-logical-properties.grit&quot;</span>,\n  ],\n}"}},{"type":"heading","depth":2,"id":"rules","children":[{"type":"text","value":"Rules"}]},{"type":"heading","depth":3,"id":"diagnostics","children":[{"type":"inlineCode","value":"diagnostics"}]},{"type":"paragraph","children":[{"type":"text","value":"Every "},{"type":"link","href":"/docs/tooling/diagnostics","children":[{"type":"text","value":"compiler diagnostic"}]},{"type":"text","value":", at the property it is\nabout, so a CI that only lints still fails on what the build would report.\nWarnings and errors by default; "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"{ <span class=\"th-token th-string\">&quot;minimum&quot;</span>: <span class=\"th-token th-string\">&quot;info&quot;</span> }","source":"{ \"minimum\": \"info\" }"}},{"type":"text","value":" adds the informational ones\nand "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"{ <span class=\"th-token th-string\">&quot;ignore&quot;</span>: [<span class=\"th-token th-string\">&quot;unresolved-import&quot;</span>] }","source":"{ \"ignore\": [\"unresolved-import\"] }"}},{"type":"text","value":" drops names."}]},{"type":"heading","depth":3,"id":"sx-last","children":[{"type":"inlineCode","value":"sx-last"}]},{"type":"paragraph","children":[{"type":"text","value":"A component that forwards its caller's "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"sx","source":"sx"}},{"type":"text","value":" must put it last, or the styles after\nit override the caller's, and the caller cannot tell why their style does not\napply. Autofix."}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"<div sx={[styles.root, sx, active && styles.active]} /> // ✕\n<div sx={[styles.root, active && styles.active, sx]} /> // ✓","lang":"tsx","html":"&lt;<span class=\"th-token th-tag\">div</span> <span class=\"th-token th-attr\">sx</span>={[styles.<span class=\"th-token th-property\">root</span>, sx, active &amp;&amp; styles.<span class=\"th-token th-property\">active</span>]} /&gt; <span class=\"th-token th-comment\">// ✕</span>\n&lt;<span class=\"th-token th-tag\">div</span> <span class=\"th-token th-attr\">sx</span>={[styles.<span class=\"th-token th-property\">root</span>, active &amp;&amp; styles.<span class=\"th-token th-property\">active</span>, sx]} /&gt; <span class=\"th-token th-comment\">// ✓</span>"}},{"type":"paragraph","children":[{"type":"text","value":"A "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"className","source":"className"}},{"type":"text","value":" handed down by a parent's "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"render","source":"render"}},{"type":"text","value":" may follow it."}]},{"type":"heading","depth":3,"id":"no-conflicting-props","children":[{"type":"inlineCode","value":"no-conflicting-props"}]},{"type":"paragraph","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"className","source":"className"}},{"type":"text","value":" or "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"style","source":"style"}},{"type":"text","value":" written next to "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"{...<span class=\"th-token th-function\">styleProps</span>(…)}","source":"{...styleProps(…)}"}},{"type":"text","value":" on one element: JSX\nkeeps the last one, so either the compiled styles or the attribute never reach\nthe DOM. Move those styles into a "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-function\">css</span>()","source":"css()"}},{"type":"text","value":" handle and pass it to the same call."}]},{"type":"heading","depth":3,"id":"override-keeps-conditions","children":[{"type":"inlineCode","value":"override-keeps-conditions"}]},{"type":"paragraph","children":[{"type":"text","value":"The pitfall of coming from StyleX: StyleX replaced a whole property, Kirana\n"},{"type":"link","href":"/docs/styling/merging","children":[{"type":"text","value":"merges per condition"}]},{"type":"text","value":". A plain value passed to a component\nthat sets the same property under an attribute condition keeps losing there:"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"// Separator: alignSelf: { base: \"stretch\", '[data-orientation=\"vertical\"]': \"center\" }\n<Separator sx={css({ alignSelf: \"auto\" })} /> // ✕ still \"center\" when vertical","lang":"tsx","html":"<span class=\"th-token th-comment\">// Separator: alignSelf: { base: &quot;stretch&quot;, &#39;[data-orientation=&quot;vertical&quot;]&#39;: &quot;center&quot; }</span>\n&lt;<span class=\"th-token th-type\">Separator</span> <span class=\"th-token th-attr\">sx</span>={<span class=\"th-token th-function\">css</span>({ <span class=\"th-token th-property\">alignSelf</span>: <span class=\"th-token th-st