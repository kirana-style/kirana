dules/@kirana-style/biome-plugin/rules/*.grit"}},{"type":"text","value":",\nbecause Biome resolves a plugin path from the project; in a workspace member\nwhose "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"node_modules","source":"node_modules"}},{"type":"text","value":" sits higher up, list the files from there in "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"plugins","source":"plugins"}},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"A Biome plugin matches syntax: it cannot ask the compiler or read another file.\nWhat the other rules would report reaches a Biome project two other ways:\n"},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-command\">kirana-style</span> check","source":"kirana-style check"}},{"type":"text","value":" in CI, as pull-request annotations, and the\n"},{"type":"link","href":"/docs/tooling/editor","children":[{"type":"text","value":"language server"}]},{"type":"text","value":" in the editor:"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"# .github/workflows/ci.yml\n- run: npx kirana-style check src --format github --max-warnings 0","lang":"yaml","html":"# .github/workflows/ci.yml\n- run: npx kirana-style check src --format github --max-warnings 0"}},{"type":"paragraph","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"no-unused","source":"no-unused"}},{"type":"text","value":" and "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"sort-properties","source":"sort-properties"}},{"type":"text","value":" stay ESLint and Oxlint only: counting member\nreads and ordering keys against the property table are beyond what GritQL can\nexpress."}]},{"type":"heading","depth":2,"id":"the-project-root","children":[{"type":"text","value":"The project root"}]},{"type":"paragraph","children":[{"type":"text","value":"The project root is the nearest "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"kirana.<span class=\"th-token th-property\">config</span>.*","source":"kirana.config.*"}},{"type":"text","value":" above the file being linted. In a\nmonorepo whose packages share a configuration, give the package its own\n"},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"kirana.config.ts","source":"kirana.config.ts"}},{"type":"text","value":" that exports it, or set "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"settings.<span class=\"th-token th-property\">kirana</span>.<span class=\"th-token th-property\">root</span>","source":"settings.kirana.root"}},{"type":"text","value":". The project is\ncompiled once per lint run and each file once, however many rules ask; the native\nengine must be installed, as for a build."}]},{"type":"heading","depth":2,"id":"every-rule-at-a-glance","children":[{"type":"text","value":"Every rule at a glance"}]},{"type":"component","name":"lint-rules","attributes":{},"children":[]},{"type":"heading","depth":2,"id":"configs","children":[{"type":"text","value":"Configs"}]},{"type":"table","align":[null,null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Config"}]},{"type":"tableCell","children":[{"type":"text","value":"What it holds"}]},{"type":"tableCell","children":[{"type":"text","value":"Rules"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code"