{"type":"root","children":[{"type":"heading","depth":1,"id":"migrating-from-stylex","children":[{"type":"text","value":"Migrating from StyleX"}]},{"type":"paragraph","children":[{"type":"text","value":"If you write StyleX today, most of your styles are already Kirana styles: both\nsystems put typed style objects next to components and conditions inside values,\nso the mapping below is close to mechanical. The differences that matter are in\nmerge semantics and in what the compiler checks."}]},{"type":"heading","depth":2,"id":"the-mapping","children":[{"type":"text","value":"The mapping"}]},{"type":"paragraph","children":[{"type":"text","value":"Four names carry most of a StyleX codebase; the table after them has the rest."}]},{"type":"component","name":"figure-stylex","attributes":{},"children":[]},{"type":"table","align":[null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"StyleX"}]},{"type":"tableCell","children":[{"type":"text","value":"Kirana"}]}],"rows":[[{"type":"tableCell","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"stylex.<span class=\"th-token th-property\">create</span>({ … })","source":"stylex.create({ … })"}}]},{"type":"tableCell","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-function\">css</span>({ … })","source":"css({ … })"}},{"type":"text","value":" per style, or an object of handles"}]}],[{"type":"tableCell","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"stylex.<span class=\"th-token th-property\">props</span>(a, b)","source":"stylex.props(a, b)"}}]},{"type":"tableCell","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token