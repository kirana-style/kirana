e":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"stylex.<span class=\"th-token th-property\">viewTransitionClass</span>({ … })","source":"stylex.viewTransitionClass({ … })"}}]},{"type":"tableCell","children":[{"type":"link","href":"/docs/styling/view-transitions","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-function\">viewTransition</span>({ … })","source":"viewTransition({ … })"}}]}]}],[{"type":"tableCell","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"stylex.<span class=\"th-token th-property\">when</span>.<span class=\"th-token th-property\">hover</span>","source":"stylex.when.hover"}},{"type":"text","value":" and markers"}]},{"type":"tableCell","children":[{"type":"link","href":"/docs/styling/relations","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-function\">relation</span>()","source":"relation()"}}]}]}],[{"type":"tableCell","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-attr\">default:</span>","source":"default:"}},{"type":"text","value":" inside a value"}]},{"type":"tableCell","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-attr\">base:</span>","source":"base:"}}]}],[{"type":"tableCell","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"@media (…)","source":"@media (…)"}},{"type":"text","value":" as a key inside a value"}]},{"type":"tableCell","children":[{"type":"text","value":"the same, or "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-string\">[media(\"…\")]</span>","source":"[media(\"…\")]"}}]}]]},{"type":"heading","depth":2,"id":"the-difference-that-bites","children":[{"type":"text","value":"The difference that bites"}]},{"type":"paragraph","children":[{"type":"text","value":"In StyleX, "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"default: null","source":"default: null"}},{"type":"text","value":" inside a variant means "},{"type":"strong","children":[{"type":"text","value":"\"this variant sets nothing\nhere\""}]},{"type":"text","value":". In Kirana, "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"base: null","source":"base: null"}},{"type":"text","value":" "},{"type":"strong","children":[{"type":"text","value":"removes"}]},{"type":"text","value":" a base value an earlier style set."}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"// StyleX: \"no default value for this variant\"\n{ color: { default: null, \":hover\": \"blue\" } }\n\n// Kirana: \"delete any base colour that was set before me\"\n{ color: { base: null, \":hover\": \"blue\" } }","lang":"tsx","html":"<span class=\"th-token th-comment\">// StyleX: &quot;no default value for this variant&quot;</span>\n{ <span class=\"th-token th-property\">color</span>: { <span class=\"th-token th-property\">default</span>: <span class=\"th-token th-literal\">null</span>, <span class=\"th-token th-string\">&quot;:hover&quot;</span>: <span class=\"th-token th-string\">&quot;blue&quot;</span> } }\n\n<span class=\"th-token th-comment\">// Kirana: &quot;delete any base colour that was set before me&quot;</span>\n{ <span class=\"th-token th-property\">color</span>: { <span class=\"th-token th-property\">base</span>: <span class=\"th-token th-literal\">null</span>, <span class=\"th-token th-string\">&quot;:hover&quot;</span>: <span class=\"th-token th-string\">&quot;blue&quot;</span> } }"}},{"type":"paragraph","children":[{"type":"text","value":"A codemod cannot tell which you meant, so it does not try. Port these by hand:\nif the intent was \"nothing here\", "},{"type":"strong","children":[{"type":"text","value":"omit the key"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"what-kirana-has-that-stylex-does-not","children":[{"type":"text","value":"What Kirana has that StyleX does not"}]},{"type":"paragraph","children":[{"type":"text","value":"The mapping above is close to one-to-one because both systems share a premise.\nThese are the things that have no StyleX counterpart, and between them they are\nmost of the reason Kirana exists."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"A stated precedence ladder, and a tool that reads it back."}]},{"type":"text","value":" StyleX offers two\nmodes (later-wins and property-specificity), and neither reproduced what the\nTailwind components needed. Kirana has one ladder, and "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-command\">kirana-style</span> trace file:line property","source":"kirana-style trace file:line property"}},{"type":"text","value":" prints every candidate declaration, the winner, and the step that\ndecided it."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Ambiguity is reported."}]},{"type":"text","value":" When two values could both apply and nothing orders\nthem, the compiler says so ("},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"ambiguous-precedence","source":"ambiguous-precedence"}},{"type":"text","value":") instead of silently picking.\n"},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"conditions.<span class=\"th-token th-property\">exclusive</span>","source":"conditions.exclusive"}},{"type":"text","value":" is how you tell it that a library never sets two\nattributes together."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"A diagnostics catalogue."}]},{"type":"text","value":" 51 codes with stable names, severities and help\ntext, and a configuration key to re-level the non-errors. StyleX reports\ncompilation failures; it does not have a catalogue you can suppress, raise, or\nlook up."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Relations are declared and checked."}]},{"type":"text","value":" "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-function\">relation</span>(<span class=\"th-token th-string\">&quot;field&quot;</span>)","source":"relation(\"field\")"}},{"type":"text","value":" gives you an anchor\nand four reads, and the compiler errors when a relation is read but never\nanchored ("},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"relation-without-anchor","source":"relation-without-anchor"}},{"type":"text","value":") or anchored in a position that cannot match\n("},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"relation-placement","source":"relation-placement"}},{"type":"text","value":"). StyleX's "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"when.*","source":"when.*"}},{"type":"text","value":" with marker classes compiles either\nway, and a mis-placed marker is a rule that silently never fires."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Contextual styles have a layer of their own."}]},{"type":"text","value":" "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"select.<span class=\"th-token th-property\">descendant</span>(<span class=\"th-token th-string\">&quot;svg&quot;</span>)","source":"select.descendant(\"svg\")"}},{"type":"text","value":" lands\nbelow element styles, so the target's own style always wins, with no hand-down\ncustom properties and no "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":":<span class=\"th-token th-function\">not</span>([<span class=\"th-token th-keyword\">class</span>*=<span class=\"th-token th-string\">&#39;size-&#39;</span>])","source":":not([class*='size-'])"}},{"type":"text","value":" guards."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"sx","source":"sx"}},{"type":"text","value":" is checked where it is used."}]},{"type":"text","value":" Passing it to a component that does not read\nit is reported ("},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"sx-on-external-component","source":"sx-on-external-component"}},{"type":"text","value":"), including one module away through a\nrest spread, and a component that takes it and drops it gets "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"unused-sx","source":"unused-sx"}},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Colour modes without plumbing."}]},{"type":"text","value":" Every colour is one "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-function\">light-dark</span>()","source":"light-dark()"}},{"type":"text","value":" pair and\n"},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"mode.<span class=\"th-token th-property\">system</span>","source":"mode.system"}},{"type":"text","value":" needs no JavaScript at all. StyleX needs a theme per mode and a\nmechanism to switch it."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Registered tokens."}]},{"type":"text","value":" A token declared with a "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"syntax","source":"syntax"}},{"type":"text","value":" emits "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"@property","source":"@property"}},{"type":"text","value":", so a\ncustom property can be animated and used as a keyframe key."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Layers you control."}]},{"type":"text","value":" "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"layers.<span class=\"th-token th-property\">before</span>","source":"layers.before"}},{"type":"text","value":" / "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"layers.<span class=\"th-token th-property\">after</span>","source":"layers.after"}},{"type":"text","value":" place your reset and\nvendor CSS around Kirana's own layers, and nothing is emitted unlayered, including\ncustom-property assignments, which StyleX leaves outside any layer."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"A branch budget for dynamic values."}]},{"type":"text","value":" A finite set of runtime values compiles\nto a class expression, an open value to a custom-property bridge, and exceeding\nthe budget is an error rather than a combinatorial explosion."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Tailwind's vocabulary, if you want it."}]},{"type":"text","value":" "},{"type":"link","href":"/docs/tokens/preset-scales","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"@kirana-style/preset-scales","source":"@kirana-style/preset-scales"}}]},{"type":"text","value":"\nis Tailwind v4's scales as tokens, and "},{"type":"link","href":"/docs/styling/utilities","children":[{"type":"text","value":"utility strings"}]},{"type":"text","value":"\n("},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-attr\">sx</span>=<span class=\"th-token th-string\">&quot;px-4 text-sm&quot;</span>","source":"sx=\"px-4 text-sm\""}},{"type":"text","value":") compile to the same atoms as the object form. StyleX\nleaves the vocabulary to you."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Hosts and frameworks."}]},{"type":"text","value":" Adapters for Vite, Rolldown, webpack, Rspack, Rsbuild, Parcel, Bun and esbuild; "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"sx","source":"sx"}},{"type":"text","value":" in\nReact, Preact, Solid, Qwik, Vue, Svelte, Astro, Angular and Ember and every framework built on them (React, Next.js, React Router, TanStack Start, Gatsby, Remix, Waku, Vike, Docusaurus, Preact, Solid, SolidStart, Vue, Nuxt, VitePress, Svelte, SvelteKit, Astro, Qwik, Angular, Ember and Meteor); and\ntemplates in Laravel, Symfony, Rails, Phoenix and AdonisJS, each with an example CI builds and checks. See\n"},{"type":"link","href":"/docs/frameworks/overview","children":[{"type":"text","value":"frameworks"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"The longer argument, with the StyleX port's problems and what answers each, is\n"},{"type":"link","href":"/docs/start/why-kirana#what-stylex-got-right-and-what-kirana-adds","children":[{"type":"text","value":"Why Kirana"}]},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"what-stylex-has-that-kirana-does-not","children":[{"type":"text","value":"What StyleX has that Kirana does not"}]},{"type":"paragraph","children":[{"type":"text","value":"Fairness matters more than a feature list:"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"It is published, versioned and used in production"}]},{"type":"text","value":" at Meta scale. Kirana is\nat a 0.x version."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"A larger ecosystem"}]},{"type":"text","value":": community plugins, documentation, examples, articles and people who have\nalready hit your problem."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"A few helpers"}]},{"type":"text","value":" have no direct equivalent, "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"stylex.<span class=\"th-token th-property\">when</span>.<span class=\"th-token th-property\">descendant</span>","source":"stylex.when.descendant"}},{"type":"text","value":" and\n"},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"stylex.<span class=\"th-token th-property\">when</span>.<span class=\"th-token th-property\">anySibling</span>","source":"stylex.when.anySibling"}},{"type":"text","value":" among them; write a "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":":<span class=\"th-token th-function\">has</span>()","source":":has()"}},{"type":"text","value":" condition.\n"},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-command\">kirana-style</span> migrate stylex","source":"kirana-style migrate stylex"}},{"type":"text","value":" names each one it meets in its report."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"If you need a styling compiler in production this quarter, StyleX is the\ndefensible choice. Kirana is worth it when predictability and diagnostics are the\nthing you are missing."}]},{"type":"heading","depth":2,"id":"what-else-is-different","children":[{"type":"text","value":"What else is different"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Precedence."}]},{"type":"text","value":" StyleX has two modes (later-wins and property-specificity), and\nneither reproduced what the Tailwind components needed. Kirana has one\n"},{"type":"link","href":"/docs/styling/precedence","children":[{"type":"text","value":"ladder"}]},{"type":"text","value":", and reports the cases it cannot order instead\nof picking silently."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Relations are declared."}]},{"type":"text","value":" StyleX's "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"when.*","source":"when.*"}},{"type":"text","value":" and marker classes become a\n"},{"type":"inlineComponent","name"