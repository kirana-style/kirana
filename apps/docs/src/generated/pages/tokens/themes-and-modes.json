en th-tag\">html</span>&gt;","source":"<html>"}},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Tell the other tabs"}]},{"type":"text","value":": write the cookie in the browser when the reader\nchooses, and post the new mode on a "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-type\">BroadcastChannel</span>","source":"BroadcastChannel"}},{"type":"text","value":" the other tabs listen to."}]}]}]},{"type":"paragraph","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"system","source":"system"}},{"type":"text","value":" needs none of this: it is "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"color-scheme: light dark","source":"color-scheme: light dark"}},{"type":"text","value":", which follows the\noperating system without JavaScript. A reader who never chooses gets no cookie."}]},{"type":"component","name":"figure-theme-flow","attributes":{},"children":[]},{"type":"heading","depth":3,"id":"in-tanstack-start","children":[{"type":"text","value":"In TanStack Start"}]},{"type":"paragraph","children":[{"type":"text","value":"The code below is for TanStack Start with server rendering; it is what this site\nruns. Other frameworks follow the same three steps (see the table after it)."}]},{"type":"paragraph","children":[{"type":"text","value":"The cookie, read on the server from the request and in the browser from\n"},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"document.<span class=\"th-token th-property\">cookie</span>","source":"document.cookie"}},{"type":"text","value":", so a client-side navigation sends no request:"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"import { createIsomorphicFn } from \"@tanstack/react-start\"\nimport { getCookie } from \"@tanstack/react-start/server\"\n\nexport type Scheme = \"system\" | \"light\" | \"dark\"\nexport const COOKIE = \"theme\"\n\nexport const isScheme = (value: unknown): value is Scheme =>\n  value === \"system\" || value === \"light\" || value === \"dark\"\n\nexport const readScheme = createIsomorphicFn()\n  .server((): Scheme => {\n    const value = getCookie(COOKIE)\n    return isScheme(value) ? value : \"system\"\n  })\n  .client((): Scheme => {\n    const value = document.cookie.match(/(?:^|; )theme=(\\w+)/)?.[1]\n    return isScheme(value) ? value : \"system\"\n  })","lang":"ts","html":"<span class=\"th-token th-keyword\">import</span> { createIsomorphicFn } <span class=\"th-token th-keyword\">from</span> <span class=\"th-token th-string\">&quot;@tanstack/react-start&quot;</span>\n<span class=\"th-token th-keyword\">import</span> { getCookie } <span class=\"th-token th-keyword\">from</span> <span class=\"th-token th-string\">&quot;@tanstack/react-start/server&quot;</span>\n\n<span class=\"th-token th-keyword\">export</span> <span class=\"th-token th-keyword\">type</span> <span class=\"th-token th-type\">Scheme</span> = <span class=\"th-token th-string\">&quot;system&quot;</span> | <span class=\"th-token th-string\">&quot;light&quot;</span> | <span class=\"th-token th-string\">&quot;dark&quot;</span>\n<span class=\"th-token th-keyword\">export</span> <span class=\"th-token th-keyword\">const</span> <span class=\"th-token th-type\">COOKIE</span> = <span class=\"th-token th-string\">&quot;theme&quot;</span>\n\n<span class=\"th-token th-keyword\">export</span> <span class=\"th-token th-keyword\">const</span> isScheme = (<span class=\"th-token th-property\">value</span>: <span class=\"th-token th-type\">unknown</span>): value <span class=\"th-token th-keyword\">is</span> <span class=\"th-token th-type\">Scheme</span> =&gt;\n  value === <span class=\"th-token th-string\">&quot;system&quot;</span> || value === <span class=\"th-token th-string\">&quot;light&quot;</span> || value === <span class=\"th-token th-string\">&quot;dark&quot;</span>\n\n<span class=\"th-token th-keyword\">export</span> <span class=\"th-token th-keyword\">const</span> readScheme = <span class=\"th-token th-function\">createIsomorphicFn</span>()\n  .<span class=\"th-token th-property\">server</span>((): <span class=\"th-token th-type\">Scheme</span> =&gt; {\n    <span class=\"th-token th-keyword\">const</span> value = <span class=\"th-token th-function\">getCookie</span>(<span class=\"th-token th-type\">COOKIE</span>)\n    <span class=\"th-token th-keyword\">return</span> <span class=\"th-token th-function\">isScheme</span>(value) ? value : <span class=\"th-token th-string\">&quot;system&quot;</span>\n  })\n  .<span class=\"th-token th-property\">client</span>((): <span class=\"th-token th-type\">Scheme</span> =&gt; {\n    <span class=\"th-token th-keyword\">const</span> value = document.<span class=\"th-token th-property\">cookie</span>.<span class=\"th-token th-property\">match</span>(<span class=\"th-token th-literal\">/(?:^|; )theme=(\\w+)/</span>)?.[<span class=\"th-token th-number\">1</span>]\n    <span class=\"th-token th-keyword\">return</span> <span class=\"th-token th-function\">isScheme</span>(value) ? value : <span class=\"th-token th-string\">&quot;system&quot;</span>\n  })","file":"src/lib/theme.ts","title":"src/lib/theme.ts"}},{"type":"paragraph","children":[{"type":"text","value":"A provider that writes the cookie and keeps the tabs in step:"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"import { createContext, use, useEffect, useRef, useState } from \"react\"\n\nimport { COOKIE, isScheme } from \"@/lib/theme\"\nimport type { Scheme } from \"@/lib/theme\"\n\nconst ThemeContext = createContext<{\n  scheme: Scheme\n  setScheme: (scheme: Scheme) => void\n} | null>(null)\n\nexport function ThemeProvider({\n  initial,\n  children,\n}: {\n  initial: Scheme\n  children: React.ReactNode\n}) {\n  const [scheme, setState] = useState(initial)\n  const channel = useRef<BroadcastChannel | null>(null)\n\n  // Another tab chose: follow it.\n  useEffect(() => {\n    const tabs = new BroadcastChannel(COOKIE)\n    tabs.onmessage = (event) => {\n      if (isScheme(event.data)) setState(event.data)\n    }\n    channel.current = tabs\n    return () => tabs.close()\n  }, [])\n\n  const setScheme = (next: Scheme) => {\n    setState(next)\n    document.cookie = `${COOKIE}=${next}; path=/; max-age=31536000; samesite=lax`\n    channel.current?.postMessage(next)\n  }\n\n  return <ThemeContext value={{ scheme, setScheme }}>{children}</ThemeContext>\n}\n\nexport const useTheme = () => use(ThemeContext)!","lang":"tsx","html":"<span class=\"th-token th-keyword\">import</span> { createContext, use, useEffect, useRef, useState } <span class=\"th-token th-keyword\">from</span> <span class=\"th-token th-string\">&quot;react&quot;</span>\n\n<span class=\"th-token th-keyword\">import</span> { <span class=\"th-token th-type\">COOKIE</span>, isScheme } <span class=\"th-token th-keyword\">from</span> <span class=\"th-token th-string\">&quot;@/lib/theme&quot;</span>\n<span class=\"th-token th-keyword\">import</span> <span class=\"th-token th-keyword\">type</span> { <span class=\"th-token th-type\">Scheme</span> } <span class=\"th-token th-keyword\">from</span> <span class=\"th-token th-string\">&quot;@/lib/theme&quot;</span>\n\n<span class=\"th-token th-keyword\">const</span> <span class=\"th-token th-type\">ThemeContext</span> = createContext&lt;{\n  <span class=\"th-token th-property\">scheme</span>: <span class=\"th-token th-type\">Scheme</span>\n  <span class=\"th-token th-property\">setScheme</span>: (<span class=\"th-token th-property\">scheme</span>: <span class=\"th-token th-type\