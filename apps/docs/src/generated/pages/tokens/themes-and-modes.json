ildren":[],"properties":{"html":":root","source":":root"}},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"Theme overrides go in "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"kirana.<span class=\"th-token th-property\">themes</span>","source":"kirana.themes"}},{"type":"text","value":", as a class."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Both sit below your component styles, so a component that sets a colour directly\nalways wins over a theme that suggests one."}]},{"type":"heading","depth":2,"id":"switching-without-a-flash","children":[{"type":"text","value":"Switching without a flash"}]},{"type":"paragraph","children":[{"type":"text","value":"The mode handle is a class on the root element, so server-rendered HTML can carry\nit: render the user's stored preference into the root on the server, and there is\nno flash. "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"system","source":"system"}},{"type":"text","value":" needs nothing stored at all."}]},{"type":"heading","depth":2,"id":"what-not-to-do","children":[{"type":"text","value":"What not to do"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Do not put the mode on "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"&lt;<span class=\"th-token th-tag\">body</span>&gt;","source":"<body>"}},{"type":"text","value":"."}]},{"type":"text","value":" The canvas belongs to the root."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Do not write a "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-attr\">dark:</span>","source":"dark:"}},{"type":"text","value":" variant."}]},{"type":"text","value":" There is no dark variant; the pair is in the\ntoken."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Do not theme scales."}]},{"type":"text","value":" Re-theming "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"space<span class=\"th-token th-string\">[4]</span>","source":"space[4]"}},{"type":"text","value":" makes a layout unpredictable;\ntheme the semantic layer instead."}]}]}]}],"headings":[{"id":"themes-and-modes","text":"Themes and modes","level":1},{"id":"modes","text":"Modes","level":2},{"id":"themes","text":"Themes","level":2},{"id":"per-mode-overrides","text":"Per-mode overrides","level":3},{"id":"where-the-values-live","text":"Where the values live","level":2},{"id":"switching-without-a-flash","text":"Switching without a flash","level":2},{"id":"what-not-to-do","text":"What not to do","level":2}]}
