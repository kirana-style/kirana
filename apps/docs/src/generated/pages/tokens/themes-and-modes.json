\nopaque backdrop."}]},{"type":"paragraph","children":[{"type":"text","value":"With every colour written as a "},{"type":"link","href":"/docs/tokens/semantic-tokens","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-function\">light-dark</span>()","source":"light-dark()"}},{"type":"text","value":" pair"}]},{"type":"text","value":",\nthat single declaration is the whole dark-mode implementation. "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"system","source":"system"}},{"type":"text","value":" needs no\nJavaScript at all."}]},{"type":"paragraph","children":[{"type":"text","value":"A three-way switch is then ordinary state:"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"const [scheme, setScheme] = useState<\"system\" | \"light\" | \"dark\">(\"system\")\n\n<html sx={mode[scheme]}>","lang":"tsx","html":"<span class=\"th-token th-keyword\">const</span> [scheme, setScheme] = useState&lt;<span class=\"th-token th-string\">&quot;system&quot;</span> | <span class=\"th-token th-string\">&quot;light&quot;</span> | <span class=\"th-token th-string\">&quot;dark&quot;</span>&gt;(<span class=\"th-token th-string\">&quot;system&quot;</span>)\n\n&lt;<span class=\"th-token th-tag\">html</span> <span class=\"th-token th-attr\">sx</span>={mode[scheme]}&gt;"}},{"type":"heading","depth":2,"id":"themes","children":[{"type":"text","value":"Themes"}]},{"type":"paragraph","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"defineTheme","source":"defineTheme"}},{"type":"text","value":" overrides variable tokens for a subtree:"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"import { defineTheme } from \"@kirana-style/core\"\nimport { theme } from \"./tokens\"\n\nexport const brand = defineTheme(theme, {\n  primary: `light-dark(${color.violet500}, ${color.violet400})`,\n})\n\n<section sx={brand}>…</section>","lang":"tsx","html":"<span class=\"th-token th-keyword\">import</span> { defineTheme } <span class=\"th-token th-keyword\">from</span> <span class=\"th-token th-string\">&quot;@kirana-style/core&quot;</span>\n<span class=\"th-token th-keyword\">import</span> { theme } <span class=\"th-token th-keyword\">from</span> <span class=\"th-token th-string\">&quot;./tokens&quot;</span>\n\n<span class=\"th-token th-keyword\">export</span> <span class=\"th-token th-keyword\">const</span> brand = <span class=\"th-token th-function\">defineTheme</span>(theme, {\n  <span class=\"th-token th-property\">primary</span>: <span class=\"th-token th-string\">`light-dark(</span><span class=\"th-token th-operator\">${</span>color.<span class=\"th-token th-property\">violet500</span><span class=\"th-token th-operator\">}</span><span class=\"th-token th-string\">, </span><span class=\"th-token th-operator\">${</span>color.<span class=\"th-token th-property\">violet400</span><span class=\"th-token th-operator\">}</span><span class=\"th-token th-string\">)`</span>,\n})\n\n&lt;<span class=\"th-token th-tag\">section</span> <span class=\"th-token th-attr\">sx</span>={brand}&gt;…&lt;/<span class=\"th-token th-tag\">section</span>&gt;"}},{"type":"paragraph","children":[{"type":"text","value":"Everything inside the section reads the new value; everything outside is\nuntouched. Themes nest, and a theme may override some tokens and leave the rest."}]},{"type":"paragraph","children":[{"type":"text","value":"Only "},{"type":"strong","children":[{"type":"text","value":"variable"}]},{"type":"text","value":" tokens can be overridden — overriding an inlined one is an error\n("},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"proper