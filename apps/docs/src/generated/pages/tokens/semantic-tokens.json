{"type":"root","children":[{"type":"heading","depth":1,"id":"semantic-tokens","children":[{"type":"text","value":"Semantic tokens"}]},{"type":"paragraph","children":[{"type":"text","value":"Scales tell you what values exist. Semantic tokens say what they "},{"type":"emphasis","children":[{"type":"text","value":"mean"}]},{"type":"text","value":": what a\ncard's surface is, what \"primary\" is, what a border looks like. This is the layer\nthat makes a component readable — "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-property\">backgroundColor</span>: theme.<span class=\"th-token th-property\">card</span>","source":"backgroundColor: theme.card"}},{"type":"text","value":" says something\n"},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"color.<span class=\"th-token th-property\">zinc50</span>","source":"color.zinc50"}},{"type":"text","value":" does not."}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"import { defineTokens } from \"@kirana-style/core\"\nimport { color } from \"@kirana-style/preset-scales\"\n\nexport const theme = defineTokens(\n  \"theme\",\n  {\n    background: `light-dark(${color.white}, ${color.zinc950})`,\n    foreground: `light-dark(${color.zinc950}, ${color.zinc50})`,\n    card: `light-dark(${color.white}, ${color.zinc900})`,\n    border: `light-dark(${color.zinc200}, ${color.zinc800})`,\n    primary: `light-dark(${color.amber500}, ${color.amber400})`,\n  },\n  { variable: true }\n)","lang":"tsx","html":"<span class=\"th-token th-keyword\">import</span> { defineTokens } <span class=\"th-token th-keyword\">from</span> <span class=\"th-token th-string\">&quot;@kirana-style/core&quot;</span>\n<span class=\"th-token th-keyword\">import</span> { color } <span class=\"th-token th-keyword\">from</span> <span class=\"th-token th-string\">&quot;@kirana-style/preset-scales&quot;</span>\n\n<span class=\"th-token th-keyword\">export</span> <span class=\"th-token th-keyword\">const</span> theme = <span class=\"th-token th-function\">defineTokens</span>(\n  <span class=\"th-token th-string\">&quot;theme&quot;</span>,\n  {\n    <span class=\"th-token th-property\">background</span>: <span class=\"th-token th-string\">`light-dark(</span><span class=\"th-token th-operator\">${</span>color.<span class=\"th-token th-property\">white</span><span class=\"th-token th-operator\">}</span><span class=\"th-token th-string\">, </span><span class=\"th-token th-operator\">${</span>color.<span class=\"th-token th-property\">zinc950</span><span class=\"th-token th-operator\">}</span><span class=\"th-token th-string\">)`</span>,\n    <span class=\"th-token th-property\">foreground</span>: <span class=\"th-token th-string\">`light-dark(</span><span class=\"th-token th-operator\">${</span>color.<span class=\"th-token th-property\">zinc950</span><span class=\"th-token th-operator\">}</span><span class=\"th-token th-string\">, </span><span class=\"th-token th-operator\">${</span>color.<span class=\"th-token th-property\">zinc50</span><span class=\"th-token th-operator\">}</span><span class=\"th-token th-string\">)`</span>,\n    <span class=\"th-token th-property\">card</span>: <span class=\"th-token th-string\">`light-dark(</span><span class=\"th-token th-operator\">${</span>color.<span class=\"th-token th-property\">white</span><span class=\"th-token th-operator\">}</span><span class=\"th-token th-string\">, </span><span class=\"th-token th-operator\">${</span>color.<span class=\"th-token th-property\">zinc900</span><span class=\"th-token th-operator\">}</span><span class=\"th-token th-string\">)`</span>,\n    <span class=\"th-token th-property\">border</span>: <span class=\"th-token th-string\">`light-dark(</span><span class=\"th-token th-operator\">${</span>color.<span class=\"th-token th-property\">zinc200</span><span class=\"th-token th-operator\">}</span><span class=\"th-token th-string\">, </span><span class=\"th-token th-operator\">${</span>color.<span class=\"th-token th-property\">zinc800</span><span class=\"th-token th-operator\">}</span><span class=\"th-token th-string\">)`</span>,\n    <span class=\"th-token th-property\">primary</span>: <span class=\"th-token th-string\">`light-dark(</span><span class=\"th-token th-operator\">${</span>color.<span class=\"th-token th-property\">amber500</span><span class=\"th-token th-operator\">}</span><span class=\"th-token th-string\">, </span><span class=\"th-token th-operator\">${</span>color.<span class=\"th-token th-property\">amber400</span><span class=\"th-token th-operator\">}</span><span class=\"th-token th-string\">)`</span>,\n  },\n  { <span class=\"th-token th-property\">variable</span>: <span class=\"th-token th-literal\">true</span> }\n)"}},{"type":"paragraph","children":[{"type":"text","value":"Two decisions in that snippet, and both matter."}]},{"type":"heading","depth":2,"id":"every-colour-is-one-light-dark-pair","children":[{"type":"text","value":"Every colour is one "},{"type":"inlineCode","value":"light-dark()"},{"type":"text","value":" pair"}]},{"type":"paragraph","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-function\">light-dark</span>()","source":"light-dark()"}},{"type":"text","value":" resolves against the element's "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"color-scheme","source":"color-scheme"}},{"type":"text","value":", so one declaration\ncovers both schemes. There is no dark variant, no "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":".<span class=\"th-token th-property\">dark</span>","source":".dark"}},{"type":"text","value":" class, no duplicated\nblock, and no way for the two halves to drift apart — they are written on the same\nline."}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"// the whole story of this colour, in one place\ncard: `light-dark(${color.white}, ${color.zinc900})`","lang":"tsx","html":"<span class=\"th-token th-comment\">// the whole story of this colour, in one place</span>\n<span class=\"th-token th-property\">card</span>: <span class=\"th-token th-string\">`light-dark(</span><span class=\"th-token th-operator\">${</span>color.<span class=\"th-token th-property\">white</span><span class=\"th-token th-operator\">}</span><span class=\"th-token th-string\">, </span><span class=\"th-token th-operator\">${</span>color.<span class=\"th-token th-property\">zinc900</span><span class=\"th-token th-operator\">}</span><span class=\"th-token th-string\">)`</span>"}},{"type":"paragraph","children":[{"type":"text","value":"The application sets "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"color-scheme","source":"color-scheme"}},{"type":"text","value":" once, at the root\n("},{"type":"link","href":"/docs/tokens/themes-and-modes","children":[{"type":"text","value":"themes and modes"}]},{"type":"text","value":")."}]},{"type":"heading","depth":2,"id":"semantic-tokens-are-variables","children":[{"type":"text","value":"Semantic tokens are variables"}]},{"type":"paragraph","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"variable: true","source":"variable: true"}},{"type":"text","value":", because these are the values a theme overrides. Scales stay\ninlined: nobody re-themes "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"space<span class=\"th-token th-string\">[4]</span>","source":"space[4]"}},{"type":"text","value":"."}]},{"type":"heading","depth":2,"id":"intent-tokens-for-the-things-light-dark-cannot-hold","children":[{"type":"text","value":"Intent tokens for the things "},{"type":"inlineCode","value":"light-dark()"},{"type":"text","value":" cannot hold"}]},{"type":"paragraph","children":[{"type":"text","value":"Sometimes the two schemes differ in something that is not a colour: a shadow's\nstrength, an image filter, a blend mode. Those get per-mode values:"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"export const surface = defineTokens(\n  \"surface\",\n  {\n    imageDim: { light: \"none\", dark: \"brightness(0.8)\" },\n  },\n  { variable: true }\n)","lang":"tsx","html":"<span class=\"th-token th-keyword\">export</span> <span class=\"th-token th-keyword\">const</span> surface = <span class=\"th-token th-function\">defineTokens</span>(\n  <span class=\"th-token th-string\">&quot;surface&quot;</span>,\n  {\n    <span class=\"th-token th-property\">imageDim</span>: { <span class=\"th-token th-property\">light</span>: <span class=\"th-token th-string\">&quot;none&quot;</span>, <span class=\"th-token th-property\">dark</span>: <span class=\"th-token th-string\">&quot;brightness(0.8)&quot;</span> },\n  },\n  { <span class=\"th-token th-property\">variable</span>: <span class=\"th-token th-literal\">true</span> }\n)"}},{"type":"paragraph","children":[{"type":"text","value":"The same idea covers pairs where light and dark want "},{"type":"emphasis","children":[{"type":"text","value":"different roles"}]},{"type":"text","value":" rather than\ndifferent shades — a control that is a tint in light and a solid in dark. Naming\nthat intent once ("},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"surface.<span class=\"th-token th-property\">control</span>","source":"surface.control"}},{"type":"text","value":") beats repeating a conditional in every\ncomponent that needs it."}]},{"type":"heading","depth":2,"id":"deriving-values","children":[{"type":"text","value":"Deriving values"}]},{"type":"paragraph","children":[{"type":"text","value":"Tokens are constants, so deriving one from another is just an expression:"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"export const radius = defineTokens(\n  \"radius\",\n  {\n    base: \"0.625rem\",\n    sm: \"calc(0.625rem * 0.6)\",\n    lg: \"0.625rem\",\n    xl: \"calc(0.625rem * 1.4)\",\n  },\n  { variable: true }\n)\n\nexport const alpha = defineTokens(\"alpha\", {\n  primary20: `color-mix(in oklab, ${theme.primary} 20%, transparent)`,\n})","lang":"tsx","html":"<span class=\"th-token th-keyword\">export</span> <span class=\"th-token th-keyword\">const</span> radius = <span class=\"th-token th-function\">defineTokens</span>(\n  <span class=\"th-token th-string\">&quot;radius&quot;</span>,\n  {\n    <span class=\"th-token th-property\">base</span>: <span class=\"th-token th-string\">&quot;0.625rem&quot;</span>,\n    <span class=\"th-token th-property\">sm</span>: <span class=\"th-token th-string\">&quot;calc(0.625rem * 0.6)&quot;</span>,\n    <span class=\"th-token th-property\">lg</span>: <span class=\"th-token th-string\">&quot;0.625rem&quot;</span>,\n    <span class=\"th-token th-property\">xl</span>: <span class=\"th-token th-string\">&quot;calc(0.625rem * 1.4)&quot;</span>,\n  },\n  { <span class=\"th-token th-property\">variable</span>: <span class=\"th-token th-literal\">true</span> }\n)\n\n<span class=\"th-token th-keyword\">export</span> <span class=\"th-token th-keyword\">const</span> alpha = <span class=\"th-token th-function\">defineTokens</span>(<span class=\"th-token th-string\">&quot;alpha&quot;</span>, {\n  <span class=\"th-token th-property\">primary20</span>: <span class=\"th-token th-string\">`color-mix(in oklab, </span><span class=\"th-token th-operator\">${</span>theme.<span class=\"th-token th-property\">primary</span><span class=\"th-token th-operator\">}</span><span class=\"th-token th-string\"> 20%, transparent)`</span>,\n})"}},{"type":"paragraph","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"color-mix","source":"color-mix"}},{"type":"text","value":" with a variable token keeps the relationship live: re-theme\n"},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"theme.<span class=\"th-token th-property\">primary</span>","source":"theme.primary"}},{"type":"text","value":" and every tint follows."}]},{"type":"heading","depth":2,"id":"where-to-put-it","children":[{"type":"text","value":"Where to put it"}]},{"type":"paragraph","children":[{"type":"text","value":"One module, exported, imported by every component. In this repository it is\n"},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"packages/ui/src/theme/semantic.<span class=\"th-token th-property\">ts</span>","source":"packages/ui/src/theme/semantic.ts"}},{"type":"text","value":", and adding a colour is one line there rather\nthan a decision in each component."}]}],"headings":[{"id":"semantic-tokens","text":"Semantic tokens","level":1},{"id":"every-colour-is-one-light-dark-pair","text":"Every colour is one light-dark() pair","level":2},{"id":"semantic-tokens-are-variables","text":"Semantic tokens are variables","level":2},{"id":"intent-tokens-for-the-things-light-dark-cannot-hold","text":"Intent tokens for the things light-dark() cannot hold","level":2},{"id":"deriving-values","text":"Deriving values","level":2},{"id":"where-to-put-it","text":"Where to put it","level":2}]}
