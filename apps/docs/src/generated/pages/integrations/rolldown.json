{"type":"root","children":[{"type":"heading","depth":1,"id":"rolldown","children":[{"type":"text","value":"Rolldown"}]},{"type":"paragraph","children":[{"type":"text","value":"Rolldown on its own does not bundle CSS, so the adapter writes the stylesheet\nitself and your HTML links it. On Vite, which is Rolldown-backed and does bundle\nCSS, use "},{"type":"link","href":"/docs/integrations/vite","children":[{"type":"text","value":"the Vite plugin"}]},{"type":"text","value":" instead. Tested by\n"},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"examples/rolldown-react","source":"examples/rolldown-react"}},{"type":"text","value":"."}]},{"type":"component","name":"callout","tagName":"md-callout","attributes":{},"children":[{"type":"paragraph","children":[{"type":"text","value":"The packages are packed and install-tested on every change, but not published.\nUntil they are, install them from tarballs as\n"},{"type":"link","href":"/docs/start/installation#install-from-tarballs","children":[{"type":"text","value":"Installation"}]},{"type":"text","value":" shows; the rest\nof this page is the same either way."}]}],"properties":{"kind":"note","title":"Not on npm yet"}},{"type":"heading","depth":2,"id":"1-install","children":[{"type":"text","value":"1. Install"}]},{"type":"component","name":"install","attributes":{"packages":"@kirana-style/core","dev":"@kirana-style/rolldown"},"children":[]},{"type":"heading","depth":2,"id":"2-add-the-plugin","children":[{"type":"text","value":"2. Add the plugin"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"import kirana from \"@kirana-style/rolldown\"\nimport { defineConfig } from \"rolldown\"\n\nexport default defineConfig({\n  input: \"src/main.tsx\",\n  output: { dir: \"dist\" },\n  plugins: [kirana()],\n})","lang":"ts","html":"<span class=\"th-token th-keyword\">import</span> kirana <span class=\"