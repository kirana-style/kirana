{"type":"root","children":[{"type":"heading","depth":1,"id":"jest","children":[{"type":"text","value":"Jest"}]},{"type":"paragraph","children":[{"type":"text","value":"Jest runs no bundler, so Kirana is a transformer: it compiles a module's styles,\nthen hands it to the transformer you already use. Tests see the class names your\napp ships; no stylesheet is written. Tested by "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"examples/jest-react","source":"examples/jest-react"}},{"type":"text","value":". With\nVitest, "},{"type":"link","href":"/docs/integrations/vite","children":[{"type":"text","value":"the Vite plugin"}]},{"type":"text","value":" does this already."}]},{"type":"component","name":"callout","tagName":"md-callout","attributes":{},"children":[{"type":"paragraph","children":[{"type":"text","value":"The packages are packed and install-tested on every change, but not published.\nUntil they are, install them from tarballs as\n"},{"type":"link","href":"/docs/start/installation#install-from-tarballs","children":[{"type":"text","value":"Installation"}]},{"type":"text","value":" shows; the rest\nof this page is the same either way."}]}],"properties":{"kind":"note","title":"Not on npm yet"}},{"type":"heading","depth":2,"id":"1-install","children":[{"type":"text","value":"1. Install"}]},{"type":"component","name":"install","attributes":{"dev":"@kirana-style/jest"},"children":[]},{"type":"heading","depth":2,"id":"2-add-the-transformer","children":[{"type":"text","value":"2. Add the transformer"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"export default {\n  transform: {\n    \"\\\\.[jt]sx?$\": [\"@kirana-style/jest\", { transformer: \"babel-jest\" }],\n  },\n}","lang":"js","html":"export default {\n  <span class=\"th-token th-property\">transform</span>: {\n    &quot;\\\\.[jt]sx?$&quot;: [&quot;@kirana-style/jest&quot;, 