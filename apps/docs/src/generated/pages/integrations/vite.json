{"type":"root","children":[{"type":"heading","depth":1,"id":"vite","children":[{"type":"text","value":"Vite"}]},{"type":"paragraph","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"@kirana-style/vite","source":"@kirana-style/vite"}},{"type":"text","value":" is the adapter for Vite 8 and Rolldown. It owns a compiler session,\ncompiles the modules that carry styles, serves the stylesheet in development and\nwrites it in a build."}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"import kirana from \"@kirana-style/vite\"\n\nexport default defineConfig({\n  plugins: [kirana(), react()],\n})","lang":"ts","html":"<span class=\"th-token th-keyword\">import</span> kirana <span class=\"th-token th-keyword\">from</span> <span class=\"th-token th-string\">&quot;@kirana-style/vite&quot;</span>\n\n<span class=\"th-token th-keyword\">export</span> <span class=\"th-token th-keyword\">default</span> <span class=\"th-token th-function\">defineConfig</span>({\n  <span class=\"th-token th-property\">plugins</span>: [<span class=\"th-token th-function\">kirana</span>(), <span class=\"th-token th-function\">react</span>()],\n})","file":"vite.config.ts","title":"vite.config.ts"}},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Order matters."}]},{"type":"text","value":" Kirana runs "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"pre","source":"pre"}},{"type":"text","value":", before the framework plugin, so React (or\nanything else) only ever sees compiled JavaScript."}]},{"type":"heading","depth":2,"id":"options","children":[{"type":"text","value":"Options"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"kirana({\n  // Overrides kirana.config.ts, key by key.\n  config: { names: { prefix: \"app\" } },\n  // Surface info-level diagnostics (bridged values, lowered targets) in the terminal.\n  reportInfo: true,\n})","lang":"ts","html":"<span class=\"th-token th-function\">kirana</span>({\n  <span class=\"th-token th-comment\">// Overrides kirana.config.ts, key by key.</span>\n  <span class=\"th-token th-property\">config</span>: { <span class=\"th-token th-property\">names</span>: { <span class=\"th-token th-property\">prefix</span>: <span class=\"th-token th-string\">&quot;app&quot;</span> } },\n  <span class=\"th-token th-comment\">// Surface info-level diagnostics (bridged values, lowered targets) in the terminal.</span>\n  <span class=\"th-token th-property\">reportInfo</span>: <span class=\"th-token th-literal\">true</span>,\n})"}},{"type":"paragraph","children":[{"type":"text","value":"Both are optional, and most projects pass nothing: the plugin finds\n"},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"kirana.<span class=\"th-token th-property\">config</span>.*","source":"kirana.config.*"}},{"type":"text","value":" in the Vite root on its own."}]},{"type":"heading","depth":2,"id":"which-modules-it-compiles","children":[{"type":"text","value":"Which modules it compiles"}]},{"type":"paragraph","children":[{"type":"text","value":"Script files only — "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":".<span class=\"th-token th-property\">ts</span>","source":".ts"}},{"type":"text","value":", "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":".<span class=\"th-token th-property\">tsx</span>","source":".tsx"}},{"type":"text","value":", "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":".<span class=\"th-token th-property\">js</span>","source":".js"}},{"type":"text","value":", "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":".<span class=\"th-token th-property\">jsx</span>","source":".jsx"}},{"type":"text","value":", "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":".<span class=\"th-token th-property\">mts</span>","source":".mts"}},{"type":"text","value":", "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":".<span class=\"th-token th-property\">mjs</span>","source":".mjs"}},{"type":"text","value":" — outside\n"},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"node_modules","source":"node_modules"}},{"type":"text","value":", and only when the text contains "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"@kirana-style/","source":"@kirana-style/"}},{"type":"text","value":" or an "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"sx","source":"sx"}},{"type":"text","value":" attribute.\nThat prefilter is why adding Kirana to a large application does not slow the build\ndown in proportion to its size."}]},{"type":"paragraph","children":[{"type":"text","value":"Markdown, HTML and other assets are never compiled, so "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"sx","source":"sx"}},{"type":"text","value":" written there does\nnothing."}]},{"type":"heading","depth":2,"id":"the-stylesheet","children":[{"type":"text","value":"The stylesheet"}]},{"type":"paragraph","children":[{"type":"text","value":"Import the entry once:"}]},{"type":"component","