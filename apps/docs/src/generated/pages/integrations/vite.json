],"properties":{"html":"?url","source":"?url"}},{"type":"text","value":", "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"?raw","source":"?raw"}},{"type":"text","value":" and "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"?inline","source":"?inline"}},{"type":"text","value":" behave the way they do for any other Vite asset."}]},{"type":"heading","depth":2,"id":"diagnostics-in-the-terminal","children":[{"type":"text","value":"Diagnostics in the terminal"}]},{"type":"paragraph","children":[{"type":"text","value":"Errors fail the build; warnings print with their file, line and help text. Info\ndiagnostics are quiet unless you pass "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-property\">reportInfo</span>: <span class=\"th-token th-literal\">true</span>","source":"reportInfo: true"}},{"type":"text","value":" — useful when you want to\nsee every runtime bridge in an application."}]},{"type":"heading","depth":2,"id":"rolldown","children":[{"type":"text","value":"Rolldown"}]},{"type":"paragraph","children":[{"type":"text","value":"Vite 8 is Rolldown-backed, and the plugin uses Rolldown's filters, so a\nRolldown-only setup works the same way."}]}],"headings":[{"id":"vite","text":"Vite","level":1},{"id":"options","text":"Options","level":2},{"id":"which-modules-it-compiles","text":"Which modules it compiles","level":2},{"id":"the-stylesheet","text":"The stylesheet","level":2},{"id":"diagnostics-in-the-terminal","text":"Diagnostics in the terminal","level":2},{"id":"rolldown","text":"Rolldown","level":2}]}
