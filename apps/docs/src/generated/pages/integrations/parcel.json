{"type":"root","children":[{"type":"heading","depth":1,"id":"parcel","children":[{"type":"text","value":"Parcel"}]},{"type":"paragraph","children":[{"type":"text","value":"Parcel runs transformers in worker processes, with no step that sees every\nmodule. So the work is split as for Next.js on Turbopack: a transformer rewrites\nthe styles in each script into class names, and the PostCSS plugin compiles the\nwhole project into the stylesheet. Tested on every change by "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"examples/parcel","source":"examples/parcel"}},{"type":"text","value":",\nbuilt and on "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"parcel serve","source":"parcel serve"}},{"type":"text","value":"."}]},{"type":"component","name":"npm-status","attributes":{},"children":[]},{"type":"heading","depth":2,"id":"1-install","children":[{"type":"text","value":"1. Install"}]},{"type":"component","name":"install","attributes":{"packages":"@kirana-style/core","dev":"@kirana-style/parcel-transformer @kirana-style/postcss postcss"},"children":[]},{"type":"heading","depth":2,"id":"2-add-the-transformer","children":[{"type":"text","value":"2. Add the transformer"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"{\n  \"extends\": \"@parcel/config-default\",\n  \"transformers\": {\n    \"*.{js,mjs,jsx,ts,tsx}\": [\"@kirana-style/parcel-transformer\", \"...\"]\n  }\n}","lang":"json","html":"{\n  <span class=\"th-token th-property\">&quot;extends&quot;</span>: <span class=\"th-token th-string\">&quot;@parcel/config-default&quot;</span>,\n  <span class=\"th-token th-property\">&quot;transformers&quot;</span>: {\n    <span class=\"th-token th-property\">&quot;*.{js,mjs,jsx,ts,tsx}&quot;</span>: [<span class=\"th-token th-string\">&quot;@kirana-style/parcel-transformer&quot;</span>, <span class=\"th-token th-string\">&quot;...&quot;</span>]\n  }\n}","file":".parcelrc","title":".parcelrc"}},{"type":"heading","depth":2,"id":"3-add-the-postcss-plugin-and-mark-the-stylesheet","children":[{"type":"text","value":"3. Add the PostCSS plugin and mark the stylesheet"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"{ \"plugins\": { \"@kirana-style/postcss\": {} } }","lang":"json","html":"{ <span class=\"th-token th-property\">&quot;plugins&quot;</span>: { <span class=\"th-token th-property\">&quot;@kirana-style/postcss&quot;</span>: {} } }","file":".postcssrc","title":".postcssrc"}},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"@kirana;","lang":"css","html":"@kirana;","file":"src/kirana.css","title":"src/kirana.css"}},{"type":"paragraph","children":[{"type":"text","value":"Link that stylesheet from your HTML, as any other."}]},{"type":"heading","depth":2,"id":"next","children":[{"type":"text","value":"Next"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"/docs/integrations/postcss","children":[{"type":"text","value":"PostCSS"}]},{"type":"text","value":", and its options."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"/docs/integrations/bundlers","children":[{"type":"text","value":"Every bundler"}]},{"type":"text","value":"."}]}]}]}],"headings":[{"id":"parcel","text":"Parcel","level":1},{"id":"1-install","text":"1. Install","level":2},{"id":"2-add-the-transformer","text":"2. Add the transformer","level":2},{"id":"3-add-the-postcss-plugin-and-mark-the-stylesheet","text":"3. Add the PostCSS plugin and mark the stylesheet","level":2},{"id":"next","text":"Next","level":2}]}
