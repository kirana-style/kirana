{"type":"root","children":[{"type":"heading","depth":1,"id":"webpack","children":[{"type":"text","value":"webpack"}]},{"type":"paragraph","children":[{"type":"text","value":"The plugin adds its loader in front of your own ("},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-property\">enforce</span>: <span class=\"th-token th-string\">&quot;pre&quot;</span>","source":"enforce: \"pre\""}},{"type":"text","value":"), so it reads\n"},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"sx","source":"sx"}},{"type":"text","value":" before your JSX compiler (swc or Babel) compiles it away, and writes the\nfinished stylesheet once every module is built. Tested by\n"},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"examples/webpack-react","source":"examples/webpack-react"}},{"type":"text","value":". Next.js has "},{"type":"link","href":"/docs/frameworks/nextjs","children":[{"type":"text","value":"its own guide"}]},{"type":"text","value":",\nand Gatsby, which runs webpack, "},{"type":"link","href":"/docs/frameworks/gatsby","children":[{"type":"text","value":"its own too"}]},{"type":"text","value":"."}]},{"type":"component","name":"npm-status","attributes":{},"children":[]},{"type":"heading","depth":2,"id":"1-install","children":[{"type":"text","value":"1. Install"}]},{"type":"component","name":"install","attributes":{"packages":"@kirana-style/core","dev":"@kirana-style/webpack"},"children":[]},{"type":"heading","depth":2,"id":"2-add-the-plugin","children":[{"type":"text","value":"2. Add the plugin"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"import { KiranaPlugin } from \"@kirana-style/webpack\"\n\nexport default {\n  // Webpack's native CSS, or css-loader with mini-css-extract-plugin.\n  experiments: { css: true },\n  plugins: [new KiranaPlugin()],\n}","lang":"js","html":"import { KiranaPlugin } from &quot;@kirana-style/webpack&quot;\n\nexport default {\n  // Webpack&#39;s native CSS, or css-loader with mini-css-extract-plugin.\n  <span class=\"th-token th-property\">experiments</span>: { <span class=\"th-token th-property\">css</span>: true },\n  <span class=\"th-token th-property\">plugins</span>: [new <span class=\"th-token th-function\">KiranaPlugin</span>()],\n}","file":"webpack.config.js","title":"webpack.config.js"}},{"type":"heading","depth":2,"id":"3-import-the-stylesheet","children":[{"type":"text","value":"3. Import the stylesheet"}]},{"type":"component","name":"code","tagName":"md-code","attributes":{},"children":[],"properties":{"source":"import \"@kirana-style/core/stylesheet.css\"","lang":"ts","html":"<span class=\"th-token th-keyword\">import</span> <span class=\"th-token th-string\">&quot;@kirana-style/core/stylesheet.css&quot;</span>","file":"src/main.tsx","title":"src/main.tsx"}},{"type":"paragraph","children":[{"type":"text","value":"The stylesheet entry is ordinary CSS to webpack: it names, links and minifies it\nlike any other. The plugin fills it in before the minifier runs and before\n"},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"realContentHash","source":"realContentHash"}},{"type":"text","value":" names the file after its real content, which is on by default\nin production; turn it off and the file name stops tracking the styles."}]},{"type":"heading","depth":2,"id":"next","children":[{"type":"text","value":"Next"}]},{"type":"list","ordered":false,"items":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"/docs/styling/styles","children":[{"type":"text","value":"Styles"}]},{"type":"text","value":" and "},{"type":"link","href":"/docs/styling/conditions","children":[{"type":"text","value":"conditions"}]},{"type":"text","value":"."}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"link","href":"/docs/integrations/bundlers","children":[{"type":"text","value":"Every bundler"}]},{"type":"text","value":"."}]}]}]}],"headings":[{"id":"webpack","text":"webpack","level":1},{"id":"1-install","text":"1. Install","level":2},{"id":"2-add-the-plugin","text":"2. Add the plugin","level":2},{"id":"3-import-the-stylesheet","text":"3. Import the stylesheet","level":2},{"id":"next","text":"Next","level":2}]}
