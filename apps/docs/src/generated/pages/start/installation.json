{"type":"root","children":[{"type":"heading","depth":1,"id":"installation","children":[{"type":"text","value":"Installation"}]},{"type":"heading","depth":2,"id":"let-kirana-style-init-do-it","children":[{"type":"text","value":"Let "},{"type":"inlineCode","value":"kirana-style init"},{"type":"text","value":" do it"}]},{"type":"paragraph","children":[{"type":"text","value":"In your project's root, through your package manager's runner. It fetches the\ncommand for this one run, the way "},{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-command\">npx</span> shadcn@latest","source":"npx shadcn@latest"}},{"type":"text","value":" does, and writes nothing\nuntil you say yes:"}]},{"type":"table","align":[null,null],"header":[{"type":"tableCell","children":[{"type":"text","value":"Package manager"}]},{"type":"tableCell","children":[{"type":"text","value":"First run"}]}],"rows":[[{"type":"tableCell","children":[{"type":"text","value":"npm"}]},{"type":"tableCell","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-command\">npx</span> kirana-style@latest init","source":"npx kirana-style@latest init"}}]}],[{"type":"tableCell","children":[{"type":"text","value":"pnpm"}]},{"type":"tableCell","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-command\">pnpm</span> dlx kirana-style@latest init","source":"pnpm dlx kirana-style@latest init"}}]}],[{"type":"tableCell","children":[{"type":"text","value":"Yarn"}]},{"type":"tableCell","children":[{"type":"inlineComponent","name":"inline-code","tagName":"md-inline-code","attributes":{},"children":[],"properties":{"html":"<span class=\"th-token th-command\">yarn</span> dlx kirana-style@latest init","source":"yarn dlx k