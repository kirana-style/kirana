{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kirana.style/schema/lockfile.json",
  "title": "Kirana lockfile",
  "type": "object",
  "required": [
    "lockfileVersion",
    "items"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "lockfileVersion": {
      "const": 1
    },
    "items": {
      "type": "object",
      "patternProperties": {
        "^@[a-z0-9]+(-[a-z0-9]+)*/[a-z0-9]+(-[a-z0-9]+)*$": {
          "type": "object",
          "required": [
            "registry",
            "version",
            "files"
          ],
          "properties": {
            "registry": {
              "type": "string",
              "description": "The registry's URL template the item came from.",
              "minLength": 1
            },
            "version": {
              "$ref": "#/$defs/version"
            },
            "framework": {
              "type": "string",
              "enum": [
                "react",
                "vue",
                "svelte",
                "solid",
                "angular"
              ]
            },
            "base": {
              "$ref": "#/$defs/name"
            },
            "design": {
              "type": "string",
              "description": "The preset code the item was flattened for.",
              "minLength": 1
            },
            "files": {
              "type": "object",
              "description": "Each installed file, by its path in the project.",
              "patternProperties": {
                "^.+$": {
                  "type": "object",
                  "required": [
                    "source",
                    "written"
                  ],
                  "properties": {
                    "source": {
                      "$ref": "#/$defs/hash"
                    },
                    "written": {
                      "$ref": "#/$defs/hash"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "installed": {
      "type": "string",
      "description": "An installed file, as its imports name it: `@/registry/<type>/<path>`.",
      "pattern": "^@/registry/(ui|lib|component|hook|page)/.+$"
    },
    "export": {
      "type": "object",
      "required": [
        "module",
        "export"
      ],
      "properties": {
        "module": {
          "$ref": "#/$defs/installed"
        },
        "export": {
          "type": "string",
          "pattern": "^[A-Za-z_$][\\w$]*$"
        }
      },
      "additionalProperties": false
    },
    "reference": {
      "type": "string",
      "description": "An item: `name` in the same registry, or `@namespace/name`.",
      "pattern": "^(@[a-z0-9]+(-[a-z0-9]+)*/)?[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "description": "A semantic version.",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "hash": {
      "type": "string",
      "description": "`sha256-` and the base64 SHA-256 of the content's UTF-8 bytes, as subresource integrity writes it.",
      "pattern": "^sha256-[A-Za-z0-9+/]{43}=$"
    },
    "packages": {
      "type": "object",
      "description": "npm packages, by name, and the version ranges the item was built with.",
      "patternProperties": {
        "^(@[^/\\s]+/)?[^/\\s]+$": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "file": {
      "type": "object",
      "required": [
        "path",
        "type",
        "content",
        "hash"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "Relative to the place `type` names: `button.tsx` under the `ui` alias.",
          "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"
        },
        "type": {
          "type": "string",
          "enum": [
            "ui",
            "component",
            "lib",
            "hook",
            "page",
            "file"
          ]
        },
        "target": {
          "type": "string",
          "description": "A `file`'s place in the project, relative to its root.",
          "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"
        },
        "content": {
          "type": "string"
        },
        "hash": {
          "$ref": "#/$defs/hash"
        }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "base": {
      "type": "object",
      "required": [
        "files"
      ],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "dependencies": {
          "$ref": "#/$defs/packages"
        },
        "registryDependencies": {
          "type": "array",
          "description": "Items only this base needs, beside the item's own.",
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      },
      "additionalProperties": false
    },
    "framework": {
      "type": "object",
      "description": "The framework's bases, by name: `base`, `aria`, `ark` …",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z0-9]+(-[a-z0-9]+)*$": {
          "$ref": "#/$defs/base"
        }
      },
      "additionalProperties": false
    }
  }
}
