{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kirana.style/schema/settings.json",
  "title": "Kirana ui settings",
  "type": "object",
  "properties": {
    "framework": {
      "type": "string",
      "description": "The framework whose markup `ui add` installs.",
      "enum": [
        "react",
        "vue",
        "svelte",
        "solid",
        "angular"
      ]
    },
    "base": {
      "type": "string",
      "description": "The base whose markup `ui add` installs: `base`, `aria`, `ark` …",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "iconLibrary": {
      "type": "string",
      "description": "The library `ui add` draws each `<IconPlaceholder>` with.",
      "enum": [
        "lucide",
        "tabler",
        "hugeicons",
        "phosphor",
        "remixicon"
      ]
    },
    "design": {
      "type": "object",
      "description": "The design system's axis values the project uses, which `ui preset` writes.",
      "patternProperties": {
        "^[A-Za-z][A-Za-z0-9]*$": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "aliases": {
      "type": "object",
      "description": "The import specifier for each file type, which the project's tsconfig.json maps to a directory.",
      "properties": {
        "ui": {
          "type": "string",
          "minLength": 1
        },
        "lib": {
          "type": "string",
          "minLength": 1
        },
        "component": {
          "type": "string",
          "minLength": 1
        },
        "hook": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "registries": {
      "type": "object",
      "description": "Registries by namespace: a URL template holding {name}, or { url, headers }.",
      "patternProperties": {
        "^@[a-z0-9]+(-[a-z0-9]+)*$": {
          "$ref": "#/$defs/registry"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "template": {
      "type": "string",
      "description": "A URL, a path or a file: URL holding {name}, the item's name.",
      "pattern": "\\{name\\}"
    },
    "registry": {
      "anyOf": [
        {
          "$ref": "#/$defs/template"
        },
        {
          "type": "object",
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "$ref": "#/$defs/template"
            },
            "headers": {
              "type": "object",
              "description": "HTTP headers, each value able to read the environment as ${NAME}.",
              "patternProperties": {
                "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
