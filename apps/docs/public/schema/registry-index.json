{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kirana.style/schema/registry-index.json",
  "title": "Kirana registry index",
  "type": "object",
  "required": [
    "items"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "homepage": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type",
          "version"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/name"
          },
          "type": {
            "type": "string",
            "enum": [
              "component",
              "block",
              "chart",
              "lib",
              "hook",
              "font",
              "design-system"
            ]
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "version": {
            "$ref": "#/$defs/version"
          },
          "frameworks": {
            "type": "object",
            "properties": {
              "react": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/name"
                }
              },
              "vue": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/name"
                }
              },
              "svelte": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/name"
                }
              },
              "solid": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/name"
                }
              },
              "angular": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/name"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "installed": {
      "type": "string",
      "description": "An installed file, as its imports name it: `@/registry/<type>/<path>`.",
      "pattern": "^@/registry/(ui|lib|component|hook|page)/.+$"
    },
    "export": {
      "type": "object",
      "required": [
        "module",
        "export"
      ],
      "properties": {
        "module": {
          "$ref": "#/$defs/installed"
        },
        "export": {
          "type": "string",
          "pattern": "^[A-Za-z_$][\\w$]*$"
        }
      },
      "additionalProperties": false
    },
    "reference": {
      "type": "string",
      "description": "An item: `name` in the same registry, or `@namespace/name`.",
      "pattern": "^(@[a-z0-9]+(-[a-z0-9]+)*/)?[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "description": "A semantic version.",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "hash": {
      "type": "string",
      "description": "`sha256-` and the base64 SHA-256 of the content's UTF-8 bytes, as subresource integrity writes it.",
      "pattern": "^sha256-[A-Za-z0-9+/]{43}=$"
    },
    "packages": {
      "type": "object",
      "description": "npm packages, by name, and the version ranges the item was built with.",
      "patternProperties": {
        "^(@[^/\\s]+/)?[^/\\s]+$": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "file": {
      "type": "object",
      "required": [
        "path",
        "type",
        "content",
        "hash"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "Relative to the place `type` names: `button.tsx` under the `ui` alias.",
          "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"
        },
        "type": {
          "type": "string",
          "enum": [
            "ui",
            "component",
            "lib",
            "hook",
            "page",
            "file"
          ]
        },
        "target": {
          "type": "string",
          "description": "A `file`'s place in the project, relative to its root.",
          "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"
        },
        "content": {
          "type": "string"
        },
        "hash": {
          "$ref": "#/$defs/hash"
        }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "base": {
      "type": "object",
      "required": [
        "files"
      ],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "dependencies": {
          "$ref": "#/$defs/packages"
        },
        "registryDependencies": {
          "type": "array",
          "description": "Items only this base needs, beside the item's own.",
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      },
      "additionalProperties": false
    },
    "framework": {
      "type": "object",
      "description": "The framework's bases, by name: `base`, `aria`, `ark` …",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z0-9]+(-[a-z0-9]+)*$": {
          "$ref": "#/$defs/base"
        }
      },
      "additionalProperties": false
    }
  }
}
