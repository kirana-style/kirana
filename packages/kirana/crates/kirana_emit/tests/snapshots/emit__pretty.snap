---
source: crates/kirana_emit/tests/emit.rs
expression: output.css
---
@layer reset, base, kirana;
@layer kirana.tokens, kirana.themes, kirana.contextual, kirana.atoms;
@layer kirana.tokens {
  :root {
    --kvBlend: darken;
    --kvRing: oklch(0.7 0 0);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --kvBlend: lighten;
    }
  }
  .km-light {
    --kvBlend: darken;
  }
  .km-dark {
    --kvBlend: lighten;
  }
  @keyframes kfSpin {
    to {
      transform: rotate(360deg);
    }
  }
}
@layer kirana.themes {
  .ktBrand {
    --kvRing: orange;
    --kvBlend: multiply;
  }
  @media (prefers-color-scheme: dark) {
    .ktBrand {
      --kvBlend: screen;
    }
  }
  .km-light .ktBrand, .km-light.ktBrand {
    --kvBlend: multiply;
  }
  .km-dark .ktBrand, .km-dark.ktBrand {
    --kvBlend: screen;
  }
  .ktPlain {
    --kvRing: red;
  }
}
@layer kirana.contextual {
  .kaF-C9M_EOeu :where(svg) {
    width: 1rem;
  }
  .kaF-YI1-KFHz_5QUl:where(:hover) > :where([data-slot="icon"])::before {
    width: 2rem;
  }
}
@layer kirana.atoms {
  .k3O_sdmr {
    animation-name: kfSpin;
  }
  .k50_W0yl {
    color: black;
  }
  .k7X_B2ie {
    mix-blend-mode: var(--kvBlend);
  }
  @media (width >= 48rem) {
    .k4-0w85_EOeu {
      padding-top: 1rem;
    }
    .k5O-0w85_u3uh {
      display: block;
    }
  }
  .k5O-iC99_Im6t:where(:has(~ .krPeer)) {
    display: none;
  }
  .k87-6s8r_ufrO:where(.krField[data-disabled] *) {
    opacity: 0.5;
  }
  .k50-KFHz_jxzc:where(:hover) {
    color: var(--kvRing);
  }
  .k5n-aje-HDyY_57fc:where([data-swipe="up"])::after {
    content: '';
  }
  @supports (display: grid) {
    @media (width >= 64rem) {
      @container card (min-width: 20rem) {
        .k4-FuNC_5QUl {
          padding-top: 2rem;
        }
      }
    }
  }
  .k5O-CD81_u3uh:where(.krPeer:checked ~ *:focus[data-x]) {
    display: block;
  }
}
