import { css } from "@kirana-style/core"

const row = css({
  display: "flex",
  gap: "4px",
})
const strong = css({
  fontWeight: 700,
})

export function Row({ on }: { on: boolean }) {
  return (
    <div sx={[row, on && strong]}>
      <span sx={css({
        color: "#71717a",
      })}>Label</span>
    </div>
  )
}
