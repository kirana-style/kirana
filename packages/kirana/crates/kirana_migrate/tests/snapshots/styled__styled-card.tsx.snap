expression: migration.source
---
import { css, keyframes, type Sx } from "@kirana-style/core"
import type { ComponentProps } from "react"

const spin = keyframes({
  from: {
    rotate: "0deg",
  },
  to: {
    rotate: "360deg",
  },
})

const surface = css({
  padding: "16px",
  borderRadius: "8px",
  boxShadow: { ":hover": "0 1px 2px #0002" },
})

const cardStyle = css({
  display: "grid",
  gap: { base: "12px", "@media (min-width: 640px)": "16px" },
})

const Card = ({ sx, ...props }: { accent: string } & ComponentProps<"section"> & { sx?: Sx }) => <section {...props} sx={[cardStyle, css({ borderColor: props.accent }), sx]} />

const titleStyle = css({
  fontSize: "1.5rem",
  lineHeight: 1.25,
  margin: 0,
})

const Title = ({ sx, ...props }: ComponentProps<"h2"> & { sx?: Sx }) => <h2 {...props} sx={[titleStyle, sx]} />

export function Panel({ accent, busy }: { accent: string; busy: boolean }) {
  return (
    <Card accent={accent} sx={[surface, busy && css({
      animation: `${spin} 1s linear infinite`,
    })]}>
      <Title sx={css({
        color: accent,
        textDecorationLine: { ":hover": "underline" },
      })}>Usage</Title>
      <p
        sx={css({
          margin: "0",
          color: "#52525b",
        })}
      >
        Updated hourly.
      </p>
    </Card>
  )
}
