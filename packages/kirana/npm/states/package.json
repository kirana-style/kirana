{
  "name": "@kirana-style/states",
  "version": "0.3.2",
  "description": "Component states as Kirana condition keys: each part's data attributes, typed, generated from the UI library's own declarations, for Base UI, Ark UI, React Aria, Reka UI, Bits UI and Angular Primitives.",
  "license": "MIT",
  "author": "The Kirana authors",
  "homepage": "https://kirana.style",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kirana-style/kirana.git",
    "directory": "packages/kirana/npm/states"
  },
  "bugs": {
    "url": "https://github.com/kirana-style/kirana/issues"
  },
  "type": "module",
  "sideEffects": false,
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.ts",
    "./base-ui": "./src/base-ui.ts",
    "./ark-ui": "./src/ark-ui.ts",
    "./react-aria": "./src/react-aria.ts",
    "./reka-ui": "./src/reka-ui.ts",
    "./bits-ui": "./src/bits-ui.ts",
    "./ng-primitives": "./src/ng-primitives.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@kirana-style/core": "workspace:*"
  },
  "peerDependencies": {
    "@ark-ui/react": ">=5.39.3",
    "@base-ui/react": ">=1.9.0",
    "react-aria-components": ">=1.22.1"
  },
  "peerDependenciesMeta": {
    "@ark-ui/react": {
      "optional": true
    },
    "@base-ui/react": {
      "optional": true
    },
    "react-aria-components": {
      "optional": true
    }
  }
