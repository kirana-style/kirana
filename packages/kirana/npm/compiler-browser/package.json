  "description": "The Kirana engine in a browser: WebAssembly with an in-memory project, for playgrounds and editors on the web.",
  "license": "MIT",
  "author": "The Kirana authors",
  "homepage": "https://kirana.style",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kirana-style/kirana.git",
    "directory": "packages/kirana/npm/compiler-browser"
  },
  "bugs": {
    "url": "https://github.com/kirana-style/kirana/issues"
  },
  "type": "module",
  "sideEffects": false,
  "private": true,
