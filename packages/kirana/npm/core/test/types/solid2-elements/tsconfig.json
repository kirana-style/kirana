{
  // Solid 2, installed as `solid-js-2` and `solidjs-web-2`, under their own names: its JSX is its
  // DOM runtime's (KF-127). Library files are checked too.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "verbatimModuleSyntax": true,
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "paths": {
      "solid-js": ["../../../../../node_modules/solid-js-2/types/index.d.ts"],
      "@solidjs/web": [
        "../../../../../node_modules/solidjs-web-2/types/index.d.ts"
      ],
      "@solidjs/web/jsx-runtime": [
        "../../../../../node_modules/solidjs-web-2/types/jsx.d.ts"
      ]
    },
    "types": ["@kirana-style/core/solid"]
  },
  "include": ["case.tsx"]
}
