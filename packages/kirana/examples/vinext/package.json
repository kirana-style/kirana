  },
  "devDependencies": {
    "@kirana-style/vite": "0.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
