{
  "name": "kirana-example-webpack-react",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "webpack --mode production"
  },
  "kirana-example": {
    "dev": [
      "webpack",
      "serve",
      "--mode",
      "development",
      "--port",
