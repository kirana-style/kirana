{
  "name": "kirana-example-vike",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vike build"
  },
  "kirana-example": {
    "output": "dist/client",
    "dev": [
      "vike",
      "dev",
      "--port",
      "{port}",
      "--strictPort",
      "--host",
      "127.0.0.1"
    ],
    "edit": "pages/index/+Page.tsx"
  },
  "dependencies": {
    "@kirana-style/core": "0.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vike": "^0.4.268",
    "vike-react": "^0.6.31"
  },
  "devDependencies": {
    "@kirana-style/vite": "0.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
