{
  "name": "kirana-example-vite-vue",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit"
  },
  "kirana-example": {
    "dev": [
      "vite",
      "--port",
      "{port}",
      "--strictPort",
      "--host",
