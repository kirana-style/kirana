    ],
    "edit": "src/Probe.vue",
    "hot": true
  },
  "dependencies": {
    "@kirana-style/core": "0.1.0",
    "@kirana-style/states": "0.1.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@kirana-style/vite": "0.1.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.13"
  }
}
