    "waku": "1.0.0-rc.3"
  },
  "devDependencies": {
    "@kirana-style/vite": "0.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
