{
  "name": "kirana-example-phoenix",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "kirana-style build resources/styles --out priv/static/kirana/kirana.css --minify",
    "start": "mix run --no-halt"
  },
  "kirana-example": {
    "output": "priv/static/kirana",
    "prepare": [
      [
        "mix",
        "deps.get"
      ],
      [
        "mix",
        "compile"
      ]
    ],
    "dev": [
      "mix",
      "run",
      "--no-halt"
    ],
    "devAlso": [
      "kirana",
      "dev",
      "resources/styles",
      "--out",
      "priv/static/kirana/kirana.css"
    ],
    "reloads": true,
    "edit": "resources/styles/app.styles.ts"
  },
  "dependencies": {
    "@kirana-style/core": "0.1.0"
  },
  "devDependencies": {
    "kirana-style": "0.1.0"
  }
}
