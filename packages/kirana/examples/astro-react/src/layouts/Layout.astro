---
import "@kirana-style/core/stylesheet.css"

/** The layout every page renders in: the root document, which `kirana-style ui init` sets up. */
const { title } = Astro.props
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
