{
  "name": "kirana-example-angular-cli",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "ng build"
  },
  "kirana-example": {
    "output": "dist/app/browser",
    "dev": [
      "ng",
      "serve",
      "--port",
      "{port}",
      "--host",
      "127.0.0.1"
    ],
    "edit": "src/app/app.ts"
  },
  "dependencies": {
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@kirana-style/angular": "0.1.0",
    "@kirana-style/core": "0.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "typescript": "~6.0.0"
  }
}
