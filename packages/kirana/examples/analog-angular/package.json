{
  "name": "kirana-example-analog-angular",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build"
  },
  "kirana-example": {
    "output": "dist/analog/public",
    "dev": [
      "vite",
      "--port",
      "{port}",
      "--strictPort",
      "--host",
      "127.0.0.1"
    ],
    "edit": "src/app/pages/index.page.ts"
  },
  "dependencies": {
    "@analogjs/router": "^2.8.0",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/platform-server": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@kirana-style/angular": "0.1.0",
    "@kirana-style/core": "0.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/platform": "^2.8.0",
    "@analogjs/vite-plugin-angular": "^2.8.0",
    "@angular/build": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "typescript": "~6.0.0",
    "vite": "^8.3.0",
    "@kirana-style/vite": "0.1.0"
  }
