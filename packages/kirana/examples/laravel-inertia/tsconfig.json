{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": { "@/*": ["./resources/js/*"] },
    "types": ["vite/client", "@kirana-style/core/react"]
  },
  "include": ["resources/js"]
}
