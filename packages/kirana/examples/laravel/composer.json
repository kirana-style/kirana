{
  "name": "kirana/example-laravel",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.17",
    "kirana-style/kirana": "@dev"
  },
  "repositories": [
    {
      "type": "path",
      "url": "{kirana}/helpers/php",
      "options": {
        "symlink": false
      }
    }
  ],
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
