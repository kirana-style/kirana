{
  "name": "@kirana-style/workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kirana: the Rust engine, npm packages, template helpers, editor extensions, fixtures and examples.",
  "license": "MIT",
  "scripts": {
    "gen:css-data": "bun scripts/gen-css-data.ts",
    "test": "vp test run",
    "check": "bun run check:rust && bun run test:rust && bun run test",
    "check:rust": "bun scripts/rust.ts \"cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && cargo deny check\"",
    "check:zed": "cd editors/zed && bun ../../scripts/rust.ts \"cargo fmt --check && cargo clippy --all-targets -- -D warnings && cargo test\"",
    "test:rust": "bun scripts/rust.ts \"cargo nextest run --workspace\"",
    "coverage": "bun scripts/rust.ts scripts/coverage.sh",
    "migrate:stylex": "bun scripts/migrate-stylex.ts",
    "gen:preset-scales": "bun scripts/gen-preset-scales.ts",
    "gen:states": "bun scripts/gen-states.ts",
    "budget": "node scripts/runtime-budget.ts",
    "budgets": "node scripts/budgets.ts",
    "pack": "bun scripts/pack.ts",
    "example": "bun examples/run.ts"
  },
  "devDependencies": {
    "mdn-data": "2.37.2",
    "vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxc-transform": "0.155.0",
    "oxc-minify": "0.155.0",
    "@napi-rs/cli": "catalog:",
    "@types/node": "catalog:",
    "vite": "catalog:",
    "@kirana-style/vite": "workspace:*",
    "@kirana-style/compiler": "workspace:*",
    "@kirana-style/core": "workspace:*",
    "react": "catalog:",
    "@types/react": "catalog:",
    "oxc-parser": "0.155.0",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "tailwindcss": "4.3.3",
    "@base-ui/react": "1.9.0",
    "@ark-ui/react": "5.39.3",
    "@zag-js/docs": "1.46.0",
    "react-aria-components": "1.22.1",
    "reka-ui": "2.11.0",
    "bits-ui": "2.20.2",
    "ng-primitives": "0.131.3",
    "vue": "catalog:",
    "svelte": "catalog:",
    "@astrojs/compiler": "catalog:",
    "@astrojs/compiler-rs": "catalog:",
    "emnapi": "catalog:",
    "@emnapi/core": "catalog:",
    "@emnapi/runtime": "catalog:",
    "@napi-rs/wasm-runtime": "catalog:",
    "@kirana-style/preset-scales": "workspace:*",
    "@kirana-style/states": "workspace:*",
    "vite-plus": "catalog:",
    "oxlint": "catalog:"
  }
}
