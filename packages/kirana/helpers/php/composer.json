{
  "name": "kirana-style/kirana",
  "description": "Kirana for server templates: the class map reader, a Blade directive for Laravel and a Twig function for Symfony.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://kirana.style",
  "authors": [
    {
      "name": "The Kirana authors",
      "homepage": "https://kirana.style"
    }
  ],
  "support": {
    "issues": "https://github.com/kirana-style/kirana/issues",
    "source": "https://github.com/kirana-style/kirana-php",
    "security": "https://github.com/kirana-style/kirana/security/policy"
  },
  "require": {
    "php": ">=8.3"
  },
  "require-dev": {
    "laravel/framework": "^13.32",
    "orchestra/testbench-core": "^11.5",
    "phpunit/phpunit": "~13.3.0",
    "twig/twig": "^3.30"
  },
  "suggest": {
    "laravel/framework": "for the @kirana Blade directive",
    "twig/twig": "for the kirana() Twig function"
  },
  "autoload": {
    "psr-4": {
      "Kirana\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kirana\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Kirana\\Laravel\\KiranaServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "coverage": [
      "@php -d xdebug.mode=coverage vendor/bin/phpunit --coverage-clover coverage.xml",
      "@php bin/check-coverage.php coverage.xml"
    ]
  }
}
